def cluster_events(times: np.ndarray, win: float) -> np.ndarray:
    """
    Given event timestamps (seconds), merge/cluster events that happen within 'win' seconds.
    Keeps the first timestamp of each cluster.
    This reduces double-counting of fast repeated detections.
    """
    times = np.sort(times.astype(float))
    out = []
    i = 0
    while i < len(times):
        t0 = float(times[i])
        out.append(t0)
        j = i + 1
        while j < len(times) and float(times[j]) - t0 <= win:
            j += 1
        i = j
    return np.array(out, dtype=float)

def robust_z(trace: np.ndarray, base_mask: np.ndarray) -> np.ndarray:
    """
    Robust Z-score using median and MAD (median absolute deviation):
      Z = (x - median(baseline)) / MAD(baseline)
    This is robust to outliers and baseline drift compared to mean/std.
    """
    base = trace[base_mask]
    med = float(np.median(base))
    mad = float(np.median(np.abs(base - med)))
    if mad == 0 or np.isnan(mad):
        return np.full_like(trace, np.nan, dtype=float)
    return (trace - med) / mad

def infer_fiber_cols(df: pd.DataFrame):
    """
    Try to infer which columns are time, signal(490), control(405).
    Handles different export naming conventions:
      - time: "TimeStamp" / "Time(s)" / contains "time"
      - signal: "Signal" / contains "sig" / contains "490"
      - control: "Control" / contains "ctl" / contains "405" / contains "iso"
    Returns: (time_col, sig_col, ctl_col)
    """
    cols = list(df.columns)

    def pick(name_list, fallback_idx):
        for n in name_list:
            if n in cols:
                return n
        return cols[fallback_idx] if len(cols) > fallback_idx else cols[0]

    time_cands = [c for c in cols if "time" in c.lower()]
    sig_cands  = [c for c in cols if "sig" in c.lower() or "490" in c.lower()]
    ctl_cands  = [c for c in cols if "ctl" in c.lower() or "control" in c.lower() or "405" in c.lower() or "iso" in c.lower()]

    time_col = pick(["TimeStamp", "Time(s)"], 0)
    if time_col not in cols and time_cands:
        time_col = time_cands[0]

    sig_col = pick(["Signal"], 1)
    if sig_col not in cols and sig_cands:
        sig_col = sig_cands[0]

    ctl_col = pick(["Control"], 2)
    if ctl_col not in cols and ctl_cands:
        ctl_col = ctl_cands[0]

    return time_col, sig_col, ctl_col

def normalize_to_seconds_by_dt(t: np.ndarray):
    """
    Photometry/MedPC exports might store time in:
      - seconds
      - milliseconds
      - microseconds
    We infer a scale factor from the median dt and typical magnitude.

    Strategy:
      1) shift so min=0
      2) compute dt = median(diff(sorted(t)))
      3) fs = 1/dt
      4) if fs is absurdly high, assume smaller units and scale:
         - fs > 50000 -> microseconds -> scale by 1e-6
         - fs > 5000  -> milliseconds -> scale by 1e-3
      5) additional heuristic: very large values with low fs might still be ms
    Returns:
      t_seconds, scale_factor_used
    """
    t = t.astype(float)
    t = t - np.nanmin(t)
    dt = float(np.nanmedian(np.diff(np.sort(t))))
    if dt <= 0 or not np.isfinite(dt):
        return t, 1.0

    fs = 1.0 / dt
    scale = 1.0
    if fs > 50000:          # microsecond-like
        scale = 1e-6
    elif fs > 5000:         # millisecond-like
        scale = 1e-3
    elif fs < 50 and np.nanmax(t) > 20000:  # huge values but slow dt => ms
        scale = 1e-3

    t2 = (t * scale).astype(float)
    t2 = t2 - float(np.min(t2))
    return t2, scale

def greedy_match_mae(manual: np.ndarray, cand: np.ndarray, tol=3.0):
    """
    Match manual timestamps to candidate timestamps (both in VIDEO seconds)
    using a greedy nearest match with tolerance.

    Returns:
      (mean_abs_error, n_misses) or None if nothing matched
    """
    cand = np.sort(cand.astype(float))
    i = 0
    errs = []
    misses = 0
    for m in manual:
        while i < len(cand) and cand[i] < (m - tol):
            i += 1
        if i >= len(cand):
            misses += 1
            continue
        idxs = [i]
        if i-1 >= 0: idxs.append(i-1)
        if i+1 < len(cand): idxs.append(i+1)
        idxs = sorted(set(idxs))
        diffs = [abs(cand[k]-m) for k in idxs]
        kbest = idxs[int(np.argmin(diffs))]
        err = abs(cand[kbest]-m)
        if err <= tol:
            errs.append(err)
            i = kbest + 1
        else:
            misses += 1
    if len(errs) == 0:
        return None
    return float(np.mean(errs)), int(misses)

def best_affine_medpc_to_video(man1, mp1, man2, mp2):
    """
    Estimate MedPC -> Video affine map:
      t_video = a_mv * t_medpc + b_mv

    Using two anchor windows:
      - first 0-10 minutes
      - 35-45 minutes
    where you provided manual timestamps from the video.

    We brute-force search a and b:
      - a near duration ratio +/- small range
      - b in [-300, 300]
    Objective:
      minimize (MAE window1 + MAE window2) + 2*(misses1 + misses2)
    """
    dur_man = max(man2.max(), man1.max())
    dur_mp  = max(mp2.max() if len(mp2) else 0, mp1.max() if len(mp1) else 0)
    if dur_mp <= 0:
        raise RuntimeError("MedPC events look empty in the selected windows.")

    a0 = dur_man / dur_mp
    a_list = np.arange(max(0.95, a0-0.03), min(1.05, a0+0.03), 0.0005)
    b_list = np.arange(-300, 300.01, 0.05)

    best = None
    for a in a_list:
        c1 = a*mp1
        c2 = a*mp2
        for b in b_list:
            r1 = greedy_match_mae(man1, c1 + b, tol=TOL_MANUAL)
            r2 = greedy_match_mae(man2, c2 + b, tol=TOL_MANUAL)
            if r1 is None and r2 is None:
                continue
            mae1, miss1 = (10.0, len(man1)) if r1 is None else r1
            mae2, miss2 = (10.0, len(man2)) if r2 is None else r2
            score = (mae1+mae2) + 2.0*(miss1+miss2)
            if best is None or score < best["score"]:
                best = dict(a=a, b=b, score=score,
                            mae_0_10=mae1, miss_0_10=miss1,
                            mae_35_45=mae2, miss_35_45=miss2)
    if best is None:
        raise RuntimeError("Failed to estimate MedPC->Video affine mapping.")
    return best

def auc_trapz(y: np.ndarray, x: np.ndarray, t0: float, t1: float) -> float:
    """
    Area under curve via trapezoid integration between [t0, t1].
    Uses np.trapezoid if available, else manual fallback.
    """
    m = (x >= t0) & (x <= t1) & np.isfinite(y) & np.isfinite(x)
    if np.sum(m) < 2:
        return float("nan")
    if hasattr(np, "trapezoid"):
        return float(np.trapezoid(y[m], x[m]))
    return float(((y[m][1:] + y[m][:-1]) * 0.5 * np.diff(x[m])).sum())

def nearest_dist_mean(query_times: np.ndarray, ref_times: np.ndarray) -> float:
    """
    For each query time, compute distance to nearest reference time;
    return mean distance.
    Used as a debug metric: how close our predicted video event time is to manual list.
    """
    if len(query_times) == 0 or len(ref_times) == 0:
        return float("nan")
    ref = np.sort(ref_times.astype(float))
    qs = query_times.astype(float)
    d = []
    for q in qs:
        j = int(np.searchsorted(ref, q))
        cand = []
        if 0 <= j < len(ref): cand.append(abs(ref[j]-q))
        if 0 <= j-1 < len(ref): cand.append(abs(ref[j-1]-q))
        if 0 <= j+1 < len(ref): cand.append(abs(ref[j+1]-q))
        d.append(min(cand) if cand else np.nan)
    return float(np.nanmean(np.array(d, float)))

def estimate_video_fps_if_needed(cap: cv2.VideoCapture, fps: float) -> float:
    """
    OpenCV sometimes returns FPS=0 or NaN for some codecs/containers.
    If fps looks invalid, estimate FPS by reading a chunk of frames and using CAP_PROP_POS_MSEC.

    Fall back to 30 if everything fails (with a warning).
    """
    if fps is not None and np.isfinite(fps) and fps > 1.0:
        return float(fps)

    ms_list = []
    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
    for _ in range(220):
        ret, _ = cap.read()
        if not ret:
            break
        ms = cap.get(cv2.CAP_PROP_POS_MSEC)
        if np.isfinite(ms) and ms > 0:
            ms_list.append(ms)

    if len(ms_list) < 10:
        print("[WARN] Could not infer FPS. Falling back to 30.")
        return 30.0

    ms_list = np.array(ms_list, float)
    dms = np.diff(ms_list)
    dms = dms[np.isfinite(dms) & (dms > 0)]
    if len(dms) < 5:
        print("[WARN] Could not infer FPS reliably. Falling back to 30.")
        return 30.0

    fps_est = 1000.0 / float(np.median(dms))
    if not np.isfinite(fps_est) or fps_est < 1.0:
        print("[WARN] FPS estimate invalid. Falling back to 30.")
        return 30.0
    return float(fps_est)

def photobleach_correct(sig: np.ndarray, ctl: np.ndarray, fs: float, tau_sec: float):
    """
    Photobleaching/drift correction using EMA (exponential moving average):
      trend_sig = EMA(sig, span=tau_sec*fs)
      trend_ctl = EMA(ctl, span=tau_sec*fs)

    Then normalize each channel by its trend:
      sig_n = sig / trend_sig
      ctl_n = ctl / trend_ctl

    Why division not subtraction?
      - Photobleaching is often multiplicative decay in fluorescence magnitude.
      - Division makes the channel roughly "stationary" over time for event comparison.

    Returns:
      sig_n, ctl_n, trend_sig, trend_ctl
    """
    span = int(max(10, round(tau_sec * fs)))  # minimum smoothing window
    s = pd.Series(sig)
    c = pd.Series(ctl)
    trend_sig = s.ewm(span=span, adjust=False).mean().to_numpy(dtype=float)
    trend_ctl = c.ewm(span=span, adjust=False).mean().to_numpy(dtype=float)

    eps = 1e-12
    sig_n = sig / (trend_sig + eps)
    ctl_n = ctl / (trend_ctl + eps)
    return sig_n, ctl_n, trend_sig, trend_ctl

# =========================
# MF SCORING (video-grounded, supports INCREASE or DECREASE)
# =========================
def score_medpc_to_fiber_videogrounded(
    a_mf: float, b_mf: float,
    mp_times: np.ndarray,
    t_fiber: np.ndarray, dff: np.ndarray,
    epoch: np.ndarray, base_mask: np.ndarray, search_mask: np.ndarray,
    a_mv: float, b_mv: float, dur_v: float,
    direction: str = "either",   # "increase" | "decrease" | "either"
):
    """
    Evaluate a candidate MedPC->Fiber mapping (a_mf, b_mf).

    Steps:
      1) Map MedPC events into Fiber time: ev = a_mf*mp_times + b_mf
      2) Keep only events that have full peri-event photometry coverage: [ev-PRE, ev+POST] inside fiber time range
      3) For each event:
         - interpolate dff onto (ev + epoch)
         - compute Robust Z using baseline window
         - inside response window [0,3] find:
             max Z (increase), min Z (decrease) + their offsets
      4) Use a "score core" depending on direction:
         - increase: median(max Z)
         - decrease: median(|min Z|)
         - either: pick whichever is larger magnitude overall
      5) Also compute whether each event would produce a valid VIDEO clip:
         - map event time to video: t_video_event = a_mv*mp + b_mv
         - map peak offset to video by scaling offsets: offset_video = (a_mv/a_mf)*offset_fiber
         - then check clip bounds within [0, video_duration]
      6) final score:
         score_core + MF_ALPHA_VALID*valid_ratio - MF_B_STABIL*|b_mf|

    Returns:
      score, n_good, valid_ratio, med_pos, med_neg
        - med_pos: median of max Z (typical increase strength)
        - med_neg: median of min Z (negative values)
    """
    ev = a_mf*mp_times + b_mf

    # must have photometry data for the entire peri-event window
    ok = (ev - PRE >= t_fiber.min()) & (ev + POST <= t_fiber.max())
    mp_ok = mp_times[ok]
    ev = ev[ok]
    if len(ev) < MF_MIN_EVENTS:
        return -1e9, 0, 0.0, np.nan, np.nan

    peaks_pos = []
    peaks_neg = []
    peak_off_pos = []
    peak_off_neg = []

    tt = epoch[search_mask]
    for e in ev:
        tr = np.interp(e + epoch, t_fiber, dff)
        rz = robust_z(tr, base_mask)
        zz = rz[search_mask]
        if np.all(np.isnan(zz)):
            peaks_pos.append(np.nan); peak_off_pos.append(np.nan)
            peaks_neg.append(np.nan); peak_off_neg.append(np.nan)
            continue

        kmax = int(np.nanargmax(zz))
        kmin = int(np.nanargmin(zz))
        peaks_pos.append(float(zz[kmax]))
        peak_off_pos.append(float(tt[kmax]))
        peaks_neg.append(float(zz[kmin]))
        peak_off_neg.append(float(tt[kmin]))

    peaks_pos = np.array(peaks_pos, float)
    peaks_neg = np.array(peaks_neg, float)
    peak_off_pos = np.array(peak_off_pos, float)
    peak_off_neg = np.array(peak_off_neg, float)

    good = np.isfinite(peaks_pos) & np.isfinite(peaks_neg) & np.isfinite(peak_off_pos) & np.isfinite(peak_off_neg)
    if int(good.sum()) < MF_MIN_EVENTS:
        return -1e9, int(good.sum()), 0.0, np.nan, np.nan

    med_pos = float(np.nanmedian(peaks_pos[good]))         # >0 if there is an increase response
    med_neg = float(np.nanmedian(peaks_neg[good]))         # <0 if there is a decrease response
    med_neg_mag = float(np.nanmedian((-peaks_neg)[good]))  # magnitude of decrease (positive)

    # Choose which offset to use for video validity depending on which direction we're scoring
    if direction == "increase":
        peak_off_use = peak_off_pos
        score_core = med_pos
    elif direction == "decrease":
        peak_off_use = peak_off_neg
        score_core = med_neg_mag
    else:
        # "either": whichever response (increase vs decrease) is stronger in magnitude
        if np.isfinite(med_pos) and np.isfinite(med_neg_mag) and (med_neg_mag > med_pos):
            peak_off_use = peak_off_neg
            score_core = med_neg_mag
        else:
            peak_off_use = peak_off_pos
            score_core = med_pos

    # Convert event time to video time, and convert fiber-offset to video-offset.
    # Offset scaling:
    #   - in fiber: event->peak offset is measured in fiber seconds
    #   - video time mapping: t_video = a_mv * t_medpc + b_mv
    #   - fiber mapping:      t_fiber = a_mf * t_medpc + b_mf
    # So dt_video / dt_fiber = a_mv / a_mf
    t_video_event = a_mv*mp_ok + b_mv
    t_video_peak  = t_video_event + (a_mv/a_mf)*peak_off_use

    # How many events would allow a full clip [peak-5, peak+5] within video bounds?
    valid = (t_video_peak - CLIP_PRE >= 0) & (t_video_peak + CLIP_POST <= dur_v) & good
    valid_ratio = float(np.mean(valid)) if len(valid) else 0.0

    score = float(score_core + MF_ALPHA_VALID*valid_ratio - MF_B_STABIL*abs(b_mf))
    return score, int(good.sum()), float(valid_ratio), med_pos, med_neg

