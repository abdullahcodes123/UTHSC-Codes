global_figdir.mkdir(parents=True, exist_ok=True)
pb_png_global = global_figdir / "photobleach_trends.png"
plt.figure(figsize=(12, 5))
plt.plot(t, sig, linewidth=0.7, label="Signal raw", alpha=0.7)
plt.plot(t, trend_sig, linewidth=2.0, label=f"Signal EMA trend (tau={PB_TAU_SEC}s)")
plt.plot(t, ctl, linewidth=0.7, label="Control raw", alpha=0.7)
plt.plot(t, trend_ctl, linewidth=2.0, label=f"Control EMA trend (tau={PB_TAU_SEC}s)")
plt.xlabel("Time (s)")
plt.ylabel("Fluorescence (raw units)")
plt.title("Photobleaching / drift trends (EMA)")
plt.legend()
plt.tight_layout()
plt.savefig(pb_png_global, dpi=200)
plt.close()
print(f"[OK] Saved: {pb_png_global}")

# ---- pMAT-style OLS on PB-corrected channels
# We model Signal_n as linear function of Control_n to remove shared motion/bleaching-like artifacts.
# fit_ctl ≈ a*control_n + b
# dF/F = (signal_n - fit_ctl) / fit_ctl
a_fit, b_fit = np.polyfit(ctl_n, sig_n, 1)
fit_ctl = a_fit*ctl_n + b_fit
dff = (sig_n - fit_ctl) / fit_ctl
print(f"[CTL->SIG OLS on PB-corrected] a={a_fit:.6f} b={b_fit:.6f}")

# Define peri-event relative-time axis and masks
epoch = np.arange(-PRE, POST + dt, dt)
base_mask = (epoch >= BASE_START) & (epoch < BASE_END)
search_mask = (epoch >= PEAK_SEARCH_START) & (epoch <= PEAK_SEARCH_END)
search_t = epoch[search_mask]

# =========================
# LOAD MEDPC FILE + PICK TWO CANDIDATE COLUMNS
# =========================
bdf = pd.read_csv(beh_file)

# We try to use the obvious column names first.
preferred = []
for name in ["self_administrator", "demonstrator", "demonstrator_medpc", "demo", "demonstrator_events"]:
    if name in bdf.columns:
        preferred.append(name)

# If not enough named columns found, fallback:
# pick columns that can be converted to numeric and have at least 20 non-null values (likely events).
if len(preferred) < 2:
    numeric_cols = []
    for c in bdf.columns:
        s = pd.to_numeric(bdf[c], errors="coerce")
        n = int(s.notna().sum())
        if n >= 20:
            numeric_cols.append((c, n))
    numeric_cols.sort(key=lambda x: x[1], reverse=True)
    for c, _ in numeric_cols:
        if c not in preferred:
            preferred.append(c)
        if len(preferred) >= 2:
            break

# Keep unique and take at most 2 columns
seen = set()
cand_cols = []
for c in preferred:
    if c not in seen:
        seen.add(c)
        cand_cols.append(c)
    if len(cand_cols) >= 2:
        break

if len(cand_cols) == 0:
    raise ValueError("No usable MedPC columns found in deneme.csv.")
if len(cand_cols) == 1:
    print(f"[WARN] Only 1 usable MedPC column found: {cand_cols[0]}. Running only that one.")

print("[MEDPC COLUMNS USED]", cand_cols)

# =========================
# MAIN: RUN PIPELINE FOR EACH MEDPC COLUMN
# =========================
def run_case(colname: str):
    """
    Runs the entire alignment + peri-event + clip export pipeline for one MedPC column.

    Outputs are stored under:
      root/case_<colname>/
        figures/
        videos_increase/
        videos_decrease/
        all_aligned_events.csv
        top10_np1_summary_increase.csv
        top10_np1_summary_decrease.csv
        top10_debug_vs_manual_increase.csv
        top10_debug_vs_manual_decrease.csv
        all_events_mean_trace_auc.csv
        etc.
    """
    case_root = root / f"case_{colname}"
    figdir = case_root / "figures"
    viddir_inc = case_root / "videos_increase"
    viddir_dec = case_root / "videos_decrease"
    figdir.mkdir(parents=True, exist_ok=True)
    viddir_inc.mkdir(parents=True, exist_ok=True)
    viddir_dec.mkdir(parents=True, exist_ok=True)

    # Copy the photobleaching plot into the case folder (self-contained outputs).
    pb_png = figdir / "photobleach_trends.png"
    plt.figure(figsize=(12, 5))
    plt.plot(t, sig, linewidth=0.7, label="Signal raw", alpha=0.7)
    plt.plot(t, trend_sig, linewidth=2.0, label=f"Signal EMA trend (tau={PB_TAU_SEC}s)")
    plt.plot(t, ctl, linewidth=0.7, label="Control raw", alpha=0.7)
    plt.plot(t, trend_ctl, linewidth=2.0, label=f"Control EMA trend (tau={PB_TAU_SEC}s)")
    plt.xlabel("Time (s)")
    plt.ylabel("Fluorescence (raw units)")
    plt.title("Photobleaching / drift trends (EMA)")
    plt.legend()
    plt.tight_layout()
    plt.savefig(pb_png, dpi=200)
    plt.close()

    # -------------------------------------------------------------------------
    # 1) LOAD MedPC events for this column
    # -------------------------------------------------------------------------
    mp_raw = pd.to_numeric(bdf[colname], errors="coerce").dropna().to_numpy()
    mp_raw = mp_raw[mp_raw > 0].astype(float)
    mp_raw = np.sort(mp_raw)

    # Normalize time units to seconds, then cluster bounces
    mp_s, mp_scale = normalize_to_seconds_by_dt(mp_raw)
    mp_s = mp_s - float(np.min(mp_s)) if len(mp_s) else mp_s
    mp_s = cluster_events(mp_s, CLUSTER_WIN)

    # For indexing in outputs
    mp_idx = np.arange(1, len(mp_s) + 1, dtype=int)

    print(f"\n=== CASE: {colname} ===")
    print(f"[OK] MedPC clustered events: n={len(mp_s)} scale={mp_scale} range={mp_s.min():.1f}..{mp_s.max():.1f}s")

    # Two anchor windows used for MedPC->Video alignment
    mp_0_10  = mp_s[(mp_s >= 0) & (mp_s <= 600)]
    mp_35_45 = mp_s[(mp_s >= 35*60) & (mp_s <= 45*60)]
    print(f"[OK] MedPC windows: first10min n={len(mp_0_10)} | 35-45min n={len(mp_35_45)}")

    # -------------------------------------------------------------------------
    # 2) MedPC -> VIDEO alignment using manual timestamps
    # -------------------------------------------------------------------------
    mv = best_affine_medpc_to_video(manual_0_10, mp_0_10, manual_35_45, mp_35_45)
    a_mv, b_mv = float(mv["a"]), float(mv["b"])
    print(f"[ALIGN MV] t_video = {a_mv:.6f}*t_medpc + {b_mv:.3f} "
          f"(MAE0-10={mv['mae_0_10']:.2f}s miss={mv['miss_0_10']} | MAE35-45={mv['mae_35_45']:.2f}s miss={mv['miss_35_45']})")

    # -------------------------------------------------------------------------
    # 3) MedPC -> FIBER alignment using video-grounded photometry objective
    # -------------------------------------------------------------------------
    # Initial guess for slope a_mf from duration ratio
    dur_mp = float(np.max(mp_s)) if len(mp_s) else 1.0
    dur_f  = float(np.max(t))
    a0 = dur_f / dur_mp

    # Grid for a and b
    a_list = np.arange(max(0.8, a0 - A_MF_PAD), min(1.2, a0 + A_MF_PAD) + 1e-12, A_MF_STEP_COARSE)
    b_list = np.arange(B_MF_MIN, B_MF_MAX + 1e-12, B_MF_STEP_COARSE)

    # Focus events (use the two windows if available; otherwise use all)
    mp_focus = np.concatenate([mp_0_10, mp_35_45]) if (len(mp_0_10)+len(mp_35_45)) > 0 else mp_s

    # Coarse speed-up: subsample events
    if len(mp_focus) > MF_COARSE_MAX_EVENTS:
        stride = int(np.ceil(len(mp_focus) / MF_COARSE_MAX_EVENTS))
        mp_focus_coarse = mp_focus[::stride]
    else:
        mp_focus_coarse = mp_focus

    # Coarse grid search
    best_mf = None
    for a in a_list:
        for b in b_list:
            sc, nused, vratio, med_pos, med_neg = score_medpc_to_fiber_videogrounded(
                a, b, mp_focus_coarse, t, dff, epoch, base_mask, search_mask,
                a_mv, b_mv, dur_v, direction="either"
            )
            if best_mf is None or sc > best_mf["score"]:
                best_mf = {
                    "a": float(a), "b": float(b), "score": float(sc),
                    "nused": int(nused), "valid_ratio": float(vratio),
                    "med_pos": float(med_pos) if np.isfinite(med_pos) else np.nan,
                    "med_neg": float(med_neg) if np.isfinite(med_neg) else np.nan,
                }

    if best_mf is None or best_mf["score"] < -1e8:
        raise RuntimeError("Failed to find MedPC->Fiber alignment (coarse).")

    # Fine search over b around best coarse b (keep a fixed)
    a_mf = best_mf["a"]
    b0 = best_mf["b"]
    b_list2 = np.arange(b0-3.0, b0+3.0+1e-12, B_MF_STEP_FINE)

    best2 = None
    for b in b_list2:
        sc, nused, vratio, med_pos, med_neg = score_medpc_to_fiber_videogrounded(
            a_mf, b, mp_focus, t, dff, epoch, base_mask, search_mask,
            a_mv, b_mv, dur_v, direction="either"
        )
        if best2 is None or sc > best2["score"]:
            best2 = {
                "a": float(a_mf), "b": float(b), "score": float(sc),
                "nused": int(nused), "valid_ratio": float(vratio),
                "med_pos": float(med_pos) if np.isfinite(med_pos) else np.nan,
                "med_neg": float(med_neg) if np.isfinite(med_neg) else np.nan,
            }

    a_mf, b_mf = best2["a"], best2["b"]
    print(f"[ALIGN MF VIDEO-GROUNDED] t_fiber = {a_mf:.6f}*t_medpc + {b_mf:.3f} "
          f"(score={best2['score']:.3f}, nused={best2['nused']}, valid_ratio={best2['valid_ratio']:.2f})")

    # -------------------------------------------------------------------------
    # 4) Peri-event for ALL events: compute BOTH increase and decrease metrics
    # -------------------------------------------------------------------------
    ev_fiber_all = a_mf*mp_s + b_mf
    ok_fiber = (ev_fiber_all - PRE >= t.min()) & (ev_fiber_all + POST <= t.max())

    mp_ok = mp_s[ok_fiber]
    mp_ok_idx = mp_idx[ok_fiber]
    ev_fiber = ev_fiber_all[ok_fiber]

    print(f"[OK] Events usable in fiber: n={len(ev_fiber)}")

    rz_trials = []
    peak_pos_z = []
    peak_pos_off = []
    peak_neg_z = []
    peak_neg_off = []

    for e in ev_fiber:
        # Interpolate dff around event
        tr = np.interp(e + epoch, t, dff)

        # Robust Z using baseline window
        rz = robust_z(tr, base_mask)

        # Search response window [0,3]
        zz = rz[search_mask]

        if np.all(np.isnan(zz)):
            rz_trials.append(rz)
            peak_pos_z.append(np.nan); peak_pos_off.append(np.nan)
            peak_neg_z.append(np.nan); peak_neg_off.append(np.nan)
            continue

        kmax = int(np.nanargmax(zz))
        kmin = int(np.nanargmin(zz))

        rz_trials.append(rz)

        # Increase metric
        peak_pos_z.append(float(zz[kmax]))
        peak_pos_off.append(float(search_t[kmax]))

        # Decrease metric (negative)
        peak_neg_z.append(float(zz[kmin]))
        peak_neg_off.append(float(search_t[kmin]))

    rz_trials = np.vstack(rz_trials) if len(rz_trials) else np.zeros((0, len(epoch)))
    peak_pos_z = np.array(peak_pos_z, dtype=float)
    peak_pos_off = np.array(peak_pos_off, dtype=float)
    peak_neg_z = np.array(peak_neg_z, dtype=float)
    peak_neg_off = np.array(peak_neg_off, dtype=float)

    # -------------------------------------------------------------------------
    # 5) Convert each event/peak time to VIDEO time, check clip bounds
    # -------------------------------------------------------------------------
    t_video_event_all = a_mv*mp_ok + b_mv
    t_video_peak_pos = t_video_event_all + (a_mv/a_mf)*peak_pos_off
    t_video_peak_neg = t_video_event_all + (a_mv/a_mf)*peak_neg_off

    ok_video_pos = (t_video_peak_pos - CLIP_PRE >= 0) & (t_video_peak_pos + CLIP_POST <= dur_v) & np.isfinite(t_video_peak_pos)
    ok_video_neg = (t_video_peak_neg - CLIP_PRE >= 0) & (t_video_peak_neg + CLIP_POST <= dur_v) & np.isfinite(t_video_peak_neg)

    print(f"[OK] Events usable in video (increase-peaks, 5+5s): n={int(np.sum(ok_video_pos))}")
    print(f"[OK] Events usable in video (decrease-peaks, 5+5s): n={int(np.sum(ok_video_neg))}")

    # Save full event table including BOTH directions
    all_events_df = pd.DataFrame({
        "nosepoke_index": mp_ok_idx.astype(int),
        "t_medpc_s": mp_ok.astype(float),
        "t_fiber_event_s": ev_fiber.astype(float),

        "peak_pos_robust_z": peak_pos_z.astype(float),
        "peak_pos_offset_fiber_s": peak_pos_off.astype(float),
        "t_video_peak_pos_s": t_video_peak_pos.astype(float),
        "usable_in_video_pos": ok_video_pos.astype(bool),

        "peak_neg_robust_z": peak_neg_z.astype(float),
        "peak_neg_offset_fiber_s": peak_neg_off.astype(float),
        "t_video_peak_neg_s": t_video_peak_neg.astype(float),
        "usable_in_video_neg": ok_video_neg.astype(bool),

        "t_video_event_s": t_video_event_all.astype(float),
    })
    all_events_csv = case_root / "all_aligned_events.csv"
    all_events_df.to_csv(all_events_csv, index=False)
    print(f"[OK] Saved: {all_events_csv}")

    # -------------------------------------------------------------------------
    # Helper: choose top indices with refractory
    # -------------------------------------------------------------------------
    def choose_top_indices(scores: np.ndarray, mp_times: np.ndarray, refractory: float, max_keep: int = 200, descending: bool = True):
        """
        scores: array where larger = better.
        Enforces that chosen events are separated by at least 'refractory' seconds in MedPC time.
        """
        key = -np.nan_to_num(scores, nan=-1e9) if descending else np.nan_to_num(scores, nan=1e9)
        order = np.argsort(key)
        chosen = []
        used_mp = []
        for idx0 in order:
            t_mp = float(mp_times[idx0])
            if any(abs(t_mp - u) < refractory for u in used_mp):
                continue
            chosen.append(int(idx0))
            used_mp.append(t_mp)
            if len(chosen) >= max_keep:
                break
        return np.array(chosen, dtype=int)

    # -------------------------------------------------------------------------
    # 6) Select TOP10 INCREASE clips
    # -------------------------------------------------------------------------
    chosen_inc = choose_top_indices(peak_pos_z, mp_ok, EVENT_REFRACTORY, max_keep=200, descending=True)

    valid_inc = []
    for idx0 in chosen_inc:
        if not ok_video_pos[idx0]:
            continue
        valid_inc.append((idx0, float(t_video_peak_pos[idx0]), float(t_video_event_all[idx0])))
        if len(valid_inc) >= TARGET_CLIPS:
            break
    print(f"[OK] Valid INCREASE clips: n={len(valid_inc)} (target={TARGET_CLIPS})")

    # -------------------------------------------------------------------------
    # 7) Select TOP10 DECREASE clips (most negative => biggest magnitude)
    # -------------------------------------------------------------------------
    dec_score = -peak_neg_z  # bigger = stronger decrease magnitude
    chosen_dec = choose_top_indices(dec_score, mp_ok, EVENT_REFRACTORY, max_keep=200, descending=True)

    valid_dec = []
    for idx0 in chosen_dec:
        if not ok_video_neg[idx0]:
            continue
        valid_dec.append((idx0, float(t_video_peak_neg[idx0]), float(t_video_event_all[idx0])))
        if len(valid_dec) >= TARGET_CLIPS:
            break
    print(f"[OK] Valid DECREASE clips: n={len(valid_dec)} (target={TARGET_CLIPS})")

    # -------------------------------------------------------------------------
    # 8) TOP10 summaries + debug tables (increase & decrease)
    # -------------------------------------------------------------------------
    manual_all = np.sort(np.concatenate([manual_0_10, manual_35_45]).astype(float))

    def write_top10_tables(valid_list, mode: str):
        """
        mode:
          - "increase": uses peak_pos
          - "decrease": uses peak_neg
        Writes:
          top10_np1_summary_<mode>.csv
          top10_debug_vs_manual_<mode>.csv
        """
        summary = []
        debug_rows = []
        for rank, (idx0, tpkv, tev) in enumerate(valid_list, start=1):
            np_index = int(mp_ok_idx[idx0])
            t_medpc = float(mp_ok[idx0])
            dman = nearest_dist_mean(np.array([tev]), manual_all)

            if mode == "increase":
                zpk = float(peak_pos_z[idx0])
                pkoff = float(peak_pos_off[idx0])
                t_peak = float(t_video_peak_pos[idx0])
            else:
                zpk = float(peak_neg_z[idx0])  # negative
                pkoff = float(peak_neg_off[idx0])
                t_peak = float(t_video_peak_neg[idx0])

            summary.append({
                "rank": rank,
                "mode": mode,
                "nosepoke_index": np_index,
                "t_medpc_s": t_medpc,
                "t_fiber_event_s": float(ev_fiber[idx0]),
                "peak_robust_z": zpk,
                "peak_offset_fiber_s": pkoff,
                "t_video_event_s": float(tev),
                "t_video_peak_s": t_peak,
                "nearest_manual_dt_s": float(dman),
            })

            debug_rows.append({
                "rank": rank,
                "mode": mode,
                "nosepoke_index": np_index,
                "t_video_event_s": float(tev),
                "nearest_manual_dt_s": float(dman),
                "t_video_peak_s": t_peak,
                "peak_offset_fiber_s": pkoff,
                "peak_robust_z": zpk,
                "a_mv": a_mv, "b_mv": b_mv,
                "a_mf": a_mf, "b_mf": b_mf,
                "fiber_fs_hz": float(fs),
                "video_fps": float(fps_v),
                "pb_tau_sec": float(PB_TAU_SEC),
                "medpc_column": colname,
            })

        summary_df = pd.DataFrame(summary)
        debug_df = pd.DataFrame(debug_rows)

        summary_csv = case_root / f"top10_np1_summary_{mode}.csv"
        debug_csv = case_root / f"top10_debug_vs_manual_{mode}.csv"
        summary_df.to_csv(summary_csv, index=False)
        debug_df.to_csv(debug_csv, index=False)
        print(f"[OK] Saved: {summary_csv}")
        print(f"[OK] Saved: {debug_csv}")

    write_top10_tables(valid_inc, "increase")
    write_top10_tables(valid_dec, "decrease")

    # -------------------------------------------------------------------------
    # 9) TOP10 peri-event grids (increase & decrease)
    # -------------------------------------------------------------------------
    def save_grid(valid_list, mode: str):
        """
        Saves a panel plot of peri-event Robust Z traces for top clips.
        Also draws vertical lines:
          - event at 0 sec
          - chosen peak offset within response window
        """
        out_png = figdir / f"top10_peri_event_robustZ_grid_{mode}.png"
        if len(valid_list) == 0:
            return
        plt.figure(figsize=(18, 6))
        ncols = 5
        nrows = int(np.ceil(len(valid_list)/ncols))
        for j, (idx0, tpkv, tev) in enumerate(valid_list, start=1):
            ax = plt.subplot(nrows, ncols, j)
            ax.plot(epoch, rz_trials[idx0], linewidth=1)
            ax.axvline(0, linestyle="--", linewidth=1)

            if mode == "increase":
                ax.axvline(peak_pos_off[idx0], linestyle=":", linewidth=1)
                ztxt = peak_pos_z[idx0]
                off = peak_pos_off[idx0]
            else:
                ax.axvline(peak_neg_off[idx0], linestyle=":", linewidth=1)
                ztxt = peak_neg_z[idx0]
                off = peak_neg_off[idx0]

            ax.set_title(f"{mode.upper()} #{j} | Z={ztxt:.2f} | NP#{int(mp_ok_idx[idx0])} | off={off:.2f}s")
            ax.set_xlabel("Time (s) relative to nosepoke")
            ax.set_ylabel("Robust Z (dF/F)")
            ax.set_xlim(-PRE, POST)
        plt.tight_layout()
        plt.savefig(out_png, dpi=200)
        plt.close()
        print(f"[OK] Saved: {out_png}")

    save_grid(valid_inc, "increase")
    save_grid(valid_dec, "decrease")

    # -------------------------------------------------------------------------
    # 10) ALL EVENTS mean peri-event + AUC (net, positive-only, negative-only)
    # -------------------------------------------------------------------------
    finite_rows = np.all(np.isfinite(rz_trials), axis=1)
    rz_valid = rz_trials[finite_rows]
    if rz_valid.shape[0] >= 5:
        mean_rz = np.nanmean(rz_valid, axis=0)
        sem_rz = np.nanstd(rz_valid, axis=0, ddof=1) / np.sqrt(rz_valid.shape[0])

        # Net AUC includes sign (negative reduces net)
        auc_net_0_3 = auc_trapz(mean_rz, epoch, 0.0, 3.0)
        auc_net_0_5 = auc_trapz(mean_rz, epoch, 0.0, 5.0)

        # Separate positive and negative contributions (useful if decreases dominate)
        mean_pos = np.where(mean_rz > 0, mean_rz, 0.0)
        mean_neg = np.where(mean_rz < 0, mean_rz, 0.0)
        auc_pos_0_3 = auc_trapz(mean_pos, epoch, 0.0, 3.0)
        auc_pos_0_5 = auc_trapz(mean_pos, epoch, 0.0, 5.0)
        auc_neg_0_3 = auc_trapz(mean_neg, epoch, 0.0, 3.0)  # negative value
        auc_neg_0_5 = auc_trapz(mean_neg, epoch, 0.0, 5.0)  # negative value

        auc_df = pd.DataFrame([{
            "medpc_column": colname,
            "n_events_used": int(rz_valid.shape[0]),
            "AUC_net_mean_trace_0_3s": auc_net_0_3,
            "AUC_net_mean_trace_0_5s": auc_net_0_5,
            "AUC_pos_mean_trace_0_3s": auc_pos_0_3,
            "AUC_pos_mean_trace_0_5s": auc_pos_0_5,
            "AUC_neg_mean_trace_0_3s": auc_neg_0_3,
            "AUC_neg_mean_trace_0_5s": auc_neg_0_5,
        }])
        auc_csv = case_root / "all_events_mean_trace_auc.csv"
        auc_df.to_csv(auc_csv, index=False)
        print(f"[OK] Saved: {auc_csv}")

        avg_png = figdir / "all_events_mean_peri_event_robustZ.png"
        plt.figure(figsize=(10, 5))
        plt.plot(epoch, mean_rz, linewidth=2, label="Mean Robust Z")
        plt.fill_between(epoch, mean_rz - sem_rz, mean_rz + sem_rz, alpha=0.25, label="SEM")
        plt.axvline(0, linestyle="--", linewidth=1)
        plt.xlim(-PRE, POST)
        plt.xlabel("Time (s) relative to nosepoke")
        plt.ylabel("Robust Z (dF/F)")
        plt.title(
            f"All aligned nosepokes (n={rz_valid.shape[0]}) | "
            f"NetAUC(0-3)={auc_net_0_3:.3f} NetAUC(0-5)={auc_net_0_5:.3f}"
        )
        plt.legend()
        plt.tight_layout()
        plt.savefig(avg_png, dpi=200)
        plt.close()
        print(f"[OK] Saved: {avg_png}")
    else:
        print("[WARN] Not enough finite peri-event trials for mean/SEM and AUC.")

    # -------------------------------------------------------------------------
    # 11) Write clips for INCREASE and DECREASE
    # -------------------------------------------------------------------------
    def write_clips(valid_list, mode: str, out_dir: Path):
        """
        Writes MP4 clips for selected events.
        Each clip is centered around the relevant peak time (increase or decrease)
        and includes overlay text with alignment/metrics.
        """
        cap = cv2.VideoCapture(str(video_file))
        if not cap.isOpened():
            raise RuntimeError("Could not open video file (codec).")

        # Re-check FPS robustly on this cap (some codecs behave differently per handle)
        fps_meta2 = cap.get(cv2.CAP_PROP_FPS)
        fps_v2 = estimate_video_fps_if_needed(cap, fps_meta2)
        fps_use = fps_v2

        fourcc = cv2.VideoWriter_fourcc(*"mp4v")

        for rank, (idx0, tpkv, tev) in enumerate(valid_list, start=1):
            start_t = tpkv - CLIP_PRE
            end_t   = tpkv + CLIP_POST

            start_fr = int(round(start_t * fps_use))
            end_fr   = int(round(end_t * fps_use))

            out_clip = out_dir / f"{rank}.mp4"
            writer = cv2.VideoWriter(str(out_clip), fourcc, fps_use, (W, H))

            cap.set(cv2.CAP_PROP_POS_FRAMES, start_fr)
            cur = start_fr

            np_index = int(mp_ok_idx[idx0])
            t_medpc = float(mp_ok[idx0])

            if mode == "increase":
                zpk = float(peak_pos_z[idx0])
                pkoff = float(peak_pos_off[idx0])
                t_vid_peak = float(t_video_peak_pos[idx0])
            else:
                zpk = float(peak_neg_z[idx0])  # negative
                pkoff = float(peak_neg_off[idx0])
                t_vid_peak = float(t_video_peak_neg[idx0])

            while cur <= end_fr:
                ret, frame = cap.read()
                if not ret:
                    break

                line1 = f"{colname} | {mode.upper()} | Clip {rank} | PeakZ={zpk:.2f} | VideoPeak={t_vid_peak:.2f}s"
                line2 = f"MedPC={t_medpc:.2f}s | NosepokeIndex={np_index} | PeakOffsetFiber={pkoff:.2f}s"
                line3 = f"PBcorr EMA tau={PB_TAU_SEC:.0f}s | FiberFs={fs:.2f}Hz | VideoFPS={fps_use:.2f}"

                cv2.putText(frame, line1, (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                            (255,255,255), 2, cv2.LINE_AA)
                cv2.putText(frame, line2, (20, 72), cv2.FONT_HERSHEY_SIMPLEX, 0.65,
                            (255,255,255), 2, cv2.LINE_AA)
                cv2.putText(frame, line3, (20, 104), cv2.FONT_HERSHEY_SIMPLEX, 0.6,
                            (255,255,255), 2, cv2.LINE_AA)

                writer.write(frame)
                cur += 1

            writer.release()
            print(f"[OK] Clip saved: {out_clip} (5s before + 5s after)")

        cap.release()

    write_clips(valid_inc, "increase", viddir_inc)
    write_clips(valid_dec, "decrease", viddir_dec)

    # -------------------------------------------------------------------------
    # 12) Alignment report (case-specific)
    # -------------------------------------------------------------------------
    rep = figdir / "alignment_report.txt"
    with open(rep, "w", encoding="utf-8") as f:
        f.write("TIME MAPPINGS\n")
        f.write(f"MedPC column: {colname}\n")
        f.write(f"MedPC time scale applied: {mp_scale}\n")
        f.write(f"Fiber time scale applied: {t_scale}\n")
        f.write(f"Fiber Fs inferred from timestamps: {fs:.6f} Hz\n")
        f.write(f"Video FPS inferred: {fps_v:.6f}\n\n")

        f.write("MedPC -> Video (deterministic brute-force):\n")
        f.write("  t_video = a_mv * t_medpc + b_mv\n")
        f.write(f"  a_mv = {a_mv:.9f}\n")
        f.write(f"  b_mv = {b_mv:.6f}\n")
        f.write(f"  MAE0-10={mv['mae_0_10']:.3f}s miss={mv['miss_0_10']} | MAE35-45={mv['mae_35_45']:.3f}s miss={mv['miss_35_45']}\n\n")

        f.write("MedPC -> Fiber (grid + fine b, VIDEO-GROUNDED score):\n")
        f.write("  t_fiber = a_mf * t_medpc + b_mf\n")
        f.write(f"  a_mf = {a_mf:.9f}\n")
        f.write(f"  b_mf = {b_mf:.6f}\n")
        f.write(f"  MF_ALPHA_VALID={MF_ALPHA_VALID}, MF_B_STABIL={MF_B_STABIL}\n")
        f.write(f"  coarse_max_events={MF_COARSE_MAX_EVENTS}\n\n")

        f.write("Photobleaching correction:\n")
        f.write("  trend = EMA(raw, tau=PB_TAU_SEC)\n")
        f.write("  signal_n = signal / trend_signal\n")
        f.write("  control_n = control / trend_control\n")
        f.write(f"  PB_TAU_SEC = {PB_TAU_SEC}\n\n")

        f.write("Processing (pMAT-style core):\n")
        f.write("  fitted_control = a * control_n + b (OLS)\n")
        f.write("  dF/F = (signal_n - fitted_control) / fitted_control\n")
        f.write("  Robust Z = (dF/F - median(baseline)) / MAD(baseline)\n")
        f.write(f"  Peri-event window: [-{PRE}, +{POST}] s\n")
        f.write(f"  Baseline window: [{BASE_START}, {BASE_END}) s\n")
        f.write(f"  Response search window: [{PEAK_SEARCH_START}, {PEAK_SEARCH_END}] s\n")
        f.write("\nIncrease/Decrease metrics:\n")
        f.write("  peak_pos_robust_z = max RobustZ within response window\n")
        f.write("  peak_neg_robust_z = min RobustZ within response window (typically negative)\n")
    print(f"[OK] Saved: {rep}")

    print(f"[DONE] Case outputs: {case_root}")

# Run all candidate columns
for c in cand_cols:
    run_case(c)

print("\n[ALL DONE] Root:", root)
