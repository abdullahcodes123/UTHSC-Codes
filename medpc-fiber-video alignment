def parse_mmss_to_seconds(s: str) -> float:
    """
    Convert a string like "1.36" meaning 1 minute 36 seconds -> 96 seconds.
    If no dot exists, interpret as seconds.
    """
    s = s.strip()
    if "." in s:
        mm, ss = s.split(".", 1)
        return int(mm) * 60 + int(ss)
    return float(s)

