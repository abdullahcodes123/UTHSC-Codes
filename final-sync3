t_full = t_sec0[keep] - float(TRIM_START_SEC)
sig_full = sig_raw[keep]
ctl_full = ctl_raw[keep]

dt = float(np.nanmedian(np.diff(t_full)))
if not np.isfinite(dt) or dt <= 0:
    raise RuntimeError("Fiber timestamps invalid (dt<=0) after trimming.")
fs = 1.0 / dt

dur_f = float(np.nanmax(t_full)) if t_full.size else 0.0
print(f"[FIBER] scale={t_scale} trim={TRIM_START_SEC:.3f}s -> range={t_full.min():.3f}..{t_full.max():.3f}s Fs≈{fs:.3f}Hz")

