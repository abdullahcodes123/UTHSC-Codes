a_fit, b_fit = np.polyfit(ctl_n, sig_n, 1)
fit_ctl = a_fit * ctl_n + b_fit
dff_full = (sig_n - fit_ctl) / fit_ctl
print(f"[DFF] OLS: a={a_fit:.6f} b={b_fit:.6f}")

# =============================================================================
