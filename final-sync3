# 8) Write clips (VFR-safe): master time -> trimmed frame idx -> original frame idx
# =============================================================================
def write_increase_clips_vfrsafe(valid_list, out_dir: Path):
    if USE_FAKE_VIDEO:
        print("[FAKE VIDEO] skipping clip writing")
        return

    cap = cv2.VideoCapture(str(video_file))
    if not cap.isOpened():
        raise RuntimeError("Could not open video file (codec).")

    fourcc = cv2.VideoWriter_fourcc(*"mp4v")

    clip_iter = _pbar(list(enumerate(valid_list, start=1)), desc="[VIDEO] Writing clips", unit="clip", leave=True)
    for rank, (idx0, tpk_master, tev_master) in clip_iter:
        start_t = float(tpk_master - CLIP_PRE)
        end_t = float(tpk_master + CLIP_POST)

        # indices in TRIMMED timeline
        start_fr_trim = time_to_frame_idx(t_frame, start_t)
        end_fr_trim = time_to_frame_idx(t_frame, end_t)

        start_fr_trim = max(0, min(int(start_fr_trim), int(len(t_frame) - 1)))
        end_fr_trim = max(0, min(int(end_fr_trim), int(len(t_frame) - 1)))
        if end_fr_trim < start_fr_trim:
            start_fr_trim, end_fr_trim = end_fr_trim, start_fr_trim

        # convert to ORIGINAL frame indices by adding offset
        start_fr = int(start_frame_offset + start_fr_trim)
        end_fr = int(start_frame_offset + end_fr_trim)

        out_clip = out_dir / f"{rank}.mp4"
        writer = cv2.VideoWriter(str(out_clip), fourcc, float(fps_nominal), (W, H))

        cap.set(cv2.CAP_PROP_POS_FRAMES, int(start_fr))
        cur = int(start_fr)

        np_index = int(mp_ok_idx2[idx0])
        t_medpc_raw = float(mp_ok2[idx0])
        zpk = float(peak_z[idx0])
        pkoff = float(peak_off[idx0])

        frames_to_write = int(end_fr - start_fr + 1)
        p = None
        if tqdm is not None:
            p = tqdm(total=frames_to_write, desc=f"  clip {rank} frames", unit="fr", leave=False, mininterval=0.3)

        while cur <= int(end_fr):
            ret, frame = cap.read()
            if not ret:
                break

            line1 = f"{MEDPC_COL} | INCREASE | Clip {rank} | PeakZ={zpk:.2f} | PeakT(master)={tpk_master:.2f}s"
            line2 = f"EventT(master)={tev_master:.2f}s | MedPCraw={t_medpc_raw:.2f}s | NP#{np_index} | PeakOff={pkoff:.2f}s"
            line3 = f"MASTER = (VIDEO,FIBER) trimmed {TRIM_START_SEC:.1f}s then re-zero | Fs={fs:.2f}Hz | VFR-safe"

            cv2.putText(frame, line1, (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line2, (20, 72), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line3, (20, 104), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2, cv2.LINE_AA)

            writer.write(frame)
            cur += 1
            if tqdm is not None:
                p.update(1)

        if tqdm is not None:
            p.close()

        writer.release()
        print(f"[OK] Clip saved: {out_clip} (master t {start_t:.3f}..{end_t:.3f}s)")

    cap.release()


