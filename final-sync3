def parse_mmss_to_seconds(s: str) -> float:
    s = s.strip()
    if "." in s:
        mm, ss = s.split(".", 1)
        return int(mm) * 60 + int(ss)
    return float(s)


def apply_master_trim(times_s: np.ndarray, trim_s: float) -> np.ndarray:
    x = np.asarray(times_s, float) - float(trim_s)
    x = x[np.isfinite(x)]
    x = x[x >= 0.0]
    return np.sort(x)


