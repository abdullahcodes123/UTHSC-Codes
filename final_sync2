def write_increase_clips_vfrsafe(valid_list, out_dir: Path, t_frame_s: np.ndarray, fps_write: float):
    """
    Write video clips around each predicted INCREASE peak time in MASTER clock (video time).
    """
    cap = cv2.VideoCapture(str(video_file))
    if not cap.isOpened():
        raise RuntimeError("Could not open video file (codec).")

    fourcc = cv2.VideoWriter_fourcc(*"mp4v")

    clip_iter = _pbar(list(enumerate(valid_list, start=1)), desc="[VIDEO] Writing clips", unit="clip", leave=True)
    for rank, (idx0, tpkv, tev) in clip_iter:
        start_t = float(tpkv - CLIP_PRE)
        end_t = float(tpkv + CLIP_POST)

        start_fr = time_to_frame_idx(t_frame_s, start_t)
        end_fr = time_to_frame_idx(t_frame_s, end_t)

        start_fr = max(0, min(int(start_fr), int(len(t_frame_s) - 1)))
        end_fr = max(0, min(int(end_fr), int(len(t_frame_s) - 1)))
        if end_fr < start_fr:
            start_fr, end_fr = end_fr, start_fr

        out_clip = out_dir / f"{rank}.mp4"
        writer = cv2.VideoWriter(str(out_clip), fourcc, float(fps_write), (W, H))

        cap.set(cv2.CAP_PROP_POS_FRAMES, int(start_fr))
        cur = int(start_fr)

        np_index = int(mp_ok_idx2[idx0])
        t_medpc_raw = float(mp_ok2[idx0])
        zpk = float(peak_z[idx0])
        pkoff = float(peak_off[idx0])
        t_vid_peak = float(tpkv)
        t_vid_event = float(tev)

        frames_to_write = int(end_fr - start_fr + 1)
        p = None
        if tqdm is not None:
            p = tqdm(total=frames_to_write, desc=f"  clip {rank} frames", unit="fr", leave=False, mininterval=0.3)

        while cur <= int(end_fr):
            ret, frame = cap.read()
            if not ret:
                break

            line1 = f"{MEDPC_COL} | INCREASE | Clip {rank} | PeakZ={zpk:.2f} | PeakT={t_vid_peak:.2f}s"
            line2 = f"EventT(master)={t_vid_event:.2f}s | MedPCraw={t_medpc_raw:.2f}s | NP#{np_index} | PeakOff={pkoff:.2f}s"
            line3 = f"MASTER=VIDEO (PTS) == FIBER(start-sync) | FiberFs={fs:.2f}Hz | VFR-safe PTS timeline"

            cv2.putText(frame, line1, (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line2, (20, 72), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line3, (20, 104), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2, cv2.LINE_AA)

            writer.write(frame)
            cur += 1
            if tqdm is not None:
                p.update(1)

        if tqdm is not None:
            p.close()

        writer.release()
        print(f"[OK] Clip saved: {out_clip} (frames {start_fr}..{end_fr}, t {start_t:.3f}..{end_t:.3f}s)")

    cap.release()


