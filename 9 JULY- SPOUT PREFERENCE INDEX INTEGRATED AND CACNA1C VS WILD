make_old_style_plot <- function(summary_df, within_spout_tests,
                                sex_group_name, genotype_name) {
    
    plot_df <- summary_df %>%
        filter(Genotype == genotype_name, !is.na(Mean), Mean > 0)
    if (nrow(plot_df) == 0) return(NULL)
    
    plot_error_df <- plot_df %>%
        filter(!is.na(SEM), Mean - SEM > 0)
    
    day_breaks <- sort(unique(plot_df$Day_clean))
    day_labels <- paste("Day", day_breaks)
    
    # Star positions
    spout_star_df <- data.frame()
    if (!is.null(within_spout_tests) && nrow(within_spout_tests) > 0) {
        stars_raw <- within_spout_tests %>%
            filter(Genotype == genotype_name, p < 0.05)
        if (nrow(stars_raw) > 0) {
            max_by_day <- plot_df %>%
                filter(Measure %in% c("Active spout licks",
                                      "Inactive spout licks")) %>%
                group_by(Day_clean) %>%
                summarise(
                    max_val = max(Mean + ifelse(is.na(SEM), 0, SEM),
                                  na.rm = TRUE),
                    .groups = "drop")
            max_by_day$y <- star_y_position(max_by_day$max_val,
                                            use_log10_y_axis)
            spout_star_df <- stars_raw %>%
                inner_join(max_by_day, by = "Day_clean") %>%
                mutate(label = p_star) %>%
                filter(!is.na(y), label != "")
        }
    }
    
    p <- ggplot(plot_df, aes(x = Day_clean, y = Mean,
                             group = Measure)) +
        geom_line(aes(color = Measure, linetype = Measure),
                  linewidth = 1.2) +
        geom_errorbar(
            data = plot_error_df,
            aes(ymin = Mean - SEM, ymax = Mean + SEM,
                color = Measure),
            width = 0.15, linewidth = 0.7) +
        geom_point(
            aes(shape = Measure, fill = Measure,
                color = Measure),
            size = 5, stroke = 1.4) +
        scale_x_continuous(breaks = day_breaks,
                           labels = day_labels) +
        scale_shape_manual(values = c(
            "Active spout licks" = 16,
            "Inactive spout licks" = 21,
            "Infusions" = 15)) +
        scale_fill_manual(values = c(
            "Active spout licks" = "#9c1f5b",
            "Inactive spout licks" = "white",
            "Infusions" = "#9c1f5b")) +
        scale_color_manual(values = c(
            "Active spout licks" = "#9c1f5b",
            "Inactive spout licks" = "black",
            "Infusions" = "#9c1f5b")) +
        scale_linetype_manual(values = c(
            "Active spout licks" = "dashed",
            "Inactive spout licks" = "dashed",
            "Infusions" = "dashed")) +
        labs(
            title = paste(sex_group_name, "-", genotype_name),
            x = NULL,
            y = paste("Number of infusions or licks /",
                      session_duration_label),
            shape = NULL, fill = NULL,
            color = NULL, linetype = NULL) +
        theme_classic(base_size = 13) +
        theme(
            plot.title = element_text(face = "bold",
                                      hjust = 0.5, size = 18),
            axis.title.y = element_text(face = "bold", size = 15),
            axis.text.x = element_text(angle = 45, hjust = 1),
            legend.position = "right",
            legend.text = element_text(size = 12),
            legend.key = element_blank())
    
    if (nrow(spout_star_df) > 0) {
        p <- p + geom_text(
            data = spout_star_df,
            aes(x = Day_clean, y = y, label = label),
            inherit.aes = FALSE, size = 7, fontface = "bold")
    }
    if (use_log10_y_axis) p <- p + scale_y_log10()
    return(p)
}

make_genotype_comparison_plot <- function(summary_df,
                                          comparison_tests,
                                          sex_group_name,
                                          measure_name,
                                          test_col_name = "SpoutType") {
    
    plot_df <- summary_df %>%
        filter(Measure == measure_name, !is.na(Mean), Mean > 0)
    if (nrow(plot_df) == 0 || n_distinct(plot_df$Genotype) < 2)
        return(NULL)
    
    plot_error_df <- plot_df %>%
        filter(!is.na(SEM), Mean - SEM > 0)
    day_breaks <- sort(unique(plot_df$Day_clean))
    day_labels <- paste("Day", day_breaks)
    
    # Stars
    star_df <- data.frame()
    if (!is.null(comparison_tests) && nrow(comparison_tests) > 0) {
        if (test_col_name %in% names(comparison_tests)) {
            spout_val <- ifelse(
                measure_name == "Active spout licks",
                "Active spout", "Inactive spout")
            star_source <- comparison_tests %>%
                filter(.data[[test_col_name]] == spout_val,
                       p < 0.05)
        } else {
            star_source <- comparison_tests %>%
                filter(p < 0.05)
        }
        if (nrow(star_source) > 0) {
            max_by_day <- plot_df %>%
                group_by(Day_clean) %>%
                summarise(
                    max_val = max(Mean + ifelse(is.na(SEM), 0, SEM),
                                  na.rm = TRUE),
                    .groups = "drop")
            max_by_day$y <- star_y_position(max_by_day$max_val,
                                            use_log10_y_axis)
            star_df <- star_source %>%
                inner_join(max_by_day, by = "Day_clean") %>%
                mutate(label = p_star) %>%
                filter(!is.na(y), label != "")
        }
    }
    
    y_lab <- ifelse(measure_name == "Infusions",
                    paste("Infusions /", session_duration_label),
                    paste("Licks /", session_duration_label))
    
    p <- ggplot(plot_df, aes(x = Day_clean, y = Mean,
                             group = Genotype,
                             color = Genotype,
                             shape = Genotype)) +
        geom_line(linewidth = 1.2) +
        geom_errorbar(data = plot_error_df,
                      aes(ymin = Mean - SEM, ymax = Mean + SEM),
                      width = 0.15, linewidth = 0.7) +
        geom_point(size = 5, stroke = 1.4) +
        scale_x_continuous(breaks = day_breaks,
                           labels = day_labels) +
        scale_color_manual(values = c(
            "Wild type" = "#9c1f5b",
            "Cacna1c heterozygous" = "black")) +
        scale_shape_manual(values = c(
            "Wild type" = 16,
            "Cacna1c heterozygous" = 17)) +
        labs(
            title = paste(sex_group_name, "-", measure_name,
                          ": WT vs Cacna1c"),
            x = NULL, y = y_lab,
            color = NULL, shape = NULL) +
        theme_classic(base_size = 13) +
        theme(
            plot.title = element_text(face = "bold",
                                      hjust = 0.5, size = 16),
            axis.title.y = element_text(face = "bold", size = 15),
            axis.text.x = element_text(angle = 45, hjust = 1),
            legend.position = "top",
            legend.text = element_text(size = 12),
            legend.key = element_blank())
    
    if (nrow(star_df) > 0) {
        p <- p + geom_text(
            data = star_df,
            aes(x = Day_clean, y = y, label = label),
            inherit.aes = FALSE, size = 7, fontface = "bold")
    }
    if (use_log10_y_axis) p <- p + scale_y_log10()
    return(p)
}

