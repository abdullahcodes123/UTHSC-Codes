# 7A: Within-genotype spout preference by day
run_within_genotype_spout_tests_by_day <- function(data, sex_group_name) {
    test_data <- data %>%
        select(SubjectID, Genotype, Day_clean,
               ActiveSpout, InactiveSpout) %>%
        filter(!is.na(ActiveSpout), !is.na(InactiveSpout))
    if (nrow(test_data) == 0) return(NULL)
    
    out <- test_data %>%
        group_by(Genotype, Day_clean) %>%
        group_modify(~ {
            d <- .x; n_sub <- n_distinct(d$SubjectID)
            if (n_sub < minimum_n_per_group_for_ttest) {
                return(data.frame(N = n_sub, p = NA_real_,
                                  d_effect = NA_real_,
                                  test = "Skipped: N too small"))
            }
            result <- tryCatch(
                t.test(d$ActiveSpout, d$InactiveSpout, paired = TRUE),
                error = function(e) NULL)
            if (is.null(result)) {
                return(data.frame(N = n_sub, p = NA_real_,
                                  d_effect = NA_real_,
                                  test = "Skipped: t-test failed"))
            }
            data.frame(N = n_sub, p = result$p.value,
                       d_effect = cohens_d_paired(
                           d$ActiveSpout, d$InactiveSpout),
                       test = "Paired t-test: active vs inactive")
        }) %>%
        ungroup() %>%
        mutate(
            Sex_group  = sex_group_name,
            Comparison = "Within genotype spout preference by day",
            p_adj_BH   = p.adjust(p, method = "BH"),
            p_star     = p_to_star(p),
            p_adj_star = p_to_star(p_adj_BH),
            .before    = 1
        )
    return(out)
}

# 7B: Genotype comparison by spout and day
run_genotype_tests_by_spout_and_day <- function(licks_long, sex_group_name) {
    if (!genotype_mode) return(NULL)
    if (n_distinct(licks_long$Genotype) < 2) return(NULL)
    
    out <- licks_long %>%
        group_by(SpoutType, Day_clean) %>%
        group_modify(~ {
            d <- .x
            n_by_g <- d %>% group_by(Genotype) %>%
                summarise(N = n_distinct(SubjectID), .groups = "drop")
            
            if (n_distinct(d$Genotype) < 2 ||
                any(n_by_g$N < minimum_n_per_group_for_ttest)) {
                return(data.frame(
                    N_wildtype = NA_integer_, N_cacna1c = NA_integer_,
                    p = NA_real_, d_effect = NA_real_,
                    test = "Skipped"))
            }
            wt  <- d$Licks[d$Genotype == "Wild type"]
            het <- d$Licks[d$Genotype == "Cacna1c heterozygous"]
            result <- tryCatch(t.test(Licks ~ Genotype, data = d),
                               error = function(e) NULL)
            if (is.null(result)) {
                return(data.frame(
                    N_wildtype = length(wt), N_cacna1c = length(het),
                    p = NA_real_, d_effect = NA_real_,
                    test = "Skipped"))
            }
            data.frame(
                N_wildtype = length(wt), N_cacna1c = length(het),
                p = result$p.value,
                d_effect = cohens_d_unpaired(wt, het),
                test = "Unpaired t-test: WT vs Cacna1c")
        }) %>%
        ungroup() %>%
        mutate(
            Sex_group  = sex_group_name,
            Comparison = "Genotype difference by spout and day",
            p_adj_BH   = p.adjust(p, method = "BH"),
            p_star     = p_to_star(p),
            p_adj_star = p_to_star(p_adj_BH),
            .before    = 1
        )
    return(out)
}

# 7C: Genotype comparison for infusions by day
run_genotype_infusion_tests_by_day <- function(data, sex_group_name) {
    if (!genotype_mode) return(NULL)
    if (n_distinct(data$Genotype) < 2) return(NULL)
    
    test_data <- data %>%
        select(SubjectID, Genotype, Day_clean, Infusions) %>%
        filter(!is.na(Infusions))
    if (nrow(test_data) == 0) return(NULL)
    
    out <- test_data %>%
        group_by(Day_clean) %>%
        group_modify(~ {
            d <- .x
            n_by_g <- d %>% group_by(Genotype) %>%
                summarise(N = n_distinct(SubjectID), .groups = "drop")
            if (n_distinct(d$Genotype) < 2 ||
                any(n_by_g$N < minimum_n_per_group_for_ttest)) {
                return(data.frame(
                    N_wildtype = NA_integer_, N_cacna1c = NA_integer_,
                    p = NA_real_, d_effect = NA_real_,
                    test = "Skipped"))
            }
            wt  <- d$Infusions[d$Genotype == "Wild type"]
            het <- d$Infusions[d$Genotype == "Cacna1c heterozygous"]
            result <- tryCatch(t.test(Infusions ~ Genotype, data = d),
                               error = function(e) NULL)
            if (is.null(result)) {
                return(data.frame(
                    N_wildtype = length(wt), N_cacna1c = length(het),
                    p = NA_real_, d_effect = NA_real_,
                    test = "Skipped"))
            }
            data.frame(
                N_wildtype = length(wt), N_cacna1c = length(het),
                p = result$p.value,
                d_effect = cohens_d_unpaired(wt, het),
                test = "Unpaired t-test: WT vs Cacna1c infusions")
        }) %>%
        ungroup() %>%
        mutate(
            Sex_group  = sex_group_name,
            Comparison = "Genotype difference in infusions by day",
            p_adj_BH   = p.adjust(p, method = "BH"),
            p_star     = p_to_star(p),
            p_adj_star = p_to_star(p_adj_BH),
            .before    = 1
        )
    return(out)
}

# 7D: Licks ANOVA (per sex group)
run_licks_anova <- function(licks_long, sex_group_name) {
    if (nrow(licks_long) == 0) return(NULL)
    
    expected_rows <- length(unique(licks_long$Day_clean)) *
        length(unique(licks_long$SpoutType))
    complete_ids <- get_complete_subjects(
        licks_long, "SubjectID", expected_rows)
    licks_complete <- licks_long %>%
        filter(SubjectID %in% complete_ids) %>%
        droplevels()
    if (n_distinct(licks_complete$SubjectID) < 2) return(NULL)
    
    if (genotype_mode && n_distinct(licks_complete$Genotype) == 2) {
        result <- tryCatch({
            licks_complete %>%
                anova_test(dv = Licks, wid = SubjectID,
                           between = Genotype,
                           within = c(DayFactor, SpoutType))
        }, error = function(e) NULL)
        table <- clean_anova_table(get_anova_table(result))
        if (!is.null(table)) {
            table <- table %>%
                mutate(Sex_group = sex_group_name,
                       Analysis = "Licks mixed ANOVA: Genotype x Day x SpoutType",
                       .before = 1)
        }
        return(table)
    } else {
        result <- tryCatch({
            licks_complete %>%
                anova_test(dv = Licks, wid = SubjectID,
                           within = c(DayFactor, SpoutType))
        }, error = function(e) NULL)
        table <- clean_anova_table(get_anova_table(result))
        if (!is.null(table)) {
            table <- table %>%
                mutate(Sex_group = sex_group_name,
                       Analysis = "Licks RM-ANOVA: Day x SpoutType",
                       .before = 1)
        }
        return(table)
    }
}

# 7E: Full ANOVA with Sex as between-subject factor
run_full_licks_anova <- function(licks_long) {
    if (nrow(licks_long) == 0) return(NULL)
    if (n_distinct(licks_long$sex_clean) < 2) {
        cat("\nFull licks ANOVA skipped: only one sex present.\n")
        return(NULL)
    }
    
    expected_rows <- length(unique(licks_long$Day_clean)) *
        length(unique(licks_long$SpoutType))
    complete_ids <- get_complete_subjects(
        licks_long, "SubjectID", expected_rows)
    licks_complete <- licks_long %>%
        filter(SubjectID %in% complete_ids) %>%
        droplevels()
    if (n_distinct(licks_complete$SubjectID) < 4) return(NULL)
    
    if (genotype_mode && n_distinct(licks_complete$Genotype) == 2) {
        result <- tryCatch({
            licks_complete %>%
                anova_test(dv = Licks, wid = SubjectID,
                           between = c(Genotype, sex_clean),
                           within = c(DayFactor, SpoutType))
        }, error = function(e) {
            cat("\nFull ANOVA (Geno x Sex) error:",
                conditionMessage(e), "\n")
            cat("Falling back to Sex-only between factor.\n")
            NULL
        })
        table <- clean_anova_table(get_anova_table(result))
        if (!is.null(table)) {
            table <- table %>%
                mutate(Analysis = "FULL: Genotype x Sex x Day x SpoutType",
                       .before = 1)
            return(table)
        }
    }
    
    # Fallback: Sex only
    result <- tryCatch({
        licks_complete %>%
            anova_test(dv = Licks, wid = SubjectID,
                       between = sex_clean,
                       within = c(DayFactor, SpoutType))
    }, error = function(e) NULL)
    table <- clean_anova_table(get_anova_table(result))
    if (!is.null(table)) {
        table <- table %>%
            mutate(Analysis = "FULL: Sex x Day x SpoutType",
                   .before = 1)
    }
    return(table)
}

