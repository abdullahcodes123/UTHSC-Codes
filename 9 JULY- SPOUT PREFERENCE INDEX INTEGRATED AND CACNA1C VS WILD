# 14C: Statistical tests on SPI periods
spi_period_tests <- list()
test_counter <- 0

for (sx in c("Female", "Male")) {
    
    period_sx <- spi_period %>%
        filter(sex_clean == sx)
    
    if (nrow(period_sx) == 0) next
    
    cat("\n--- SPI Period Tests:", sx, "---\n")
    
    # ---- Test 1: Period x Genotype mixed ANOVA ----
    if (genotype_mode && n_distinct(period_sx$Genotype) == 2) {
        # Need animals with BOTH periods
        both_periods <- period_sx %>%
            group_by(SubjectID) %>%
            filter(n() == 2) %>%
            ungroup() %>%
            droplevels()
        
        if (n_distinct(both_periods$SubjectID) >= 4 &&
            n_distinct(both_periods$Genotype) == 2) {
            
            result <- tryCatch({
                both_periods %>%
                    anova_test(dv = Mean_SPI, wid = SubjectID,
                               between = Genotype, within = Period)
            }, error = function(e) NULL)
            
            table <- clean_anova_table(get_anova_table(result))
            if (!is.null(table)) {
                test_counter <- test_counter + 1
                table <- table %>%
                    mutate(Sex_group = sx,
                           Analysis = "SPI Period x Genotype mixed ANOVA",
                           .before = 1)
                spi_period_tests[[paste0("anova_", sx)]] <- table
                cat("  Period x Genotype ANOVA:\n")
                print(table)
            }
        } else {
            cat("  Period x Genotype ANOVA skipped: insufficient data.\n")
        }
    } else {
        # Single genotype: Period RM-ANOVA
        both_periods <- period_sx %>%
            group_by(SubjectID) %>%
            filter(n() == 2) %>%
            ungroup() %>%
            droplevels()
        
        if (n_distinct(both_periods$SubjectID) >= 2) {
            result <- tryCatch({
                both_periods %>%
                    anova_test(dv = Mean_SPI, wid = SubjectID,
                               within = Period)
            }, error = function(e) NULL)
            
            table <- clean_anova_table(get_anova_table(result))
            if (!is.null(table)) {
                test_counter <- test_counter + 1
                table <- table %>%
                    mutate(Sex_group = sx,
                           Analysis = "SPI Period RM-ANOVA",
                           .before = 1)
                spi_period_tests[[paste0("anova_", sx)]] <- table
                cat("  Period RM-ANOVA:\n")
                print(table)
            }
        }
    }
    
    # ---- Test 2: Paired t-test First vs Last within each genotype ----
    geno_present <- unique(as.character(period_sx$Genotype))
    for (g in geno_present) {
        period_g <- period_sx %>% filter(Genotype == g)
        
        # Get animals with both periods
        first_label <- paste0("First_", first_n_days)
        last_label  <- paste0("Last_", last_n_days)
        
        first_vals <- period_g %>%
            filter(Period == first_label) %>%
            arrange(SubjectID)
        last_vals <- period_g %>%
            filter(Period == last_label) %>%
            arrange(SubjectID)
        
        # Match by SubjectID
        common_ids <- intersect(first_vals$SubjectID,
                                last_vals$SubjectID)
        
        if (length(common_ids) >= minimum_n_per_group_for_ttest) {
            f_matched <- first_vals %>%
                filter(SubjectID %in% common_ids) %>%
                arrange(SubjectID)
            l_matched <- last_vals %>%
                filter(SubjectID %in% common_ids) %>%
                arrange(SubjectID)
            
            result <- tryCatch(
                t.test(l_matched$Mean_SPI, f_matched$Mean_SPI,
                       paired = TRUE),
                error = function(e) NULL)
            
            if (!is.null(result)) {
                test_counter <- test_counter + 1
                test_row <- data.frame(
                    Sex_group     = sx,
                    Genotype      = g,
                    Comparison    = paste0("Paired: Last ", last_n_days,
                                          " vs First ", first_n_days),
                    N             = length(common_ids),
                    Mean_First    = mean(f_matched$Mean_SPI),
                    Mean_Last     = mean(l_matched$Mean_SPI),
                    Delta         = mean(l_matched$Mean_SPI) -
                        mean(f_matched$Mean_SPI),
                    p             = result$p.value,
                    d_effect      = cohens_d_paired(
                        l_matched$Mean_SPI, f_matched$Mean_SPI),
                    p_star        = p_to_star(result$p.value),
                    test          = "Paired t-test: Last vs First SPI"
                )
                spi_period_tests[[paste0("paired_", sx, "_", g)]] <- test_row
                cat("  Paired First vs Last (", g, "):\n")
                cat("    Mean First =", round(mean(f_matched$Mean_SPI), 3),
                    " Mean Last =", round(mean(l_matched$Mean_SPI), 3),
                    " p =", round(result$p.value, 4),
                    " d =", round(test_row$d_effect, 3), "\n")
            }
        } else {
            cat("  Paired First vs Last (", g,
                ") skipped: N =", length(common_ids), "\n")
        }
    }
    
    # ---- Test 3: WT vs Cacna1c on LAST N days SPI ----
    if (genotype_mode && n_distinct(period_sx$Genotype) == 2) {
        last_only <- period_sx %>%
            filter(Period == paste0("Last_", last_n_days))
        
        wt_last  <- last_only$Mean_SPI[last_only$Genotype == "Wild type"]
        het_last <- last_only$Mean_SPI[last_only$Genotype == "Cacna1c heterozygous"]
        
        if (length(wt_last) >= minimum_n_per_group_for_ttest &&
            length(het_last) >= minimum_n_per_group_for_ttest) {
            
            result <- tryCatch(
                t.test(wt_last, het_last),
                error = function(e) NULL)
            
            if (!is.null(result)) {
                test_counter <- test_counter + 1
                test_row <- data.frame(
                    Sex_group   = sx,
                    Comparison  = paste0("WT vs Cacna1c: Last ",
                                        last_n_days, " days SPI"),
                    N_WT        = length(wt_last),
                    N_Het       = length(het_last),
                    Mean_WT     = mean(wt_last),
                    Mean_Het    = mean(het_last),
                    p           = result$p.value,
                    d_effect    = cohens_d_unpaired(wt_last, het_last),
                    p_star      = p_to_star(result$p.value),
                    test        = "Unpaired t-test: WT vs Cacna1c Last SPI"
                )
                spi_period_tests[[paste0("geno_last_", sx)]] <- test_row
                cat("  WT vs Cacna1c Last", last_n_days, ":\n")
                cat("    Mean WT =", round(mean(wt_last), 3),
                    " Mean Het =", round(mean(het_last), 3),
                    " p =", round(result$p.value, 4),
                    " d =", round(test_row$d_effect, 3), "\n")
            }
        }
        
        # ---- Test 4: WT vs Cacna1c on FIRST N days SPI ----
        first_only <- period_sx %>%
            filter(Period == paste0("First_", first_n_days))
        
        wt_first  <- first_only$Mean_SPI[first_only$Genotype == "Wild type"]
        het_first <- first_only$Mean_SPI[first_only$Genotype == "Cacna1c heterozygous"]
        
        if (length(wt_first) >= minimum_n_per_group_for_ttest &&
            length(het_first) >= minimum_n_per_group_for_ttest) {
            
            result <- tryCatch(
                t.test(wt_first, het_first),
                error = function(e) NULL)
            
            if (!is.null(result)) {
                test_counter <- test_counter + 1
                test_row <- data.frame(
                    Sex_group   = sx,
                    Comparison  = paste0("WT vs Cacna1c: First ",
                                        first_n_days, " days SPI"),
                    N_WT        = length(wt_first),
                    N_Het       = length(het_first),
                    Mean_WT     = mean(wt_first),
                    Mean_Het    = mean(het_first),
                    p           = result$p.value,
                    d_effect    = cohens_d_unpaired(wt_first, het_first),
                    p_star      = p_to_star(result$p.value),
                    test        = "Unpaired t-test: WT vs Cacna1c First SPI"
                )
                spi_period_tests[[paste0("geno_first_", sx)]] <- test_row
                cat("  WT vs Cacna1c First", first_n_days, ":\n")
                cat("    Mean WT =", round(mean(wt_first), 3),
                    " Mean Het =", round(mean(het_first), 3),
                    " p =", round(result$p.value, 4),
                    " d =", round(test_row$d_effect, 3), "\n")
            }
        }
    }
}

