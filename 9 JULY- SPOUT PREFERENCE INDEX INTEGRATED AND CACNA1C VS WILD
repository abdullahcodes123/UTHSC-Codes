safe_numeric <- function(x) {
    x <- as.character(x); x <- trimws(x); x <- gsub(",", ".", x)
    suppressWarnings(as.numeric(x))
}

safe_day_number <- function(x) {
    x <- as.character(x); x <- trimws(x); x <- gsub(",", ".", x)
    out <- suppressWarnings(as.numeric(x))
    missing_out <- is.na(out)
    if (any(missing_out)) {
        out[missing_out] <- suppressWarnings(
            as.numeric(gsub("[^0-9.]", "", x[missing_out]))
        )
    }
    return(out)
}

standardize_columns <- function(df) {
    name_map <- c(
        "sex" = "sex", "Sex" = "sex", "SEX" = "sex",
        "infusions" = "Infusions", "INFUSIONS" = "Infusions",
        "aid" = "AID", "Aid" = "AID",
        "day" = "Day", "DAY" = "Day"
    )
    current_names <- names(df)
    for (i in seq_along(current_names)) {
        if (current_names[i] %in% names(name_map)) {
            target <- name_map[current_names[i]]
            if (!(target %in% current_names)) {
                current_names[i] <- target
            }
        }
    }
    names(df) <- current_names
    return(df)
}

clean_anova_table <- function(x) {
    if (is.null(x)) return(NULL)
    x <- as.data.frame(x)
    attr(x, "args")    <- NULL
    attr(x, "heading") <- NULL
    class(x) <- "data.frame"
    return(x)
}

safe_bind <- function(df_list) {
    df_list <- df_list[!sapply(df_list, is.null)]
    if (length(df_list) == 0) return(data.frame())
    bind_rows(df_list)
}

p_to_star <- function(p) {
    dplyr::case_when(
        is.na(p)  ~ "",
        p < 0.001 ~ "***",
        p < 0.01  ~ "**",
        p < 0.05  ~ "*",
        TRUE      ~ ""
    )
}

get_complete_subjects <- function(data, subject_col_name, expected_n) {
    data %>%
        count(.data[[subject_col_name]]) %>%
        filter(n == expected_n) %>%
        pull(.data[[subject_col_name]])
}

safe_file_exists <- function(path) {
    !is.na(path) && nzchar(path) && file.exists(path)
}

clean_filename <- function(x) {
    x <- gsub(" ", "_", x); x <- gsub("/", "_", x)
    x <- gsub(":", "_", x); x <- gsub("\\+", "plus", x)
    x <- gsub("[^A-Za-z0-9_\\-]", "", x)
    return(x)
}

cohens_d_unpaired <- function(x, y) {
    nx <- length(x); ny <- length(y)
    if (nx < 2 || ny < 2) return(NA_real_)
    pooled_sd <- sqrt(((nx - 1) * sd(x)^2 + (ny - 1) * sd(y)^2) / (nx + ny - 2))
    if (pooled_sd == 0) return(NA_real_)
    (mean(x) - mean(y)) / pooled_sd
}

cohens_d_paired <- function(x, y) {
    diffs <- x - y; n <- length(diffs)
    if (n < 2) return(NA_real_)
    sd_diff <- sd(diffs)
    if (sd_diff == 0) return(NA_real_)
    mean(diffs) / sd_diff
}

# Vectorized star y-position (safe for vectors)
star_y_position <- function(max_val, use_log = TRUE) {
    ifelse(
        use_log & max_val > 0,
        10^(log10(pmax(max_val, 1e-10)) + 0.15),
        max_val * 1.15
    )
}

# Named-vector recode helpers (avoid deprecated recode/case_match)
recode_spout <- function(x) {
    lookup <- c("ActiveSpout" = "Active spout", "InactiveSpout" = "Inactive spout")
    out <- lookup[x]; names(out) <- NULL; return(out)
}

recode_measure <- function(x) {
    lookup <- c(
        "ActiveSpout"   = "Active spout licks",
        "InactiveSpout" = "Inactive spout licks",
        "Infusions"     = "Infusions"
    )
    out <- lookup[x]; names(out) <- NULL; return(out)
}

