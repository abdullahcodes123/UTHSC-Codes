run_one_sex_group <- function(data, sex_group_name) {
    
    cat("\n\n############################################################\n")
    cat("RUNNING SEX GROUP:", sex_group_name, "\n")
    cat("############################################################\n")
    
    if (sex_group_name == "Both") {
        df_sub <- data
    } else {
        df_sub <- data %>%
            filter(sex_clean == sex_group_name) %>%
            droplevels()
    }
    
    if (nrow(df_sub) == 0) {
        cat("\nNo data for this sex group. Skipping.\n")
        return(NULL)
    }
    
    cat("\nAnimals by genotype:\n")
    print(df_sub %>% distinct(SubjectID, Genotype) %>%
              count(Genotype, name = "N_animals"))
    
    licks_long <- make_licks_long(df_sub)
    plot_long  <- make_plot_long(df_sub)
    summary_df <- make_summary(plot_long)
    
    within_spout_tests <- tryCatch(
        run_within_genotype_spout_tests_by_day(df_sub, sex_group_name),
        error = function(e) { cat("  within_spout error:", conditionMessage(e), "\n"); NULL })
    
    genotype_spout_tests <- tryCatch(
        run_genotype_tests_by_spout_and_day(licks_long, sex_group_name),
        error = function(e) { cat("  geno_spout error:", conditionMessage(e), "\n"); NULL })
    
    genotype_infusion_tests <- tryCatch(
        run_genotype_infusion_tests_by_day(df_sub, sex_group_name),
        error = function(e) { cat("  geno_inf error:", conditionMessage(e), "\n"); NULL })
    
    licks_anova_table <- tryCatch(
        run_licks_anova(licks_long, sex_group_name),
        error = function(e) { cat("  licks_anova error:", conditionMessage(e), "\n"); NULL })
    
    infusion_anova_table <- tryCatch(
        run_infusion_anova(df_sub, sex_group_name),
        error = function(e) { cat("  inf_anova error:", conditionMessage(e), "\n"); NULL })
    
    base_name <- clean_filename(sex_group_name)
    
    # Save tables
    write.csv(summary_df,
              file.path(output_dir, paste0(base_name, "_summary_data.csv")),
              row.names = FALSE)
    if (!is.null(within_spout_tests) && nrow(within_spout_tests) > 0)
        write.csv(within_spout_tests,
                  file.path(output_dir, paste0(base_name, "_within_geno_spout_by_day.csv")),
                  row.names = FALSE)
    if (!is.null(genotype_spout_tests) && nrow(genotype_spout_tests) > 0)
        write.csv(genotype_spout_tests,
                  file.path(output_dir, paste0(base_name, "_geno_spout_by_day.csv")),
                  row.names = FALSE)
    if (!is.null(genotype_infusion_tests) && nrow(genotype_infusion_tests) > 0)
        write.csv(genotype_infusion_tests,
                  file.path(output_dir, paste0(base_name, "_geno_infusion_by_day.csv")),
                  row.names = FALSE)
    if (!is.null(licks_anova_table) && nrow(licks_anova_table) > 0)
        write.csv(licks_anova_table,
                  file.path(output_dir, paste0(base_name, "_licks_anova.csv")),
                  row.names = FALSE)
    if (!is.null(infusion_anova_table) && nrow(infusion_anova_table) > 0)
        write.csv(infusion_anova_table,
                  file.path(output_dir, paste0(base_name, "_infusion_anova.csv")),
                  row.names = FALSE)
    
    # Old-style plots
    geno_present <- unique(as.character(df_sub$Genotype))
    geno_present <- geno_present[!is.na(geno_present)]
    old_style_plots <- list()
    
    for (g in geno_present) {
        p_old <- tryCatch(
            make_old_style_plot(summary_df, within_spout_tests,
                                sex_group_name, g),
            error = function(e) NULL)
        if (!is.null(p_old)) {
            print(p_old)
            ggsave(file.path(output_dir, paste0(
                base_name, "_", clean_filename(g),
                "_old_style.png")),
                p_old, width = 9, height = 5.5, dpi = 300)
            old_style_plots[[g]] <- p_old
        }
    }
    
    # Genotype comparison plots
    active_geno_plot   <- NULL
    inactive_geno_plot <- NULL
    infusion_geno_plot <- NULL
    
    if (genotype_mode && n_distinct(df_sub$Genotype) == 2) {
        active_geno_plot <- tryCatch(
            make_genotype_comparison_plot(
                summary_df, genotype_spout_tests,
                sex_group_name, "Active spout licks", "SpoutType"),
            error = function(e) NULL)
        inactive_geno_plot <- tryCatch(
            make_genotype_comparison_plot(
                summary_df, genotype_spout_tests,
                sex_group_name, "Inactive spout licks", "SpoutType"),
            error = function(e) NULL)
        infusion_geno_plot <- tryCatch(
            make_genotype_comparison_plot(
                summary_df, genotype_infusion_tests,
                sex_group_name, "Infusions", "none"),
            error = function(e) NULL)
        
        if (!is.null(active_geno_plot)) {
            print(active_geno_plot)
            ggsave(file.path(output_dir, paste0(
                base_name, "_active_WT_vs_cacna1c.png")),
                active_geno_plot, width = 8, height = 5.5, dpi = 300)
        }
        if (!is.null(inactive_geno_plot)) {
            print(inactive_geno_plot)
            ggsave(file.path(output_dir, paste0(
                base_name, "_inactive_WT_vs_cacna1c.png")),
                inactive_geno_plot, width = 8, height = 5.5, dpi = 300)
        }
        if (!is.null(infusion_geno_plot)) {
            print(infusion_geno_plot)
            ggsave(file.path(output_dir, paste0(
                base_name, "_infusions_WT_vs_cacna1c.png")),
                infusion_geno_plot, width = 8, height = 5.5, dpi = 300)
        }
    } else {
        cat("\nGenotype comparison plots skipped for",
            sex_group_name, "(only one genotype).\n")
    }
    
    return(list(
        sex_group               = sex_group_name,
        summary_df              = summary_df,
        within_spout_tests      = within_spout_tests,
        genotype_spout_tests    = genotype_spout_tests,
        genotype_infusion_tests = genotype_infusion_tests,
        licks_anova_table       = licks_anova_table,
        infusion_anova_table    = infusion_anova_table,
        old_style_plots         = old_style_plots,
        active_geno_plot        = active_geno_plot,
        inactive_geno_plot      = inactive_geno_plot,
        infusion_geno_plot      = infusion_geno_plot
    ))
}

