        plt.savefig(out_png, dpi=200)
        plt.close()
        print(f"[OK] Saved: {out_png}")

    save_grid(valid_inc, "increase")
    save_grid(valid_dec, "decrease")

    # ----------------------------
    # 9) ALL EVENTS mean peri-event + AUC
    # ----------------------------
    finite_rows = np.all(np.isfinite(rz_trials), axis=1)
    rz_valid = rz_trials[finite_rows]

    if rz_valid.shape[0] >= 5:
        mean_rz = np.nanmean(rz_valid, axis=0)
        sem_rz = np.nanstd(rz_valid, axis=0, ddof=1) / np.sqrt(rz_valid.shape[0])

        auc_net_0_3 = auc_trapz(mean_rz, epoch, 0.0, 3.0)
        auc_net_0_5 = auc_trapz(mean_rz, epoch, 0.0, 5.0)

        mean_pos = np.where(mean_rz > 0, mean_rz, 0.0)
        mean_neg = np.where(mean_rz < 0, mean_rz, 0.0)
        auc_pos_0_3 = auc_trapz(mean_pos, epoch, 0.0, 3.0)
        auc_pos_0_5 = auc_trapz(mean_pos, epoch, 0.0, 5.0)
        auc_neg_0_3 = auc_trapz(mean_neg, epoch, 0.0, 3.0)  # negative value
        auc_neg_0_5 = auc_trapz(mean_neg, epoch, 0.0, 5.0)  # negative value

        auc_df = pd.DataFrame([{
            "medpc_column": colname,
            "n_events_used": int(rz_valid.shape[0]),
            "AUC_net_mean_trace_0_3s": auc_net_0_3,
            "AUC_net_mean_trace_0_5s": auc_net_0_5,
            "AUC_pos_mean_trace_0_3s": auc_pos_0_3,
            "AUC_pos_mean_trace_0_5s": auc_pos_0_5,
            "AUC_neg_mean_trace_0_3s": auc_neg_0_3,
            "AUC_neg_mean_trace_0_5s": auc_neg_0_5,
        }])
        auc_csv = case_root / "all_events_mean_trace_auc.csv"
        auc_df.to_csv(auc_csv, index=False)
        print(f"[OK] Saved: {auc_csv}")

        avg_png = figdir / "all_events_mean_peri_event_robustZ.png"
        plt.figure(figsize=(10, 5))
        plt.plot(epoch, mean_rz, linewidth=2, label="Mean Robust Z")
        plt.fill_between(epoch, mean_rz - sem_rz, mean_rz + sem_rz, alpha=0.25, label="SEM")
        plt.axvline(0, linestyle="--", linewidth=1)
        plt.xlim(-PRE, POST)
        plt.xlabel("Time (s) relative to nosepoke")
        plt.ylabel("Robust Z (dF/F)")
        plt.title(
            f"All aligned nosepokes (n={rz_valid.shape[0]}) | "
            f"NetAUC(0-3)={auc_net_0_3:.3f} NetAUC(0-5)={auc_net_0_5:.3f}"
        )
        plt.legend()
        plt.tight_layout()
        plt.savefig(avg_png, dpi=200)
        plt.close()
        print(f"[OK] Saved: {avg_png}")
    else:
        print("[WARN] Not enough finite peri-event trials for mean/SEM and AUC.")

    # ----------------------------
    # 10) Write clips for INCREASE and DECREASE
    # ----------------------------
    def write_clips(valid_list, mode: str, out_dir: Path):
        cap = cv2.VideoCapture(str(video_file))
        if not cap.isOpened():
            raise RuntimeError("Could not open video file (codec).")

        fps_meta2 = cap.get(cv2.CAP_PROP_FPS)
        fps_use = estimate_video_fps_if_needed(cap, fps_meta2)
        fourcc = cv2.VideoWriter_fourcc(*"mp4v")

        for rank, (idx0, tpkv, _) in enumerate(valid_list, start=1):
            start_t = tpkv - CLIP_PRE
            end_t = tpkv + CLIP_POST
            start_fr = int(round(start_t * fps_use))
            end_fr = int(round(end_t * fps_use))

            out_clip = out_dir / f"{rank}.mp4"
            writer = cv2.VideoWriter(str(out_clip), fourcc, fps_use, (W, H))

            cap.set(cv2.CAP_PROP_POS_FRAMES, start_fr)
            cur = start_fr

            np_index = int(mp_ok_idx[idx0])
            t_medpc = float(mp_ok[idx0])

            if mode == "increase":
                zpk = float(peak_pos_z[idx0])
                pkoff = float(peak_pos_off[idx0])
                t_vid_peak = float(t_video_peak_pos[idx0])
            else:
                zpk = float(peak_neg_z[idx0])  # negative
                pkoff = float(peak_neg_off[idx0])
                t_vid_peak = float(t_video_peak_neg[idx0])

            while cur <= end_fr:
                ret, frame = cap.read()
                if not ret:
                    break

                line1 = f"{colname} | {mode.upper()} | Clip {rank} | PeakZ={zpk:.2f} | VideoPeak={t_vid_peak:.2f}s"
                line2 = f"MedPC={t_medpc:.2f}s | NosepokeIndex={np_index} | PeakOffsetFiber={pkoff:.2f}s"
                line3 = f"PBcorr EMA tau={PB_TAU_SEC:.0f}s | FiberFs={fs:.2f}Hz | VideoFPS={fps_use:.2f}"

                cv2.putText(frame, line1, (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2, cv2.LINE_AA)
                cv2.putText(frame, line2, (20, 72), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2, cv2.LINE_AA)
                cv2.putText(frame, line3, (20, 104), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2, cv2.LINE_AA)

                writer.write(frame)
                cur += 1

            writer.release()
            print(f"[OK] Clip saved: {out_clip} (5s before + 5s after)")

        cap.release()

    write_clips(valid_inc, "increase", viddir_inc)
    write_clips(valid_dec, "decrease", viddir_dec)

    # ----------------------------
    # 11) Validation harness outputs (bootstrap + checks)
    # ----------------------------
    # MV bootstrap (stability of a_mv,b_mv)
    mv_boot = bootstrap_mv(
        mv_windows, best_a=a_mv, best_b=b_mv, tol=TOL_MANUAL,
        n_boot=BOOTSTRAP_MV_N, seed=BOOTSTRAP_SEED
    )
    mv_boot_csv = valdir / "bootstrap_mv.csv"
    mv_boot.to_csv(mv_boot_csv, index=False)
    print(f"[OK] Saved: {mv_boot_csv}")

    # MF bootstrap (stability of best b around chosen mapping, resampling events)
    mf_boot = bootstrap_mf_score_around_best(
        mp_focus=mp_focus,
        t=t, dff=dff,
        epoch=epoch, base_mask=base_mask, search_mask=search_mask,
        a_mv=a_mv, b_mv=b_mv, dur_v=dur_v,
        a_mf_best=a_mf, b_mf_best=b_mf,
        n_boot=BOOTSTRAP_MF_N, seed=BOOTSTRAP_SEED + 77
    )
    mf_boot_csv = valdir / "bootstrap_mf.csv"
    mf_boot.to_csv(mf_boot_csv, index=False)
    print(f"[OK] Saved: {mf_boot_csv}")

    # Basic sanity checks
    checks = basic_sanity_checks(a_mv, b_mv, a_mf, b_mf, mp_s, t, dur_v)

    # Summarize bootstrap distributions (robustly)
    def qstats(x):
        x = np.array(x, float)
        x = x[np.isfinite(x)]
        if len(x) == 0:
            return (np.nan, np.nan, np.nan, np.nan)
        return (float(np.median(x)), float(np.quantile(x, 0.16)), float(np.quantile(x, 0.84)), float(np.std(x)))

    mv_a_med, mv_a_q16, mv_a_q84, mv_a_sd = qstats(mv_boot["a"]) if len(mv_boot) else (np.nan, np.nan, np.nan, np.nan)
    mv_b_med, mv_b_q16, mv_b_q84, mv_b_sd = qstats(mv_boot["b"]) if len(mv_boot) else (np.nan, np.nan, np.nan, np.nan)
    mf_b_med, mf_b_q16, mf_b_q84, mf_b_sd = qstats(mf_boot["b"]) if len(mf_boot) else (np.nan, np.nan, np.nan, np.nan)
    mf_sc_med, mf_sc_q16, mf_sc_q84, mf_sc_sd = qstats(mf_boot["score"]) if len(mf_boot) else (np.nan, np.nan, np.nan, np.nan)

    # Write validation report
    val_rep = valdir / "validation_report.txt"
    with open(val_rep, "w", encoding="utf-8") as f:
        f.write("VALIDATION REPORT\n")
        f.write(f"Case: {colname}\n\n")

        f.write("Manual anchor windows used for MV alignment:\n")
        f.write(f"  0-10 min anchors: {manual_0_10_txt}\n")
        f.write(f"  MID anchors:      {manual_mid_txt}\n")
        f.write(f"  35-45 min anchors:{manual_35_45_txt}\n\n")

        f.write("Best mappings:\n")
        f.write(f"  MV: t_video = {a_mv:.9f} * t_medpc + {b_mv:.6f}\n")
        f.write(f"  MF: t_fiber = {a_mf:.9f} * t_medpc + {b_mf:.6f}\n\n")

        f.write("MV per-window errors (at best a,b):\n")
        for nm in ["w0_10", "wmid", "w35_45"]:
            if nm in mv_per:
                mae, miss = mv_per[nm]
                f.write(f"  {nm}: MAE={mae:.3f}s miss={miss}\n")
        f.write("\n")

        f.write("MV bootstrap (local neighborhood) summary:\n")
        f.write(f"  a_mv median={mv_a_med:.9f}  q16={mv_a_q16:.9f}  q84={mv_a_q84:.9f}  sd={mv_a_sd:.9f}\n")
        f.write(f"  b_mv median={mv_b_med:.6f}  q16={mv_b_q16:.6f}  q84={mv_b_q84:.6f}  sd={mv_b_sd:.6f}\n")
        f.write(f"  saved: {mv_boot_csv}\n\n")

        f.write("MF bootstrap (resample events; optimize local b) summary:\n")
        f.write(f"  b_mf median={mf_b_med:.6f}  q16={mf_b_q16:.6f}  q84={mf_b_q84:.6f}  sd={mf_b_sd:.6f}\n")
        f.write(f"  score median={mf_sc_med:.3f} q16={mf_sc_q16:.3f} q84={mf_sc_q84:.3f} sd={mf_sc_sd:.3f}\n")
        f.write(f"  saved: {mf_boot_csv}\n\n")

        f.write("Automatic sanity checks:\n")
        for k, (ok, msg) in checks.items():
            f.write(f"  [{ 'PASS' if ok else 'FAIL' }] {k}: {msg}\n")
        f.write("\n")

        f.write("Interpretation note:\n")
        f.write("  - If DECREASE clips (strong negative Z in 0-3s) look more behavior-linked than INCREASE,\n")
        f.write("    your 'nosepoke response' might be a suppression (dip) rather than an activation.\n")

    print(f"[OK] Saved: {val_rep}")

    # ----------------------------
    # 12) Alignment report (case-specific, expanded)
    # ----------------------------
    rep = figdir / "alignment_report.txt"
    with open(rep, "w", encoding="utf-8") as f:
        f.write("TIME MAPPINGS\n")
        f.write(f"MedPC column: {colname}\n")
        f.write(f"MedPC time scale applied: {mp_scale}\n")
        f.write(f"Fiber time scale applied: {t_scale}\n")
        f.write(f"Fiber Fs inferred from timestamps: {fs:.6f} Hz\n")
        f.write(f"Video FPS inferred: {fps_v:.6f}\n\n")

        f.write("MedPC -> Video (multi-window manual anchor brute-force):\n")
        f.write("  t_video = a_mv * t_medpc + b_mv\n")
        f.write(f"  a_mv = {a_mv:.9f}\n")
        f.write(f"  b_mv = {b_mv:.6f}\n")
        f.write("  Manual windows:\n")
        f.write(f"    w0_10  anchors={len(manual_0_10)}  MedPC events in window={len(mp_0_10)}\n")
        f.write(f"    wmid   anchors={len(manual_mid)}   MedPC events in window={len(mp_mid)}\n")
        f.write(f"    w35_45 anchors={len(manual_35_45)} MedPC events in window={len(mp_35_45)}\n")
        for nm in ["w0_10", "wmid", "w35_45"]:
            if nm in mv_per:
                mae, miss = mv_per[nm]
                f.write(f"    {nm}: MAE={mae:.3f}s miss={miss}\n")
        f.write("\n")

        f.write("MedPC -> Fiber (grid + fine b, VIDEO-GROUNDED score):\n")
        f.write("  t_fiber = a_mf * t_medpc + b_mf\n")
        f.write(f"  a_mf = {a_mf:.9f}\n")
        f.write(f"  b_mf = {b_mf:.6f}\n")
        f.write(f"  MF_ALPHA_VALID={MF_ALPHA_VALID}, MF_B_STABIL={MF_B_STABIL}\n")
        f.write(f"  coarse_max_events={MF_COARSE_MAX_EVENTS}\n\n")

        f.write("Photobleaching correction:\n")
        f.write("  trend = EMA(raw, tau=PB_TAU_SEC)\n")
        f.write("  signal_n = signal / trend_signal\n")
        f.write("  control_n = control / trend_control\n")
        f.write(f"  PB_TAU_SEC = {PB_TAU_SEC}\n\n")

        f.write("Processing (pMAT-style core):\n")
        f.write("  fitted_control = a * control_n + b (OLS)\n")
        f.write("  dF/F = (signal_n - fitted_control) / fitted_control\n")
        f.write("  Robust Z = (dF/F - median(baseline)) / MAD(baseline)\n")
        f.write(f"  Peri-event window: [-{PRE}, +{POST}] s\n")
        f.write(f"  Baseline window: [{BASE_START}, {BASE_END}) s\n")
        f.write(f"  Response search window: [{PEAK_SEARCH_START}, {PEAK_SEARCH_END}] s\n\n")

        f.write("Increase/Decrease metrics:\n")
        f.write("  peak_pos_robust_z = max RobustZ within response window\n")
        f.write("  peak_neg_robust_z = min RobustZ within response window (typically negative)\n")
        f.write("  DECREASE strength = -peak_neg_robust_z (positive magnitude)\n")
    print(f"[OK] Saved: {rep}")

    print(f"[DONE] Case outputs: {case_root}")


