def run_case(colname: str):
    case_root = root / f"case_{colname}"
    figdir = case_root / "figures"
    viddir_inc = case_root / "videos_increase"
    viddir_dec = case_root / "videos_decrease"
    valdir = case_root / "validation"
    figdir.mkdir(parents=True, exist_ok=True)
    viddir_inc.mkdir(parents=True, exist_ok=True)
    viddir_dec.mkdir(parents=True, exist_ok=True)
    valdir.mkdir(parents=True, exist_ok=True)

    # Copy photobleach plot into case folder for completeness (same underlying fiber data)
    pb_png = figdir / "photobleach_trends.png"
    plt.figure(figsize=(12, 5))
    plt.plot(t, sig, linewidth=0.7, label="Signal raw", alpha=0.7)
    plt.plot(t, trend_sig, linewidth=2.0, label=f"Signal EMA trend (tau={PB_TAU_SEC}s)")
    plt.plot(t, ctl, linewidth=0.7, label="Control raw", alpha=0.7)
    plt.plot(t, trend_ctl, linewidth=2.0, label=f"Control EMA trend (tau={PB_TAU_SEC}s)")
    plt.xlabel("Time (s)")
    plt.ylabel("Fluorescence (raw units)")
    plt.title("Photobleaching / drift trends (EMA)")
    plt.legend()
    plt.tight_layout()
    plt.savefig(pb_png, dpi=200)
    plt.close()

    # ----------------------------
    # 1) MEDPC load + normalize + cluster
    # ----------------------------
    mp_raw = pd.to_numeric(bdf[colname], errors="coerce").dropna().to_numpy()
    mp_raw = mp_raw[mp_raw > 0].astype(float)
    mp_raw = np.sort(mp_raw)

    mp_s, mp_scale = normalize_to_seconds_by_dt(mp_raw)
    mp_s = mp_s - float(np.min(mp_s)) if len(mp_s) else mp_s
    mp_s = cluster_events(mp_s, CLUSTER_WIN)

    mp_idx = np.arange(1, len(mp_s) + 1, dtype=int)

    print(f"\n=== CASE: {colname} ===")
    print(f"[OK] MedPC clustered events: n={len(mp_s)} scale={mp_scale} range={mp_s.min():.1f}..{mp_s.max():.1f}s")

    # Windowed MedPC subsets that correspond to your manual windows
    mp_0_10   = mp_s[(mp_s >= 0) & (mp_s <= 600)]
    mp_mid    = mp_s[(mp_s >= MID_WIN_START_S) & (mp_s <= MID_WIN_END_S)]
    mp_35_45  = mp_s[(mp_s >= 35 * 60) & (mp_s <= 45 * 60)]

    print(f"[OK] MedPC windows: 0-10min n={len(mp_0_10)} | mid(10-35) n={len(mp_mid)} | 35-45min n={len(mp_35_45)}")
    print(f"[OK] Manual anchors: 0-10 n={len(manual_0_10)} | mid n={len(manual_mid)} | 35-45 n={len(manual_35_45)}")

    # ----------------------------
    # 2) MedPC -> Video alignment using THREE manual windows
    # ----------------------------
    mv_windows = [
        {"name": "w0_10",  "manual": manual_0_10,  "mp": mp_0_10},
        {"name": "wmid",   "manual": manual_mid,   "mp": mp_mid},
        {"name": "w35_45", "manual": manual_35_45, "mp": mp_35_45},
    ]
    mv = best_affine_medpc_to_video_multi(mv_windows, tol=TOL_MANUAL)
    a_mv, b_mv = float(mv["a"]), float(mv["b"])

    # Compute per-window MAE/misses at best
    mv_per = {name: (mae, miss) for (name, mae, miss) in mv["per"]}
    print(f"[ALIGN MV] t_video = {a_mv:.6f}*t_medpc + {b_mv:.3f}  total_score={mv['score']:.2f}")
    for nm in ["w0_10", "wmid", "w35_45"]:
        if nm in mv_per:
            mae, miss = mv_per[nm]
            print(f"          [{nm}] MAE={mae:.2f}s miss={miss}")

    # ----------------------------
    # 3) MedPC -> Fiber alignment (grid + fine b), VIDEO-GROUNDED, direction='either'
    # ----------------------------
    dur_mp = float(np.max(mp_s)) if len(mp_s) else 1.0
    dur_f = float(np.max(t))
    a0 = dur_f / dur_mp

    a_list = np.arange(max(0.8, a0 - A_MF_PAD), min(1.2, a0 + A_MF_PAD) + 1e-12, A_MF_STEP_COARSE)
    b_list = np.arange(B_MF_MIN, B_MF_MAX + 1e-12, B_MF_STEP_COARSE)

    # Focus events in windows where we have manual anchors (makes alignment more stable)
    mp_focus = np.concatenate([mp_0_10, mp_mid, mp_35_45]) if (len(mp_0_10) + len(mp_mid) + len(mp_35_45)) > 0 else mp_s

    # Subsample deterministically for coarse
    if len(mp_focus) > MF_COARSE_MAX_EVENTS:
        stride = int(np.ceil(len(mp_focus) / MF_COARSE_MAX_EVENTS))
        mp_focus_coarse = mp_focus[::stride]
    else:
        mp_focus_coarse = mp_focus

    best_mf = None
    for a in a_list:
        for b in b_list:
            sc, nused, vratio, med_pos, med_neg = score_medpc_to_fiber_videogrounded(
                float(a), float(b),
                mp_focus_coarse,
                t, dff,
                epoch, base_mask, search_mask,
                a_mv, b_mv, dur_v,
                direction="either"
            )
            if best_mf is None or sc > best_mf["score"]:
                best_mf = {
                    "a": float(a),
                    "b": float(b),
                    "score": float(sc),
                    "nused": int(nused),
                    "valid_ratio": float(vratio),
                    "med_pos": float(med_pos) if np.isfinite(med_pos) else np.nan,
                    "med_neg": float(med_neg) if np.isfinite(med_neg) else np.nan,
                }

    if best_mf is None or best_mf["score"] < -1e8:
        raise RuntimeError("Failed to find MedPC->Fiber alignment (coarse).")

    # Fine b around coarse best using FULL mp_focus
    a_mf = best_mf["a"]
    b0 = best_mf["b"]
    b_list2 = np.arange(b0 - 3.0, b0 + 3.0 + 1e-12, B_MF_STEP_FINE)

    best2 = None
    for b in b_list2:
        sc, nused, vratio, med_pos, med_neg = score_medpc_to_fiber_videogrounded(
            a_mf, float(b),
            mp_focus,
            t, dff,
            epoch, base_mask, search_mask,
            a_mv, b_mv, dur_v,
            direction="either"
        )
        if best2 is None or sc > best2["score"]:
            best2 = {
                "a": float(a_mf),
                "b": float(b),
                "score": float(sc),
                "nused": int(nused),
                "valid_ratio": float(vratio),
                "med_pos": float(med_pos) if np.isfinite(med_pos) else np.nan,
                "med_neg": float(med_neg) if np.isfinite(med_neg) else np.nan,
            }

    a_mf, b_mf = best2["a"], best2["b"]
    print(f"[ALIGN MF VIDEO-GROUNDED] t_fiber = {a_mf:.6f}*t_medpc + {b_mf:.3f} "
          f"(score={best2['score']:.3f}, nused={best2['nused']}, valid_ratio={best2['valid_ratio']:.2f})")

    # ----------------------------
    # 4) Peri-event for ALL events: compute BOTH increase and decrease
    # ----------------------------
    ev_fiber_all = a_mf * mp_s + b_mf
    ok_fiber = (ev_fiber_all - PRE >= t.min()) & (ev_fiber_all + POST <= t.max())

    mp_ok = mp_s[ok_fiber]
    mp_ok_idx = mp_idx[ok_fiber]
    ev_fiber = ev_fiber_all[ok_fiber]

    print(f"[OK] Events usable in fiber: n={len(ev_fiber)}")

    rz_trials = []
    peak_pos_z = []
    peak_pos_off = []
    peak_neg_z = []
    peak_neg_off = []

    for e in ev_fiber:
        tr = np.interp(e + epoch, t, dff)
        rz = robust_z(tr, base_mask)
        zz = rz[search_mask]

        if np.all(np.isnan(zz)):
            rz_trials.append(rz)
            peak_pos_z.append(np.nan); peak_pos_off.append(np.nan)
            peak_neg_z.append(np.nan); peak_neg_off.append(np.nan)
            continue

        kmax = int(np.nanargmax(zz))
        kmin = int(np.nanargmin(zz))

        rz_trials.append(rz)
        peak_pos_z.append(float(zz[kmax]))
        peak_pos_off.append(float(search_t[kmax]))

        peak_neg_z.append(float(zz[kmin]))          # negative (usually)
        peak_neg_off.append(float(search_t[kmin]))

    rz_trials = np.vstack(rz_trials) if len(rz_trials) else np.zeros((0, len(epoch)))
    peak_pos_z = np.array(peak_pos_z, dtype=float)
    peak_pos_off = np.array(peak_pos_off, dtype=float)
    peak_neg_z = np.array(peak_neg_z, dtype=float)
    peak_neg_off = np.array(peak_neg_off, dtype=float)

    # ----------------------------
    # 5) Video times for BOTH pos and neg peaks
    # ----------------------------
    t_video_event_all = a_mv * mp_ok + b_mv
    t_video_peak_pos = t_video_event_all + (a_mv / a_mf) * peak_pos_off
    t_video_peak_neg = t_video_event_all + (a_mv / a_mf) * peak_neg_off

    ok_video_pos = (t_video_peak_pos - CLIP_PRE >= 0) & (t_video_peak_pos + CLIP_POST <= dur_v) & np.isfinite(t_video_peak_pos)
    ok_video_neg = (t_video_peak_neg - CLIP_PRE >= 0) & (t_video_peak_neg + CLIP_POST <= dur_v) & np.isfinite(t_video_peak_neg)

    print(f"[OK] Events usable in video (increase-peaks, 5+5s): n={int(np.sum(ok_video_pos))}")
    print(f"[OK] Events usable in video (decrease-peaks, 5+5s): n={int(np.sum(ok_video_neg))}")

    # Full event table
    all_events_df = pd.DataFrame({
        "nosepoke_index": mp_ok_idx.astype(int),
        "t_medpc_s": mp_ok.astype(float),
        "t_fiber_event_s": ev_fiber.astype(float),

        "peak_pos_robust_z": peak_pos_z.astype(float),
        "peak_pos_offset_fiber_s": peak_pos_off.astype(float),
        "t_video_peak_pos_s": t_video_peak_pos.astype(float),
        "usable_in_video_pos": ok_video_pos.astype(bool),

        "peak_neg_robust_z": peak_neg_z.astype(float),
        "peak_neg_offset_fiber_s": peak_neg_off.astype(float),
        "t_video_peak_neg_s": t_video_peak_neg.astype(float),
        "usable_in_video_neg": ok_video_neg.astype(bool),

        "t_video_event_s": t_video_event_all.astype(float),
    })
    all_events_csv = case_root / "all_aligned_events.csv"
    all_events_df.to_csv(all_events_csv, index=False)
    print(f"[OK] Saved: {all_events_csv}")

    # ----------------------------
    # 6) Select TOP events (with refractory) for INCREASE and DECREASE separately
    # ----------------------------
    def choose_top_indices(scores: np.ndarray, mp_times: np.ndarray, refractory: float, max_keep: int = 200, descending: bool = True):
        # descending=True: pick large scores first
        key = -np.nan_to_num(scores, nan=-1e9) if descending else np.nan_to_num(scores, nan=1e9)
        order = np.argsort(key)
        chosen = []
        used_mp = []
        for idx0 in order:
            t_mp = float(mp_times[idx0])
            if any(abs(t_mp - u) < refractory for u in used_mp):
                continue
            chosen.append(int(idx0))
            used_mp.append(t_mp)
            if len(chosen) >= max_keep:
                break
        return np.array(chosen, dtype=int)

    # INCREASE: maximize peak_pos_z
    chosen_inc = choose_top_indices(peak_pos_z, mp_ok, EVENT_REFRACTORY, max_keep=200, descending=True)
    valid_inc = []
    for idx0 in chosen_inc:
        if not ok_video_pos[idx0]:
            continue
        valid_inc.append((idx0, float(t_video_peak_pos[idx0]), float(t_video_event_all[idx0])))
        if len(valid_inc) >= TARGET_CLIPS:
            break
    print(f"[OK] Valid INCREASE clips: n={len(valid_inc)} (target={TARGET_CLIPS})")

    # DECREASE: maximize magnitude of decrease => maximize (-peak_neg_z)
    dec_score = -peak_neg_z
    chosen_dec = choose_top_indices(dec_score, mp_ok, EVENT_REFRACTORY, max_keep=200, descending=True)
    valid_dec = []
    for idx0 in chosen_dec:
        if not ok_video_neg[idx0]:
            continue
        valid_dec.append((idx0, float(t_video_peak_neg[idx0]), float(t_video_event_all[idx0])))
        if len(valid_dec) >= TARGET_CLIPS:
            break
    print(f"[OK] Valid DECREASE clips: n={len(valid_dec)} (target={TARGET_CLIPS})")

    # ----------------------------
    # 7) TOP10 summaries + debug vs manual (increase & decrease)
    # ----------------------------
    def write_top10_tables(valid_list, mode: str):
        summary = []
        debug_rows = []
        for rank, (idx0, tpkv, tev) in enumerate(valid_list, start=1):
            np_index = int(mp_ok_idx[idx0])
            t_medpc = float(mp_ok[idx0])

            # nearest manual anchor distance to event time (not peak time)
            dman = nearest_dist_mean(np.array([tev]), manual_all)

            if mode == "increase":
                zpk = float(peak_pos_z[idx0])
                pkoff = float(peak_pos_off[idx0])
                t_peak = float(t_video_peak_pos[idx0])
            else:
                zpk = float(peak_neg_z[idx0])   # negative
                pkoff = float(peak_neg_off[idx0])
                t_peak = float(t_video_peak_neg[idx0])

            summary.append({
                "rank": rank,
                "mode": mode,
                "nosepoke_index": np_index,
                "t_medpc_s": t_medpc,
                "t_fiber_event_s": float(ev_fiber[idx0]),
                "peak_robust_z": zpk,
                "peak_offset_fiber_s": pkoff,
                "t_video_event_s": float(tev),
                "t_video_peak_s": t_peak,
                "nearest_manual_dt_s": float(dman),
            })

            debug_rows.append({
                "rank": rank,
                "mode": mode,
                "nosepoke_index": np_index,
                "t_video_event_s": float(tev),
                "nearest_manual_dt_s": float(dman),
                "t_video_peak_s": t_peak,
                "peak_offset_fiber_s": pkoff,
                "peak_robust_z": zpk,
                "a_mv": a_mv, "b_mv": b_mv,
                "a_mf": a_mf, "b_mf": b_mf,
                "fiber_fs_hz": float(fs),
                "video_fps": float(fps_v),
                "pb_tau_sec": float(PB_TAU_SEC),
                "medpc_column": colname,
            })

        summary_df = pd.DataFrame(summary)
        debug_df = pd.DataFrame(debug_rows)

        summary_csv = case_root / f"top10_np1_summary_{mode}.csv"
        debug_csv = case_root / f"top10_debug_vs_manual_{mode}.csv"
        summary_df.to_csv(summary_csv, index=False)
        debug_df.to_csv(debug_csv, index=False)
        print(f"[OK] Saved: {summary_csv}")
        print(f"[OK] Saved: {debug_csv}")

    write_top10_tables(valid_inc, "increase")
    write_top10_tables(valid_dec, "decrease")

    # ----------------------------
    # 8) TOP10 peri-event grid plots (increase & decrease)
    # ----------------------------
    def save_grid(valid_list, mode: str):
