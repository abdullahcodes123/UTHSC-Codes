def cluster_events(times: np.ndarray, win: float) -> np.ndarray:
    """
    Collapse event "bounces": keep the first event in each cluster of events
    that fall within win seconds of that first event.
    """
    times = np.sort(times.astype(float))
    out = []
    i = 0
    while i < len(times):
        t0 = float(times[i])
        out.append(t0)
        j = i + 1
        while j < len(times) and float(times[j]) - t0 <= win:
            j += 1
        i = j
    return np.array(out, dtype=float)


def robust_z(trace: np.ndarray, base_mask: np.ndarray) -> np.ndarray:
    """
    Robust Z-score using baseline median and MAD.
      z = (x - median(baseline)) / MAD(baseline)
    MAD = median(|x - median|)
    If MAD==0, return NaNs.
    """
    base = trace[base_mask]
    med = float(np.median(base))
    mad = float(np.median(np.abs(base - med)))
    if mad == 0 or np.isnan(mad):
        return np.full_like(trace, np.nan, dtype=float)
    return (trace - med) / mad


def infer_fiber_cols(df: pd.DataFrame):
    """
    Tries to infer fiber columns for time/signal/control from common names or heuristics.
    """
    cols = list(df.columns)

    def pick(name_list, fallback_idx):
        for n in name_list:
            if n in cols:
                return n
        return cols[fallback_idx] if len(cols) > fallback_idx else cols[0]

    time_cands = [c for c in cols if "time" in c.lower()]
    sig_cands  = [c for c in cols if ("sig" in c.lower()) or ("490" in c.lower())]
    ctl_cands  = [c for c in cols if ("ctl" in c.lower()) or ("control" in c.lower()) or ("405" in c.lower()) or ("iso" in c.lower())]

    time_col = pick(["TimeStamp", "Time(s)"], 0)
    if time_col not in cols and time_cands:
        time_col = time_cands[0]

    sig_col = pick(["Signal"], 1)
    if sig_col not in cols and sig_cands:
        sig_col = sig_cands[0]

    ctl_col = pick(["Control"], 2)
    if ctl_col not in cols and ctl_cands:
        ctl_col = ctl_cands[0]

    return time_col, sig_col, ctl_col


def normalize_to_seconds_by_dt(t: np.ndarray):
    """
    If timestamps are in ms/us, scale to seconds by inspecting dt and value ranges.
    No fixed sampling rate is assumed.

    Returns:
      t_seconds, scale_applied (1.0, 1e-3, 1e-6)
    """
    t = t.astype(float)
    t = t - np.nanmin(t)
    dt = float(np.nanmedian(np.diff(np.sort(t))))
    if dt <= 0 or not np.isfinite(dt):
        return t, 1.0

    fs = 1.0 / dt
    scale = 1.0
    if fs > 50000:            # microseconds-like
        scale = 1e-6
    elif fs > 5000:           # milliseconds-like
        scale = 1e-3
    elif fs < 50 and np.nanmax(t) > 20000:  # huge values but slow dt => ms
        scale = 1e-3

    t2 = (t * scale).astype(float)
    t2 = t2 - float(np.min(t2))
    return t2, scale


def greedy_match_mae(manual: np.ndarray, cand: np.ndarray, tol=3.0):
    """
    Greedy matching from manual anchor times to candidate event times:
      - For each manual time, find closest candidate time within +/-tol seconds.
      - Each candidate can be used at most once (greedy forward).

    Returns:
      (mean_abs_error, misses) or None if no matches.
    """
    cand = np.sort(cand.astype(float))
    i = 0
    errs = []
    misses = 0

    for m in manual:
        while i < len(cand) and cand[i] < (m - tol):
            i += 1
        if i >= len(cand):
            misses += 1
            continue

        idxs = [i]
        if i - 1 >= 0:
            idxs.append(i - 1)
        if i + 1 < len(cand):
            idxs.append(i + 1)
        idxs = sorted(set(idxs))

        diffs = [abs(cand[k] - m) for k in idxs]
        kbest = idxs[int(np.argmin(diffs))]
        err = abs(cand[kbest] - m)

        if err <= tol:
            errs.append(err)
            i = kbest + 1
        else:
            misses += 1

    if len(errs) == 0:
        return None
    return float(np.mean(errs)), int(misses)


def best_affine_medpc_to_video_multi(windows, tol=3.0):
    """
    Estimate MedPC->Video affine map:
      t_video = a_mv * t_medpc + b_mv

    windows: list of dicts:
      {
        "manual": np.array([...])   # manual times in VIDEO seconds
        "mp":     np.array([...])   # MedPC event times in MEDPC seconds (already scaled/clustered)
        "name":   str
      }

    We brute-force a,b around a duration ratio.
    Score:
      sum over windows: (mae_window) + 2*(misses_window)
    Lower is better.
    """
    # require at least one non-empty window
    usable = [w for w in windows if len(w["manual"]) > 0 and len(w["mp"]) > 0]
    if len(usable) == 0:
        raise RuntimeError("No usable MV windows (manual or MedPC windows are empty).")

    dur_man = max([float(w["manual"].max()) for w in usable])
    dur_mp  = max([float(w["mp"].max()) for w in usable])
    if dur_mp <= 0:
        raise RuntimeError("MedPC events look empty/invalid for MV estimation.")

    a0 = dur_man / dur_mp
    a_list = np.arange(max(0.95, a0 - 0.03), min(1.05, a0 + 0.03), 0.0005)
    b_list = np.arange(-300, 300.01, 0.05)

    best = None
    for a in a_list:
        for b in b_list:
            total = 0.0
            per = []
            for w in usable:
                r = greedy_match_mae(w["manual"], a * w["mp"] + b, tol=tol)
                if r is None:
                    mae, miss = 10.0, len(w["manual"])
                else:
                    mae, miss = r
                total += mae + 2.0 * miss
                per.append((w["name"], mae, miss))
            if best is None or total < best["score"]:
                best = {"a": float(a), "b": float(b), "score": float(total), "per": per}

    if best is None:
        raise RuntimeError("Failed to estimate MedPC->Video affine mapping.")
    return best


def auc_trapz(y: np.ndarray, x: np.ndarray, t0: float, t1: float) -> float:
    """
    AUC using trapezoid integration for y(x) between [t0, t1], ignoring non-finite values.
    Works on NumPy versions with or without np.trapezoid.
    """
    m = (x >= t0) & (x <= t1) & np.isfinite(y) & np.isfinite(x)
    if int(np.sum(m)) < 2:
        return float("nan")
    if hasattr(np, "trapezoid"):
        return float(np.trapezoid(y[m], x[m]))
    return float(((y[m][1:] + y[m][:-1]) * 0.5 * np.diff(x[m])).sum())


def nearest_dist_mean(query_times: np.ndarray, ref_times: np.ndarray) -> float:
    """
    For each query time, compute distance to nearest reference time; return mean distance.
    Used for debug vs manual anchors.
    """
    if len(query_times) == 0 or len(ref_times) == 0:
        return float("nan")
    ref = np.sort(ref_times.astype(float))
    qs = query_times.astype(float)
    d = []
    for q in qs:
        j = int(np.searchsorted(ref, q))
        cand = []
        if 0 <= j < len(ref):
            cand.append(abs(ref[j] - q))
        if 0 <= j - 1 < len(ref):
            cand.append(abs(ref[j - 1] - q))
        if 0 <= j + 1 < len(ref):
            cand.append(abs(ref[j + 1] - q))
        d.append(min(cand) if cand else np.nan)
    return float(np.nanmean(np.array(d, float)))


def estimate_video_fps_if_needed(cap: cv2.VideoCapture, fps_meta: float) -> float:
    """
    Use OpenCV metadata if valid; otherwise estimate FPS from CAP_PROP_POS_MSEC.
    """
    if fps_meta is not None and np.isfinite(fps_meta) and fps_meta > 1.0:
        return float(fps_meta)

    # Try to estimate from first ~200 frames timestamps
    ms_list = []
    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
    for _ in range(220):
        ret, _ = cap.read()
        if not ret:
            break
        ms = cap.get(cv2.CAP_PROP_POS_MSEC)
        if np.isfinite(ms) and ms > 0:
            ms_list.append(ms)

    if len(ms_list) < 10:
        print("[WARN] Could not infer FPS. Falling back to 30.")
        return 30.0

    ms_list = np.array(ms_list, float)
    dms = np.diff(ms_list)
    dms = dms[np.isfinite(dms) & (dms > 0)]
    if len(dms) < 5:
        print("[WARN] Could not infer FPS reliably. Falling back to 30.")
        return 30.0

    fps_est = 1000.0 / float(np.median(dms))
    if not np.isfinite(fps_est) or fps_est < 1.0:
        print("[WARN] FPS estimate invalid. Falling back to 30.")
        return 30.0
    return float(fps_est)


def photobleach_correct(sig: np.ndarray, ctl: np.ndarray, fs: float, tau_sec: float):
    """
    Photobleaching/drift correction using EMA trend removal.

    Steps:
      span_samples = tau_sec * fs
      trend_sig = EMA(sig, span_samples)
      trend_ctl = EMA(ctl, span_samples)
      sig_n = sig / trend_sig
      ctl_n = ctl / trend_ctl

    This normalizes each channel by its slow trend, reducing "late-session weaker response"
    purely due to drift/bleach.
    """
    span = int(max(10, round(tau_sec * fs)))
    s = pd.Series(sig)
    c = pd.Series(ctl)
    trend_sig = s.ewm(span=span, adjust=False).mean().to_numpy(dtype=float)
    trend_ctl = c.ewm(span=span, adjust=False).mean().to_numpy(dtype=float)
    eps = 1e-12
    sig_n = sig / (trend_sig + eps)
    ctl_n = ctl / (trend_ctl + eps)
    return sig_n, ctl_n, trend_sig, trend_ctl


# ============================================================
# MF SCORING (video-grounded, supports INCREASE/DECREASE/EITHER)
# ============================================================
def score_medpc_to_fiber_videogrounded(
    a_mf: float, b_mf: float,
    mp_times: np.ndarray,
    t_fiber: np.ndarray, dff: np.ndarray,
    epoch: np.ndarray, base_mask: np.ndarray, search_mask: np.ndarray,
    a_mv: float, b_mv: float, dur_v: float,
    direction: str = "either",   # "increase" | "decrease" | "either"
):
    """
    We evaluate a candidate MedPC->Fiber map:
      t_fiber_event = a_mf * t_medpc + b_mf

    For events that fit in fiber peri window:
      - compute robustZ peri-event
      - within response window [0..3s], get:
          peaks_pos = max(Z), peaks_neg = min(Z)
          and their offsets (time within window)
    Then build a score:

    Core magnitude:
      - "increase": median(peaks_pos)
      - "decrease": median(-peaks_neg)  (positive magnitude)
      - "either":   whichever has larger magnitude

    Video grounding:
      We convert the peak offset to video time:
        t_video_event = a_mv * t_medpc + b_mv
        t_video_peak  = t_video_event + (a_mv/a_mf) * peak_offset_fiber
      Reward alignments that keep many peaks valid for clipping:
        valid_ratio = fraction of peaks where (t_video_peak +/- clip window) stays within video duration

    Final:
      score = core_magnitude + MF_ALPHA_VALID*valid_ratio - MF_B_STABIL*abs(b_mf)

    Returns:
      score, n_good, valid_ratio, med_pos, med_neg
    """
    ev = a_mf * mp_times + b_mf
    ok = (ev - PRE >= t_fiber.min()) & (ev + POST <= t_fiber.max())
    mp_ok = mp_times[ok]
    ev = ev[ok]
    if len(ev) < MF_MIN_EVENTS:
        return -1e9, 0, 0.0, np.nan, np.nan

    tt = epoch[search_mask]
    peaks_pos = []
    peaks_neg = []
    off_pos = []
    off_neg = []

    for e in ev:
        tr = np.interp(e + epoch, t_fiber, dff)
        rz = robust_z(tr, base_mask)
        zz = rz[search_mask]
        if np.all(np.isnan(zz)):
            peaks_pos.append(np.nan); off_pos.append(np.nan)
            peaks_neg.append(np.nan); off_neg.append(np.nan)
            continue
        kmax = int(np.nanargmax(zz))
        kmin = int(np.nanargmin(zz))
        peaks_pos.append(float(zz[kmax])); off_pos.append(float(tt[kmax]))
        peaks_neg.append(float(zz[kmin])); off_neg.append(float(tt[kmin]))

    peaks_pos = np.array(peaks_pos, float)
    peaks_neg = np.array(peaks_neg, float)
    off_pos = np.array(off_pos, float)
    off_neg = np.array(off_neg, float)

    good = np.isfinite(peaks_pos) & np.isfinite(peaks_neg) & np.isfinite(off_pos) & np.isfinite(off_neg)
    if int(good.sum()) < MF_MIN_EVENTS:
        return -1e9, int(good.sum()), 0.0, np.nan, np.nan

    med_pos = float(np.nanmedian(peaks_pos[good]))
    med_neg = float(np.nanmedian(peaks_neg[good]))         # typically negative
    med_neg_mag = float(np.nanmedian((-peaks_neg)[good]))  # positive magnitude

    if direction == "increase":
        off_use = off_pos
        core = med_pos
    elif direction == "decrease":
        off_use = off_neg
        core = med_neg_mag
    else:
        # choose direction with larger typical magnitude
        if np.isfinite(med_pos) and np.isfinite(med_neg_mag) and (med_neg_mag > med_pos):
            off_use = off_neg
            core = med_neg_mag
        else:
            off_use = off_pos
            core = med_pos

    t_video_event = a_mv * mp_ok + b_mv
    t_video_peak = t_video_event + (a_mv / a_mf) * off_use
    valid = (t_video_peak - CLIP_PRE >= 0) & (t_video_peak + CLIP_POST <= dur_v) & good
    valid_ratio = float(np.mean(valid)) if len(valid) else 0.0

    score = float(core + MF_ALPHA_VALID * valid_ratio - MF_B_STABIL * abs(b_mf))
    return score, int(good.sum()), float(valid_ratio), med_pos, med_neg


