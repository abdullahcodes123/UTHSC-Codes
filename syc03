def bootstrap_mv(windows, best_a, best_b, tol, n_boot, seed):
    """
    Bootstrap MV mapping stability by resampling manual anchors WITH replacement within each window.
    We do NOT re-gridsearch full a,b each time (too slow). Instead:
      - keep a fixed candidate neighborhood around best_a, best_b
      - search a small grid around them for each bootstrap sample.

    Outputs:
      DataFrame with columns: a,b,total_score, total_mae_equiv, total_miss, per-window mae/miss
    """
    rng = np.random.default_rng(seed)

    # local small neighborhood around best parameters
    a_list = np.arange(best_a - 0.0025, best_a + 0.0025 + 1e-12, 0.00025)
    b_list = np.arange(best_b - 6.0, best_b + 6.0 + 1e-12, 0.1)

    # only keep usable windows
    usable = [w for w in windows if len(w["manual"]) > 0 and len(w["mp"]) > 0]
    if len(usable) == 0:
        return pd.DataFrame()

    rows = []
    for _ in range(int(n_boot)):
        boot_wins = []
        for w in usable:
            m = w["manual"]
            # resample manual anchors with replacement
            idx = rng.integers(0, len(m), size=len(m))
            boot_manual = m[idx]
            boot_wins.append({"manual": boot_manual, "mp": w["mp"], "name": w["name"]})

        # evaluate local grid around best
        best = None
        for a in a_list:
            for b in b_list:
                total = 0.0
                total_miss = 0
                per = {}
                for w in boot_wins:
                    r = greedy_match_mae(w["manual"], a * w["mp"] + b, tol=tol)
                    if r is None:
                        mae, miss = 10.0, len(w["manual"])
                    else:
                        mae, miss = r
                    total += mae + 2.0 * miss
                    total_miss += miss
                    per[w["name"]] = (mae, miss)
                if best is None or total < best["score"]:
                    best = {"a": float(a), "b": float(b), "score": float(total), "miss": int(total_miss), "per": per}

        row = {"a": best["a"], "b": best["b"], "score": best["score"], "total_miss": best["miss"]}
        # flatten per-window
        for k, (mae, miss) in best["per"].items():
            row[f"mae_{k}"] = mae
            row[f"miss_{k}"] = miss
        rows.append(row)

    return pd.DataFrame(rows)


def bootstrap_mf_score_around_best(
    mp_focus, t, dff, epoch, base_mask, search_mask,
    a_mv, b_mv, dur_v, a_mf_best, b_mf_best,
    n_boot, seed
):
    """
    Bootstrap MF stability by resampling events (mp_focus) with replacement
    and scoring a small b neighborhood around best a_mf and b_mf.

    We DO NOT re-search over a (too slow). We keep a fixed a=a_mf_best
    and let b vary locally to see if best b is stable.

    Returns DataFrame with:
      b_best, score_best, valid_ratio, med_pos, med_neg
    """
    rng = np.random.default_rng(seed)

    b_list = np.arange(b_mf_best - 6.0, b_mf_best + 6.0 + 1e-12, 0.1)
    rows = []

    mp_focus = mp_focus.astype(float)
    if len(mp_focus) < MF_MIN_EVENTS:
        return pd.DataFrame()

    for _ in range(int(n_boot)):
        idx = rng.integers(0, len(mp_focus), size=len(mp_focus))
        mp_bs = mp_focus[idx]

        best = None
        for b in b_list:
            sc, nused, vratio, med_pos, med_neg = score_medpc_to_fiber_videogrounded(
                a_mf_best, float(b),
                mp_bs,
                t, dff,
                epoch, base_mask, search_mask,
                a_mv, b_mv, dur_v,
                direction="either"
            )
            if best is None or sc > best["score"]:
                best = {
                    "b": float(b),
                    "score": float(sc),
                    "nused": int(nused),
                    "valid_ratio": float(vratio),
                    "med_pos": float(med_pos) if np.isfinite(med_pos) else np.nan,
                    "med_neg": float(med_neg) if np.isfinite(med_neg) else np.nan,
                }
        rows.append(best)

    return pd.DataFrame(rows)


def basic_sanity_checks(a_mv, b_mv, a_mf, b_mf, mp_s, t, dur_v):
    """
    Simple automatic checks. Not "tests" in the unit-test sense, but guards.
    Returns dict of check_name -> (pass_bool, message).
    """
    checks = {}

    # MV scale sanity
    if 0.8 <= a_mv <= 1.2:
        checks["mv_scale_reasonable"] = (True, f"a_mv={a_mv:.6f} within [0.8,1.2]")
    else:
        checks["mv_scale_reasonable"] = (False, f"a_mv={a_mv:.6f} outside [0.8,1.2]")

    # MF scale sanity
    if 0.6 <= a_mf <= 1.6:
        checks["mf_scale_reasonable"] = (True, f"a_mf={a_mf:.6f} within [0.6,1.6]")
    else:
        checks["mf_scale_reasonable"] = (False, f"a_mf={a_mf:.6f} outside [0.6,1.6]")

    # fiber range coverage
    ev_fiber = a_mf * mp_s + b_mf
    inside = (ev_fiber >= float(t.min())) & (ev_fiber <= float(t.max()))
    frac_inside = float(np.mean(inside)) if len(ev_fiber) else 0.0
    checks["fiber_coverage"] = (frac_inside > 0.5, f"{frac_inside*100:.1f}% of mapped events inside fiber time range")

    # MV mapped range coverage to video duration (event times, not peak)
    ev_video = a_mv * mp_s + b_mv
    inside_v = (ev_video >= 0.0) & (ev_video <= float(dur_v))
    frac_inside_v = float(np.mean(inside_v)) if len(ev_video) else 0.0
    checks["video_coverage"] = (frac_inside_v > 0.5, f"{frac_inside_v*100:.1f}% of mapped event times inside video duration")

    return checks


