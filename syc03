def parse_mmss_to_seconds(s: str) -> float:
    """
    Parse 'mm.ss' where '.' separates minutes and seconds.
    Example: '12.27' -> 12*60 + 27 = 747 seconds.
    """
    s = s.strip()
    if "." in s:
        mm, ss = s.split(".", 1)
        return int(mm) * 60 + int(ss)
    return float(s)


