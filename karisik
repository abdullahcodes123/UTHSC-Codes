from pathlib import Path
import pandas as pd
import matplotlib.pyplot as plt

def load_behdata(file_path: str) -> pd.DataFrame:
    p = Path(file_path)
    if not p.exists():
        raise FileNotFoundError(f"Dosya bulunamadı: {p}")

    ext = p.suffix.lower()

    # 1) Excel
    if ext in [".xlsx", ".xls"]:
        df = pd.read_excel(p)
        return df

    # 2) Metin tabanlı (CSV/TSV/TXT): delimiter otomatik tahmin
    try:
        df = pd.read_csv(p, sep=None, engine="python")
        return df
    except Exception:
        # 3) Son çare: whitespace ile ayrılmış olabilir
        df = pd.read_csv(p, delim_whitespace=True)
        return df

def normalize_columns(df: pd.DataFrame) -> pd.DataFrame:
    # Kolon isimlerini normalize et (büyük/küçük harf farkı vs.)
    colmap = {c: c.strip().lower() for c in df.columns}
    inv = {v: k for k, v in colmap.items()}

    needed = ["event", "onset", "offset"]
    missing = [c for c in needed if c not in inv]
    if missing:
        raise ValueError(
            f"Gerekli kolon(lar) eksik: {missing}\n"
            f"Bulunan kolonlar: {list(df.columns)}\n"
            f"Beklenen: Event, Onset, Offset (isimler büyük/küçük harfe duyarsız)"
        )

    df2 = df.rename(columns={
        inv["event"]: "Event",
        inv["onset"]: "Onset",
        inv["offset"]: "Offset",
    }).copy()

    # Sayısal tipe çevir
    df2["Onset"] = pd.to_numeric(df2["Onset"], errors="coerce")
    df2["Offset"] = pd.to_numeric(df2["Offset"], errors="coerce")

    # Bozuk satırları at
    df2 = df2.dropna(subset=["Onset", "Offset"]).reset_index(drop=True)

    return df2

def plot_diff_curve(df: pd.DataFrame, output_png: str = "diff_curve.png",
                    x_mode: str = "onset", smooth_window: int = 0):
    """
    x_mode:
      - "onset": x ekseni Onset (zaman)
      - "index": x ekseni satır sırası
    smooth_window:
      - 0: smoothing yok
      - örn 3/5: hareketli ortalama ile yumuşatma
    """
    df = df.copy()
    df["Diff"] = df["Offset"] - df["Onset"]

    # Sırala: zaman akışı mantıklı olsun
    df = df.sort_values("Onset").reset_index(drop=True)

    if smooth_window and smooth_window > 1:
        df["Diff_smooth"] = df["Diff"].rolling(window=smooth_window, center=True, min_periods=1).mean()
        y = df["Diff_smooth"]
        y_label = f"Offset - Onset (smooth={smooth_window})"
    else:
        y = df["Diff"]
        y_label = "Offset - Onset"

    if x_mode == "index":
        x = range(len(df))
        x_label = "Sıra"
    else:
        x = df["Onset"]
        x_label = "Onset"

    plt.figure()
    plt.plot(x, y)
    plt.xlabel(x_label)
    plt.ylabel(y_label)
    plt.title("Onset-Offset Arasındaki Fark (Eğri Grafiği)")
    plt.tight_layout()
    plt.savefig(output_png, dpi=200)
    plt.show()

    return df

if __name__ == "__main__":
    # Buraya dosya yolunu yaz:
    FILE = "/Users/abdullah/Desktop/new_lab/Dr_Brendan/CY-C-6-260122-154438/Data/BehData.csv"   # örn: "BehData.xlsx" / "BehData.csv"
    OUT  = "diff_curve.png"

    df_raw = load_behdata(FILE)
    df = normalize_columns(df_raw)

    # Grafik:
    # x_mode="onset" -> x ekseni zaman (Onset)
    # smooth_window=0 -> smoothing yok (istersen 3 veya 5 yap)
    df_result = plot_diff_curve(df, output_png=OUT, x_mode="onset", smooth_window=0)

    # İstersen farkları dosyaya da yazdır:
    df_result.to_csv("behdata_with_diff.csv", index=False)
    print("Bitti. Çıktılar: diff_curve.png ve behdata_with_diff.csv")
