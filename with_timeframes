# ==== 5) My Additions: Video intervals (multiply by 1.33, gray band, UC label, duration*1.2 vertical) ====
mmss_to_sec <- function(x) {
  # Accepts "m:ss.mmm" or "mm:ss.mmm" or "m:ss" formats
  x <- gsub("\\s+", "", x)
  parts <- strsplit(x, ":")[[1]]
  if (length(parts) != 2) stop(paste("Time format error:", x))
  m <- as.numeric(parts[1])
  s <- as.numeric(parts[2])
  m * 60 + s
}

