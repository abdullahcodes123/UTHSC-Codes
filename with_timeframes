intervals <- intervals_raw %>%
  mutate(
    start_sec = sapply(start, mmss_to_sec),
    end_sec   = sapply(end,   mmss_to_sec),
    # Multiply by 1.33
    start_s   = start_sec * scale_k,
    end_s     = end_sec   * scale_k,
    # duration and duration*1.2
    dur_s     = end_s - start_s,
    dur_1p2   = dur_s * 1.2,
    xmid      = (start_s + end_s) / 2
  )

y_top <- max(SigBySec$Signal, na.rm = TRUE) * 1.05

# --- ONLY CHANGE TO FIX OVERLAP: create staggered y positions for labels ---
intervals <- intervals %>%
  arrange(xmid) %>%
  mutate(
    label_offset = (row_number() %% 4) * 0.04 * y_top,
    y_label_dur  = y_top + label_offset,
    y_label_uc   = y_top + label_offset + 0.04 * y_top
  )

