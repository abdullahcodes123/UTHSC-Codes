def parse_mmss_to_seconds(s: str) -> float:
    s = s.strip()
    if "." in s:
        mm, ss = s.split(".", 1)
        return int(mm)*60 + int(ss)
    return float(s)

manual_0_10 = np.array([parse_mmss_to_seconds(x) for x in manual_0_10_txt], dtype=float)
manual_35_45 = np.array([parse_mmss_to_seconds(x) for x in manual_35_45_txt], dtype=float)

