print(f"[OK] Saved: {summary_csv}")

grid_png = figdir / "top10_peri_event_robustZ_grid.png"
if len(valid) > 0:
    plt.figure(figsize=(18, 6))
    ncols = 5
    nrows = int(np.ceil(len(valid)/ncols))
    for j, (idx0, tpkv, tev) in enumerate(valid, start=1):
        ax = plt.subplot(nrows, ncols, j)
        ax.plot(epoch, rz_trials[idx0], linewidth=1)
        ax.axvline(0, linestyle="--", linewidth=1)
        ax.axvline(peak_off[idx0], linestyle=":", linewidth=1)
        ax.set_title(f"#{j} | Z={peak_z[idx0]:.2f} | NP#{int(mp_ok_idx[idx0])}")
        ax.set_xlabel("Time (s) relative to nosepoke")
        ax.set_ylabel("Robust Z (dF/F)")
        ax.set_xlim(-PRE, POST)
    plt.tight_layout()
    plt.savefig(grid_png, dpi=200)
    plt.close()
print(f"[OK] Saved: {grid_png}")

# =========================
# 8B) ALL EVENTS average peri-event + AUC
# =========================
finite_rows = np.all(np.isfinite(rz_trials), axis=1)
rz_valid = rz_trials[finite_rows]
if rz_valid.shape[0] >= 5:
    mean_rz = np.nanmean(rz_valid, axis=0)
    sem_rz = np.nanstd(rz_valid, axis=0, ddof=1) / np.sqrt(rz_valid.shape[0])

    auc_0_3 = auc_trapz(mean_rz, epoch, 0.0, 3.0)
    auc_0_5 = auc_trapz(mean_rz, epoch, 0.0, 5.0)

    auc_df = pd.DataFrame([{
        "n_events_used": int(rz_valid.shape[0]),
        "AUC_mean_trace_0_3s": auc_0_3,
        "AUC_mean_trace_0_5s": auc_0_5
    }])
    auc_csv = root / "all_events_mean_trace_auc.csv"
    auc_df.to_csv(auc_csv, index=False)
    print(f"[OK] Saved: {auc_csv}")

    avg_png = figdir / "all_events_mean_peri_event_robustZ.png"
    plt.figure(figsize=(10, 5))
    plt.plot(epoch, mean_rz, linewidth=2, label="Mean Robust Z")
    plt.fill_between(epoch, mean_rz - sem_rz, mean_rz + sem_rz, alpha=0.25, label="SEM")
    plt.axvline(0, linestyle="--", linewidth=1)
    plt.xlim(-PRE, POST)
    plt.xlabel("Time (s) relative to nosepoke")
    plt.ylabel("Robust Z (dF/F)")
    plt.title(f"All aligned nosepokes (n={rz_valid.shape[0]}) | AUC(0-3s)={auc_0_3:.3f}, AUC(0-5s)={auc_0_5:.3f}")
    plt.legend()
    plt.tight_layout()
    plt.savefig(avg_png, dpi=200)
    plt.close()
    print(f"[OK] Saved: {avg_png}")
else:
    print("[WARN] Not enough finite peri-event trials for mean/SEM and AUC.")

# =========================
# 9) Write 1..10 clips (exactly 5s before + 5s after)
# =========================
cap = cv2.VideoCapture(str(video_file))
if not cap.isOpened():
    raise RuntimeError("Could not open video file (codec).")

fps_v = cap.get(cv2.CAP_PROP_FPS)
nframes = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
dur_v = nframes / fps_v
W = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
H = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
print(f"[VIDEO] fps={fps_v:.2f} dur≈{dur_v:.1f}s size={W}x{H}")

fourcc = cv2.VideoWriter_fourcc(*"mp4v")

for rank, (idx0, tpkv, tev) in enumerate(valid, start=1):
    start_t = tpkv - CLIP_PRE
    end_t   = tpkv + CLIP_POST

    start_fr = int(round(start_t * fps_v))
    end_fr   = int(round(end_t * fps_v))

    out_clip = viddir / f"{rank}.mp4"
    writer = cv2.VideoWriter(str(out_clip), fourcc, fps_v, (W, H))

    cap.set(cv2.CAP_PROP_POS_FRAMES, start_fr)
    cur = start_fr

    np_index = int(mp_ok_idx[idx0])
    t_medpc = float(mp_ok[idx0])
    zpk = float(peak_z[idx0])
    pkoff = float(peak_off[idx0])
    t_vid_peak = float(tpkv)

    while cur <= end_fr:
        ret, frame = cap.read()
        if not ret:
            break

        line1 = f"Clip {rank} | PeakZ={zpk:.2f} | VideoPeak={t_vid_peak:.2f}s"
        line2 = f"MedPC={t_medpc:.2f}s | NosepokeIndex={np_index} | PeakOffsetFiber={pkoff:.2f}s"

        cv2.putText(frame, line1, (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.8,
                    (255,255,255), 2, cv2.LINE_AA)
        cv2.putText(frame, line2, (20, 75), cv2.FONT_HERSHEY_SIMPLEX, 0.75,
                    (255,255,255), 2, cv2.LINE_AA)

        writer.write(frame)
        cur += 1

    writer.release()
    print(f"[OK] Clip saved: {out_clip} (5s before + 5s after)")

