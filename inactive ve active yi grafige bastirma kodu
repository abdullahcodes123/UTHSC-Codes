# -----------------------------
# 17. Female-only combined active and inactive mean ± SE plot
# -----------------------------
# This plot combines active and inactive licks for females only.
# Active licks are shown with a solid line.
# Inactive licks are shown with a dotted line.
# Active and inactive have different colors.

female_combined_data <- analysis_data %>%
  filter(sex == "Female") %>%
  group_by(rat_day_number, rat_day) %>%
  summarise(
    n_female_rats = n_distinct(aid),
    
    mean_active_licks = mean(sacclick, na.rm = TRUE),
    se_active_licks = sd(sacclick, na.rm = TRUE) / sqrt(sum(!is.na(sacclick))),
    
    mean_inactive_licks = mean(waterlick, na.rm = TRUE),
    se_inactive_licks = sd(waterlick, na.rm = TRUE) / sqrt(sum(!is.na(waterlick))),
    
    .groups = "drop"
  ) %>%
  pivot_longer(
    cols = c(
      mean_active_licks,
      se_active_licks,
      mean_inactive_licks,
      se_inactive_licks
    ),
    names_to = c(".value", "lick_type"),
    names_pattern = "(mean|se)_(active_licks|inactive_licks)"
  ) %>%
  mutate(
    lick_type = case_when(
      lick_type == "active_licks" ~ "Active Licks",
      lick_type == "inactive_licks" ~ "Inactive Licks",
      TRUE ~ lick_type
    ),
    line_type = case_when(
      lick_type == "Active Licks" ~ "Active Licks",
      lick_type == "Inactive Licks" ~ "Inactive Licks",
      TRUE ~ lick_type
    )
  )

female_combined_colors <- c(
  "Active Licks" = "deeppink3",
  "Inactive Licks" = "darkorange2"
)

female_combined_linetypes <- c(
  "Active Licks" = "solid",
  "Inactive Licks" = "dotted"
)

female_active_inactive_combined_plot <- ggplot(
  data = female_combined_data,
  aes(
    x = rat_day,
    y = mean,
    group = lick_type,
    color = lick_type,
    linetype = line_type
  )
) +
  geom_line(linewidth = 1.2) +
  geom_point(size = 3) +
  geom_errorbar(
    aes(
      ymin = mean - se,
      ymax = mean + se
    ),
    width = 0.15,
    linewidth = 0.7
  ) +
  scale_color_manual(values = female_combined_colors) +
  scale_linetype_manual(values = female_combined_linetypes) +
  labs(
    title = "Female Rats: Mean Active and Inactive Licks Across Training Days",
    x = "Rat-Specific Training Day",
    y = "Mean Licks ± SE",
    color = "Lick Type",
    linetype = "Lick Type"
  ) +
  theme_classic(base_size = 14) +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold"),
    axis.title = element_text(face = "bold"),
    legend.title = element_text(face = "bold"),
    legend.position = "right"
  )

