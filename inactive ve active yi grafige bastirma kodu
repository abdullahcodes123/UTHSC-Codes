############################################################
# SANSA 4-Day Rat-Level Analysis
# Active Licks, Inactive Licks, Infusions, and Female Combined Plot
############################################################

# -----------------------------
# 1. Install and load packages
# -----------------------------

required_packages <- c(
  "readxl",
  "dplyr",
  "ggplot2",
  "janitor",
  "stringr",
  "tidyr",
  "lubridate"
)

new_packages <- required_packages[!(required_packages %in% installed.packages()[, "Package"])]

if (length(new_packages) > 0) {
  install.packages(new_packages)
}

library(readxl)
library(dplyr)
library(ggplot2)
library(janitor)
library(stringr)
library(tidyr)
library(lubridate)

# -----------------------------
# 2. Define file path and output folder
# -----------------------------

file_path <- "/Users/abdullah/Desktop/new_lab/SANSA_TEST/4_DAY.xlsx"

output_folder <- "/Users/abdullah/Desktop/new_lab/SANSA_TEST/R_outputs"

if (!dir.exists(output_folder)) {
  dir.create(output_folder, recursive = TRUE)
}

# -----------------------------
# 3. Read Excel file
# -----------------------------
# All columns are read as text to prevent Excel/R date-format problems.

raw_data <- read_excel(
  path = file_path,
  col_types = "text"
)

data <- raw_data %>%
  clean_names()

# -----------------------------
# 4. Check required columns
# -----------------------------

required_columns <- c(
  "zdate",
  "start_time",
  "aid",
  "sacclick",
  "waterlick",
  "infusions",
  "sex"
)

missing_columns <- setdiff(required_columns, names(data))

if (length(missing_columns) > 0) {
  stop(
    paste(
      "The following required columns are missing from the Excel file:",
      paste(missing_columns, collapse = ", ")
    )
  )
}

# -----------------------------
# 5. Clean and prepare data
# -----------------------------

clean_data <- data %>%
  mutate(
    aid = as.character(aid),
    sex = str_to_upper(str_trim(as.character(sex))),
    zdate = str_trim(as.character(zdate)),
    start_time = str_trim(as.character(start_time)),
    
    zdate = mdy(zdate),
    
    sacclick = as.numeric(sacclick),
    waterlick = as.numeric(waterlick),
    infusions = as.numeric(infusions)
  ) %>%
  filter(
    !is.na(aid),
    aid != "",
    !is.na(zdate)
  ) %>%
  arrange(aid, zdate, start_time)

# -----------------------------
# 6. Create rat-specific day order
# -----------------------------
# For each AID:
# All available dates are identified.
# Dates are sorted chronologically.
# The first date becomes Day 1.
# The second date becomes Day 2.
# The third date becomes Day 3, and so on.

day_lookup <- clean_data %>%
  distinct(aid, zdate) %>%
  arrange(aid, zdate) %>%
  group_by(aid) %>%
  mutate(
    rat_day_number = row_number(),
    rat_day = paste0("Day ", rat_day_number)
  ) %>%
  ungroup()

analysis_data <- clean_data %>%
  left_join(day_lookup, by = c("aid", "zdate")) %>%
  mutate(
    rat_day = factor(
      rat_day,
      levels = paste0("Day ", sort(unique(rat_day_number)))
    ),
    sex = case_when(
      sex == "F" ~ "Female",
      sex == "M" ~ "Male",
      TRUE ~ "Unknown"
    )
  )

# -----------------------------
# 7. Save cleaned analysis data
# -----------------------------

write.csv(
  analysis_data,
  file = file.path(output_folder, "cleaned_rat_day_analysis_data.csv"),
  row.names = FALSE
)

# -----------------------------
# 8. Define sex colors
# -----------------------------

sex_colors <- c(
  "Female" = "pink",
  "Male" = "blue",
  "Unknown" = "gray50"
)

# -----------------------------
# 9. Individual rat-level plot function
# -----------------------------

create_rat_plot <- function(data, y_variable, y_label, plot_title, file_name) {
  
  plot <- ggplot(
    data = data,
    aes(
      x = rat_day,
      y = .data[[y_variable]],
      group = aid,
      color = sex
    )
  ) +
    geom_line(alpha = 0.75, linewidth = 0.8) +
    geom_point(size = 3, alpha = 0.9) +
    scale_color_manual(values = sex_colors) +
    labs(
      title = plot_title,
      x = "Rat-Specific Training Day",
      y = y_label,
      color = "Sex"
    ) +
    theme_classic(base_size = 14) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold"),
      axis.title = element_text(face = "bold"),
      legend.title = element_text(face = "bold"),
      legend.position = "right"
    )
  
  print(plot)
  
  ggsave(
    filename = file.path(output_folder, file_name),
    plot = plot,
    width = 8,
    height = 6,
    dpi = 300
  )
  
  return(plot)
}

# -----------------------------
# 10. Active lick plot
# -----------------------------

