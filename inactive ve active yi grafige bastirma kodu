# -----------------------------
# 14. Faceted rat-level plot function
# -----------------------------

create_faceted_rat_plot <- function(data, y_variable, y_label, plot_title, file_name) {
  
  plot <- ggplot(
    data = data,
    aes(
      x = rat_day,
      y = .data[[y_variable]],
      group = aid,
      color = sex
    )
  ) +
    geom_line(linewidth = 0.8) +
    geom_point(size = 2.8) +
    facet_wrap(~ aid, scales = "free_y") +
    scale_color_manual(values = sex_colors) +
    labs(
      title = plot_title,
      x = "Rat-Specific Training Day",
      y = y_label,
      color = "Sex"
    ) +
    theme_classic(base_size = 12) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold"),
      axis.title = element_text(face = "bold"),
      axis.text.x = element_text(angle = 45, hjust = 1),
      strip.text = element_text(face = "bold"),
      legend.position = "bottom"
    )
  
  print(plot)
  
  ggsave(
    filename = file.path(output_folder, file_name),
    plot = plot,
    width = 12,
    height = 8,
    dpi = 300
  )
  
  return(plot)
}

