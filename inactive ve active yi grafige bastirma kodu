# -----------------------------
# 13. Labeled rat-level plot function
# -----------------------------

create_labeled_rat_plot <- function(data, y_variable, y_label, plot_title, file_name) {
  
  plot <- ggplot(
    data = data,
    aes(
      x = rat_day,
      y = .data[[y_variable]],
      group = aid,
      color = sex,
      label = aid
    )
  ) +
    geom_line(alpha = 0.65, linewidth = 0.8) +
    geom_point(size = 3, alpha = 0.9) +
    geom_text(
      size = 2.8,
      vjust = -0.7,
      show.legend = FALSE
    ) +
    scale_color_manual(values = sex_colors) +
    labs(
      title = plot_title,
      x = "Rat-Specific Training Day",
      y = y_label,
      color = "Sex"
    ) +
    theme_classic(base_size = 14) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold"),
      axis.title = element_text(face = "bold"),
      legend.title = element_text(face = "bold"),
      legend.position = "right"
    )
  
  print(plot)
  
  ggsave(
    filename = file.path(output_folder, file_name),
    plot = plot,
    width = 10,
    height = 7,
    dpi = 300
  )
  
  return(plot)
}

