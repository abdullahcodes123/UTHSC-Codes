# -----------------------------
# 15. Summary statistics by day and sex
# -----------------------------

summary_by_day_sex <- analysis_data %>%
  group_by(rat_day_number, rat_day, sex) %>%
  summarise(
    n_rats = n_distinct(aid),
    
    mean_active_licks = mean(sacclick, na.rm = TRUE),
    se_active_licks = sd(sacclick, na.rm = TRUE) / sqrt(sum(!is.na(sacclick))),
    
    mean_inactive_licks = mean(waterlick, na.rm = TRUE),
    se_inactive_licks = sd(waterlick, na.rm = TRUE) / sqrt(sum(!is.na(waterlick))),
    
    mean_infusions = mean(infusions, na.rm = TRUE),
    se_infusions = sd(infusions, na.rm = TRUE) / sqrt(sum(!is.na(infusions))),
    
    .groups = "drop"
  )

write.csv(
  summary_by_day_sex,
  file = file.path(output_folder, "summary_by_day_and_sex.csv"),
  row.names = FALSE
)

# -----------------------------
# 16. Mean ± SE plot function by sex
# -----------------------------

create_summary_plot <- function(summary_data, mean_variable, se_variable, y_label, plot_title, file_name) {
  
  plot <- ggplot(
    data = summary_data,
    aes(
      x = rat_day,
      y = .data[[mean_variable]],
      group = sex,
      color = sex
    )
  ) +
    geom_line(linewidth = 1) +
    geom_point(size = 3) +
    geom_errorbar(
      aes(
        ymin = .data[[mean_variable]] - .data[[se_variable]],
        ymax = .data[[mean_variable]] + .data[[se_variable]]
      ),
      width = 0.15,
      linewidth = 0.7
    ) +
    scale_color_manual(values = sex_colors) +
    labs(
      title = plot_title,
      x = "Rat-Specific Training Day",
      y = y_label,
      color = "Sex"
    ) +
    theme_classic(base_size = 14) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold"),
      axis.title = element_text(face = "bold"),
      legend.title = element_text(face = "bold"),
      legend.position = "right"
    )
  
  print(plot)
  
  ggsave(
    filename = file.path(output_folder, file_name),
    plot = plot,
    width = 8,
    height = 6,
    dpi = 300
  )
  
  return(plot)
}

