def run_ffprobe_frame_pts(video_path: Path) -> Optional[np.ndarray]:
    cmd = [
        "ffprobe", "-v", "error",
        "-select_streams", "v:0",
        "-show_entries", "frame=best_effort_timestamp_time",
        "-of", "json",
        str(video_path),
    ]
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)
        j = json.loads(out)
        frames = j.get("frames", [])
        pts = []
        for fr in frames:
            v = fr.get("best_effort_timestamp_time", None)
            if v is None:
                continue
            try:
                pts.append(float(v))
            except Exception:
                continue
        if len(pts) < 10:
            return None
        pts = np.asarray(pts, dtype=float)
        pts = np.maximum.accumulate(pts)
        pts = pts - float(np.min(pts))
        return pts
    except Exception:
        return None

def get_video_meta(video_path: Path) -> Tuple[int, int, float]:
    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        raise RuntimeError("Could not open video file (codec).")
    W = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    H = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    fps_meta = float(cap.get(cv2.CAP_PROP_FPS)) if np.isfinite(cap.get(cv2.CAP_PROP_FPS)) else float("nan")
    cap.release()
    return W, H, fps_meta

def time_to_frame_idx(t_frame_s: np.ndarray, t_s: float) -> int:
    """Nearest frame index for a given time on a monotonic frame timeline."""
    if not np.isfinite(t_s):
        return 0
    t_s = float(t_s)
    if t_s <= float(t_frame_s[0]):
        return 0
    if t_s >= float(t_frame_s[-1]):
        return int(len(t_frame_s) - 1)
    j = int(np.searchsorted(t_frame_s, t_s, side="left"))
    if j <= 0:
        return 0
    if j >= len(t_frame_s):
        return int(len(t_frame_s) - 1)
    return j if abs(float(t_frame_s[j]) - t_s) < abs(float(t_frame_s[j - 1]) - t_s) else (j - 1)

# =============================================================================
# BEHDATA: parse frame index from Event like Cam11, Cam12, Cam111 ...
# =============================================================================
def parse_cam_event_to_frame(ev: str) -> Optional[int]:
    """
    Assumption:
      Cam11 is 1st frame, Cam12 is 2nd frame, Cam111 is 11th frame ...
      So 'Cam' + '1' + frameIndex.
    """
    if ev is None:
        return None
    ev = str(ev).strip()
    m = re.search(r"(\d+)$", ev)
    if not m:
        return None
    digits = m.group(1)
    if len(digits) >= 2 and digits[0] == "1":
        try:
            return int(digits[1:])
        except Exception:
            return None
    try:
        return int(digits)
    except Exception:
        return None

def load_behdata_real_timeline(csv_path: Path) -> Tuple[np.ndarray, np.ndarray]:
    """
    Returns:
      frame_no_sorted (frame numbers parsed from Event, usually 1-based-ish)
      real_onset_sorted (seconds, re-zeroed)
    """
    df = pd.read_csv(csv_path)
    if "Event" not in df.columns or "Onset" not in df.columns:
        raise KeyError("BehData.csv must contain columns: Event, Onset (and optionally Offset).")

    ev = df["Event"].astype(str).to_numpy()
    onset = pd.to_numeric(df["Onset"], errors="coerce").to_numpy(dtype=float)

    frame_no = np.array([parse_cam_event_to_frame(x) for x in ev], dtype=float)
    good = np.isfinite(onset) & np.isfinite(frame_no) & (frame_no >= 1)
    if good.sum() < 10:
        raise RuntimeError("BehData parsing failed: too few valid rows. Check Event/Onset format.")

    frame_no = frame_no[good].astype(int)
    onset = onset[good].astype(float)

    order = np.argsort(frame_no)
    frame_no = frame_no[order]
    onset = onset[order]

    onset = np.maximum.accumulate(onset)
    onset = onset - float(np.min(onset))  # re-zero real timeline at 0
    return frame_no, onset

# =============================================================================
# Mapping: displayed video time <-> real video time
# =============================================================================
class VideoTimeWarp:
    def __init__(self, t_disp: np.ndarray, t_real: np.ndarray):
        self.t_disp = np.asarray(t_disp, float)
        self.t_real = np.asarray(t_real, float)
        n = min(len(self.t_disp), len(self.t_real))
        if n < 10:
            raise RuntimeError("VideoTimeWarp needs >=10 frames.")
        self.t_disp = self.t_disp[:n]
        self.t_real = self.t_real[:n]
        self.t_disp = np.maximum.accumulate(self.t_disp)
        self.t_real = np.maximum.accumulate(self.t_real)

    def disp_to_frame(self, t_disp_s: float) -> int:
        return time_to_frame_idx(self.t_disp, float(t_disp_s))

    def disp_to_real(self, t_disp_s: float) -> float:
        j = self.disp_to_frame(t_disp_s)
        return float(self.t_real[j])

    def real_to_frame(self, t_real_s: float) -> int:
        return time_to_frame_idx(self.t_real, float(t_real_s))

    def real_to_disp(self, t_real_s: float) -> float:
        j = self.real_to_frame(t_real_s)
        return float(self.t_disp[j])

# =============================================================================
# FEATURE: MedPC noise penalty
# =============================================================================
def medpc_noise_penalty(mapped_times: np.ndarray) -> np.ndarray:
    x = np.asarray(mapped_times, float)
    if x.size == 0:
        return np.array([], dtype=float)
    gap_prev = np.r_[np.inf, np.diff(x)]
    gap_next = np.r_[np.diff(x), np.inf]
    g = np.minimum(gap_prev, gap_next)
    tau = 1.0
    pen = np.exp(-np.clip(g, 0.0, 10.0) / tau)
    pen = (pen - pen.min()) / (pen.max() - pen.min() + 1e-12)
    return pen

# =============================================================================
# DP alignment
# =============================================================================
def dp_align_featured(
    manual: np.ndarray,
    mapped: np.ndarray,
    noise_pen: np.ndarray,
    tol: float,
    skip_manual_pen: float,
    skip_medpc_pen: float,
    lambda_noise: float,
):
    m = np.sort(np.asarray(manual, float))
    c = np.sort(np.asarray(mapped, float))
    pn = np.asarray(noise_pen, float)
    if len(pn) != len(c):
        pn = np.zeros_like(c)

    M, N = m.size, c.size
    if M == 0:
        return {"cost": 0.0, "pairs": [], "miss_manual": 0, "matches": 0}
    if N == 0:
        return {"cost": float(M) * skip_manual_pen, "pairs": [], "miss_manual": int(M), "matches": 0}

    INF = 1e18
    dp = np.full((M + 1, N + 1), INF, dtype=float)
    bt = np.full((M + 1, N + 1), -1, dtype=int)  # 0 skip medpc, 1 skip manual, 2 match
    dp[0, 0] = 0.0

    for i in range(1, M + 1):
        dp[i, 0] = dp[i - 1, 0] + skip_manual_pen
        bt[i, 0] = 1
    for j in range(1, N + 1):
        dp[0, j] = dp[0, j - 1] + skip_medpc_pen
        bt[0, j] = 0

    for i in range(1, M + 1):
        mi = float(m[i - 1])
        for j in range(1, N + 1):
            cj = float(c[j - 1])

            best_cost = dp[i, j - 1] + skip_medpc_pen
            best_step = 0

            costB = dp[i - 1, j] + skip_manual_pen
            if costB < best_cost:
                best_cost = costB
                best_step = 1

            e = abs(mi - cj)
            if e <= float(tol):
                costC = dp[i - 1, j - 1] + e + lambda_noise * float(pn[j - 1])
                if costC < best_cost:
                    best_cost = costC
                    best_step = 2

            dp[i, j] = best_cost
            bt[i, j] = best_step

    pairs = []
    i, j = M, N
    miss_manual = 0
    while i > 0 or j > 0:
        step = bt[i, j]
        if step == 0:
            j -= 1
        elif step == 1:
            miss_manual += 1
            i -= 1
        elif step == 2:
            pairs.append((i - 1, j - 1, abs(float(m[i - 1]) - float(c[j - 1]))))
            i -= 1
            j -= 1
        else:
            break
    pairs.reverse()
    return {"cost": float(dp[M, N]), "pairs": pairs, "miss_manual": int(miss_manual), "matches": int(len(pairs))}

# =============================================================================
# Coarse affine search
# =============================================================================
def coarse_affine_search(
    manual: np.ndarray,
    mp: np.ndarray,
    a_center: float,
    a_range: float,
    a_step: float,
    b_min: float,
    b_max: float,
    b_step: float,
    tol: float,
    skip_manual_pen: float,
    skip_medpc_pen: float,
    lambda_noise: float,
):
    manual = np.sort(np.asarray(manual, float))
    mp = np.sort(np.asarray(mp, float))
    if manual.size == 0 or mp.size == 0:
        raise RuntimeError("coarse_affine_search needs non-empty manual and mp.")

    a_list = np.arange(a_center - a_range, a_center + a_range + 1e-12, a_step)
    b_list = np.arange(b_min, b_max + 1e-12, b_step)

    best = None
    total = int(len(a_list) * len(b_list))
    p = tqdm(total=total, desc="[ALIGN] Coarse affine grid", unit="comb", leave=True, mininterval=0.2) if tqdm else None

    for a in a_list:
        for b in b_list:
            mapped = a * mp + b
            pn = medpc_noise_penalty(mapped)
            out = dp_align_featured(
                manual=manual,
                mapped=mapped,
                noise_pen=pn,
                tol=tol,
                skip_manual_pen=skip_manual_pen,
                skip_medpc_pen=skip_medpc_pen,
                lambda_noise=lambda_noise,
            )
            score = out["cost"] / max(1, len(manual))
            if best is None or score < best["score"]:
                best = {"a": float(a), "b": float(b), "score": float(score), "matches": out["matches"], "miss_manual": out["miss_manual"]}
            if p is not None:
                p.update(1)

    if p is not None:
        p.close()
    return best

def refit_affine_ridge(
    mp_times: np.ndarray,
    manual_times: np.ndarray,
    pairs: List[Tuple[int, int, float]],
    b_prior: float,
    ridge_a_to_1_weight: float,
    ridge_b_to_prior_weight: float,
):
    if len(pairs) < 3:
        return None

    mp = np.asarray(mp_times, float)
    m = np.asarray(manual_times, float)

    xs = []
    ys = []
    for (i_m, j_c, _) in pairs:
        xs.append(float(mp[j_c]))
        ys.append(float(m[i_m]))
    x = np.asarray(xs, float)
    y = np.asarray(ys, float)

    A = np.c_[x, np.ones_like(x)]
    t = y.copy()

    # weights are human scale (e.g., 0.03, 0.001)
    ra = math.sqrt(float(max(0.0, ridge_a_to_1_weight)))
    rb = math.sqrt(float(max(0.0, ridge_b_to_prior_weight)))

    A_aug = np.vstack([A, [ra, 0.0], [0.0, rb]])
    t_aug = np.concatenate([t, [ra * 1.0, rb * float(b_prior)]])

    sol, *_ = np.linalg.lstsq(A_aug, t_aug, rcond=None)
    return float(sol[0]), float(sol[1]), len(pairs)

def pairs_to_df(manual_times, mp_times, a, b, pairs):
    rows = []
    mapped = a * mp_times + b
    pn = medpc_noise_penalty(mapped)
    for (i_m, j_c, err) in pairs:
        rows.append({
            "manual_i": int(i_m),
            "manual_t_master_s": float(manual_times[i_m]),
            "medpc_j": int(j_c),
            "medpc_t_raw_s": float(mp_times[j_c]),
            "mapped_t_master_s": float(mapped[j_c]),
            "abs_err_s": float(err),
            "noise_pen": float(pn[j_c]),
        })
    return pd.DataFrame(rows)

