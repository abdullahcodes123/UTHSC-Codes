# 16) WRITE CLIPS (MASTER(real) time -> frame idx via BehData -> seek in video)
# =============================================================================
def write_increase_clips_behdata(valid_list, out_dir: Path):
    if USE_FAKE_VIDEO:
        print("[FAKE VIDEO] skipping clip writing")
        return

    cap = cv2.VideoCapture(str(video_file))
    if not cap.isOpened():
        raise RuntimeError("Could not open video file (codec).")

    fps_out = float(fps_meta) if np.isfinite(fps_meta) and fps_meta > 1 else 20.0
    fourcc = cv2.VideoWriter_fourcc(*"mp4v")

    clip_iter = _pbar(list(enumerate(valid_list, start=1)), desc="[VIDEO] Writing clips (behdata warp)", unit="clip", leave=True)

    for rank, (idx0, tpk_master, tev_master) in clip_iter:
        start_t = float(tpk_master - CLIP_PRE)
        end_t   = float(tpk_master + CLIP_POST)

        start_fr_trim = time_to_frame_idx(t_real, start_t)
        end_fr_trim   = time_to_frame_idx(t_real, end_t)

        start_fr_trim = max(0, min(int(start_fr_trim), int(len(t_real) - 1)))
        end_fr_trim   = max(0, min(int(end_fr_trim), int(len(t_real) - 1)))
        if end_fr_trim < start_fr_trim:
            start_fr_trim, end_fr_trim = end_fr_trim, start_fr_trim

        start_fr = int(start_frame_offset + start_fr_trim)
        end_fr   = int(start_frame_offset + end_fr_trim)

        out_clip = out_dir / f"{rank}.mp4"
        writer = cv2.VideoWriter(str(out_clip), fourcc, fps_out, (W, H))

        cap.set(cv2.CAP_PROP_POS_FRAMES, int(start_fr))
        cur = int(start_fr)

        np_index = int(mp_ok_idx2[idx0])
        t_medpc_raw = float(mp_ok2[idx0])
        zpk = float(peak_z[idx0])
        pkoff = float(peak_off[idx0])

        disp_peak = float(master_to_displayed_sec(tpk_master))
        disp_event = float(master_to_displayed_sec(tev_master))

        frames_to_write = int(end_fr - start_fr + 1)
        p = tqdm(total=frames_to_write, desc=f"  clip {rank} frames", unit="fr", leave=False, mininterval=0.3) if tqdm else None

        while cur <= int(end_fr):
            ret, frame = cap.read()
            if not ret:
                break

            line1 = f"{MEDPC_COL} | INCREASE | Clip {rank} | PeakZ={zpk:.2f}"
            line2 = f"PeakT REAL(master)={tpk_master:.2f}s ({sec_to_mmss_mmm(tpk_master)}) | DISPLAYED={disp_peak:.2f}s ({sec_to_mmss_mmm(disp_peak)})"
            line3 = f"EventT REAL(master)={tev_master:.2f}s ({sec_to_mmss_mmm(tev_master)}) | DISPLAYED={disp_event:.2f}s ({sec_to_mmss_mmm(disp_event)})"
            line4 = f"MedPCraw={t_medpc_raw:.2f}s | NP#{np_index} | PeakOff={pkoff:.2f}s | trim={TRIM_START_SEC:.1f}s | a={a1:.6f} b={b1:.2f}"

            cv2.putText(frame, line1, (20, 40),  cv2.FONT_HERSHEY_SIMPLEX, 0.70, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line2, (20, 72),  cv2.FONT_HERSHEY_SIMPLEX, 0.60, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line3, (20, 104), cv2.FONT_HERSHEY_SIMPLEX, 0.60, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(frame, line4, (20, 136), cv2.FONT_HERSHEY_SIMPLEX, 0.58, (255, 255, 255), 2, cv2.LINE_AA)

            writer.write(frame)
            cur += 1
            if p is not None:
                p.update(1)

        if p is not None:
            p.close()
        writer.release()
        print(f"[OK] Clip saved: {out_clip} (master-real {start_t:.3f}..{end_t:.3f}s) frames {start_fr}..{end_fr}")

    cap.release()

write_increase_clips_behdata(valid, viddir)

