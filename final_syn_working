def parse_mmss_msec_to_seconds(s: str) -> float:
    """
    Accepts:
      mm:ss.mmm
      m:ss
      mm:ss
      tolerant to spaces
    """
    s = str(s).strip().replace(" ", "")
    m = re.match(r"^(\d+):(\d+(?:\.\d+)?)$", s)
    if m:
        mm = int(m.group(1))
        ss = float(m.group(2))
        return mm * 60.0 + ss
    # fallback: "mm.ss" style
    if "." in s:
        parts = s.split(".", 1)
        if len(parts) == 2 and parts[0].isdigit():
            return int(parts[0]) * 60.0 + float(parts[1])
    return float(s)

def sec_to_mmss_mmm(t: float) -> str:
    if not np.isfinite(t):
        return "nan"
    t = float(t)
    if t < 0:
        sign = "-"
        t = -t
    else:
        sign = ""
    mm = int(t // 60.0)
    ss = t - 60.0 * mm
    return f"{sign}{mm}:{ss:06.3f}"  # mm:ss.mmm

def apply_trim_rezero(times_s: np.ndarray, trim_s: float) -> np.ndarray:
    x = np.asarray(times_s, float) - float(trim_s)
    x = x[np.isfinite(x)]
    return np.sort(x[x >= 0.0])

def cluster_events(times_s: np.ndarray, win_s: float) -> np.ndarray:
    x = np.sort(np.asarray(times_s, float))
    if x.size == 0:
        return x
    out = [float(x[0])]
    last = float(x[0])
    for t in x[1:]:
        t = float(t)
        if t - last > float(win_s):
            out.append(t)
            last = t
    return np.array(out, dtype=float)

