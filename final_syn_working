def nearest_manual_info(manual_master_arr: np.ndarray, t_master: float) -> Tuple[int, float, float]:
    """
    Returns (manual_index, manual_time, abs_diff_sec).
    manual_index is 0-based.
    """
    if manual_master_arr.size == 0 or not np.isfinite(t_master):
        return -1, float("nan"), float("nan")
    diffs = np.abs(manual_master_arr - float(t_master))
    k = int(np.argmin(diffs))
    return k, float(manual_master_arr[k]), float(diffs[k])

def label_distance(d: float, near_sec: float, mid_sec: float) -> str:
    if not np.isfinite(d):
        return "NA"
    if d <= near_sec:
        return "NEAR"
    if d <= mid_sec:
        return "MID"
    return "FAR"

def master_to_displayed_sec(t_master: float) -> float:
    """
    MASTER time is REAL video time after trimming and re-zero.
    We map MASTER -> frame (in trimmed arrays) -> displayed PTS in seconds.
    """
    if not np.isfinite(t_master):
        return float("nan")
    j = time_to_frame_idx(t_real, float(t_master))
    return float(t_disp[j])

