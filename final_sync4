def _run_ffprobe_frame_pts(video_path: Path) -> Optional[np.ndarray]:
    cmd = [
        "ffprobe", "-v", "error",
        "-select_streams", "v:0",
        "-show_entries", "frame=best_effort_timestamp_time",
        "-of", "json",
        str(video_path),
    ]
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)
        j = json.loads(out)
        frames = j.get("frames", [])
        pts = []
        for fr in frames:
            v = fr.get("best_effort_timestamp_time", None)
            if v is None:
                continue
            try:
                pts.append(float(v))
            except Exception:
                continue
        if len(pts) < 10:
            return None
        pts = np.asarray(pts, dtype=float)
        pts = np.maximum.accumulate(pts)
        pts = pts - float(np.min(pts))
        return pts
    except Exception:
        return None

def _scan_cv2_pos_msec(video_path: Path, max_frames: Optional[int] = None) -> Tuple[np.ndarray, int, int, float]:
    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        raise RuntimeError("Could not open video file (codec).")

    W = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    H = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    fps_meta = float(cap.get(cv2.CAP_PROP_FPS)) if np.isfinite(cap.get(cv2.CAP_PROP_FPS)) else float("nan")

    frame_count = cap.get(cv2.CAP_PROP_FRAME_COUNT)
    total_est = None
    if np.isfinite(frame_count) and frame_count > 0:
        total_est = int(frame_count)
        if max_frames is not None:
            total_est = min(total_est, int(max_frames))

    t_ms = []
    n = 0
    it = _pbar(total=total_est, desc="[VIDEO] OpenCV timestamp scan", unit="fr", leave=True)
    while True:
        ret, _ = cap.read()
        if not ret:
            break
        ms = cap.get(cv2.CAP_PROP_POS_MSEC)
        if not np.isfinite(ms):
            ms = np.nan
        t_ms.append(ms)
        n += 1
        if tqdm is not None:
            it.update(1)
        if max_frames is not None and n >= int(max_frames):
            break
    if tqdm is not None:
        it.close()
    cap.release()

    t_ms = np.asarray(t_ms, dtype=float)
    good = np.isfinite(t_ms)
    if good.sum() < 10:
        raise RuntimeError("OpenCV timestamp scan failed (too few finite CAP_PROP_POS_MSEC values).")

    idx = np.arange(len(t_ms))
    t_ms2 = t_ms.copy()
    if not np.all(good):
        t_ms2[~good] = np.interp(idx[~good], idx[good], t_ms2[good])

    t_ms2 = np.maximum.accumulate(t_ms2)
    t_sec = (t_ms2 - float(np.min(t_ms2))) / 1000.0
    return t_sec, W, H, fps_meta

def build_video_timeline_full(video_path: Path) -> dict:
    if tqdm is not None:
        print("[VIDEO] Building VFR-safe timeline (ffprobe preferred)...")

    pts = _run_ffprobe_frame_pts(video_path)
    if pts is not None:
        cap = cv2.VideoCapture(str(video_path))
        if not cap.isOpened():
            raise RuntimeError("Could not open video file (codec).")
        W = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        H = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        fps_meta = float(cap.get(cv2.CAP_PROP_FPS)) if np.isfinite(cap.get(cv2.CAP_PROP_FPS)) else float("nan")
        cap.release()
        t_frame_full = pts
        src = "ffprobe"
    else:
        if tqdm is not None:
            print("[VIDEO] ffprobe failed -> fallback OpenCV scan (slow)...")
        t_frame_full, W, H, fps_meta = _scan_cv2_pos_msec(video_path)
        src = "opencv_pos_msec"

    d = np.diff(t_frame_full)
    d = d[np.isfinite(d) & (d > 0)]
    fps_nom = float(1.0 / np.median(d)) if len(d) >= 5 else (float(fps_meta) if np.isfinite(fps_meta) and fps_meta > 1 else 30.0)
    dur_full = float(t_frame_full[-1]) if len(t_frame_full) else float("nan")

    d_all = np.diff(t_frame_full)
    d_pos = d_all[np.isfinite(d_all) & (d_all > 0)]
    if len(d_pos) >= 5:
        q = np.quantile(d_pos, [0.01, 0.5, 0.99])
        vfr_ratio = float(q[2] / q[0]) if q[0] > 0 else float("inf")
        vfr_report = {
            "source": src,
            "n_frames": int(len(t_frame_full)),
            "dur_s_by_pts": float(dur_full),
            "fps_nominal_median": float(fps_nom),
            "dt_q01_s": float(q[0]),
            "dt_q50_s": float(q[1]),
            "dt_q99_s": float(q[2]),
            "vfr_ratio_q99_over_q01": float(vfr_ratio),
            "plateau_frames": int(np.sum(d_all <= 1e-6)),
        }
    else:
        vfr_report = {"source": src, "n_frames": int(len(t_frame_full)), "dur_s_by_pts": float(dur_full), "fps_nominal_median": float(fps_nom)}

    return {
        "t_frame_full_s": t_frame_full,
        "W": W,
        "H": H,
        "fps_nominal": fps_nom,
        "dur_full_s": dur_full,
        "vfr_report": vfr_report,
    }

def time_to_frame_idx(t_frame_s: np.ndarray, t_s: float) -> int:
    if not np.isfinite(t_s):
        return 0
    t_s = float(t_s)
    if t_s <= float(t_frame_s[0]):
        return 0
    if t_s >= float(t_frame_s[-1]):
        return int(len(t_frame_s) - 1)
    j = int(np.searchsorted(t_frame_s, t_s, side="left"))
    if j <= 0:
        return 0
    if j >= len(t_frame_s):
        return int(len(t_frame_s) - 1)
    return j if abs(float(t_frame_s[j]) - t_s) < abs(float(t_frame_s[j - 1]) - t_s) else (j - 1)

# =============================================================================
# FEATURE: MedPC "noise" penalty (moderate)
# - penalize events that have very small local inter-event gaps (bursty)
# =============================================================================
def medpc_noise_penalty(mapped_times: np.ndarray) -> np.ndarray:
    x = np.asarray(mapped_times, float)
    n = len(x)
    if n == 0:
        return np.array([], dtype=float)
    # local min gap
    gap_prev = np.r_[np.inf, np.diff(x)]
    gap_next = np.r_[np.diff(x), np.inf]
    g = np.minimum(gap_prev, gap_next)
    # penalty in [0..~1], small gaps => higher penalty
    tau = 1.0  # 1 sec scale
    pen = np.exp(-np.clip(g, 0.0, 10.0) / tau)
    # normalize to [0..1]
    pen = (pen - pen.min()) / (pen.max() - pen.min() + 1e-12)
    return pen

# =============================================================================
# DP ALIGNMENT (manual anchors vs mapped medpc events)
# - monotonic, skip allowed
# - match cost includes abs time error + lambda_noise * noise_penalty(j)
# =============================================================================
def dp_align_featured(
    manual: np.ndarray,
    mapped: np.ndarray,
    noise_pen: np.ndarray,
    tol: float,
    skip_manual_pen: float,
    skip_medpc_pen: float,
    lambda_noise: float,
):
    m = np.sort(np.asarray(manual, float))
    c = np.sort(np.asarray(mapped, float))
    pn = np.asarray(noise_pen, float)
    if len(pn) != len(c):
        pn = np.zeros_like(c)

    M, N = m.size, c.size
    if M == 0:
        return {"cost": 0.0, "pairs": [], "miss_manual": 0, "matches": 0}
    if N == 0:
        return {"cost": float(M) * skip_manual_pen, "pairs": [], "miss_manual": int(M), "matches": 0}

    INF = 1e18
    dp = np.full((M + 1, N + 1), INF, dtype=float)
    bt = np.full((M + 1, N + 1), -1, dtype=int)  # 0 skip medpc, 1 skip manual, 2 match
    dp[0, 0] = 0.0

    # init borders
    for i in range(1, M + 1):
        dp[i, 0] = dp[i - 1, 0] + skip_manual_pen
        bt[i, 0] = 1
    for j in range(1, N + 1):
        dp[0, j] = dp[0, j - 1] + skip_medpc_pen
        bt[0, j] = 0

    for i in range(1, M + 1):
        mi = float(m[i - 1])
        for j in range(1, N + 1):
            cj = float(c[j - 1])

            # A) skip medpc
            best_cost = dp[i, j - 1] + skip_medpc_pen
            best_step = 0

            # B) skip manual
            costB = dp[i - 1, j] + skip_manual_pen
            if costB < best_cost:
                best_cost = costB
                best_step = 1

            # C) match (only if within tol corridor)
            e = abs(mi - cj)
            if e <= float(tol):
                costC = dp[i - 1, j - 1] + e + lambda_noise * float(pn[j - 1])
                if costC < best_cost:
                    best_cost = costC
                    best_step = 2

            dp[i, j] = best_cost
            bt[i, j] = best_step

    # backtrack
    pairs = []
    i, j = M, N
    miss_manual = 0
    while i > 0 or j > 0:
        step = bt[i, j]
        if step == 0:
            j -= 1
        elif step == 1:
            miss_manual += 1
            i -= 1
        elif step == 2:
            pairs.append((i - 1, j - 1, abs(float(m[i - 1]) - float(c[j - 1]))))
            i -= 1
            j -= 1
        else:
            # should not happen
            break
    pairs.reverse()
    return {"cost": float(dp[M, N]), "pairs": pairs, "miss_manual": int(miss_manual), "matches": int(len(pairs))}

# =============================================================================
# COARSE AFFINE SEARCH (grid) using featured DP score across windows
# =============================================================================
def coarse_affine_search(
    windows: List[Dict],
    a_pad: float,
    a_step: float,
    b_min: float,
    b_max: float,
    b_step: float,
    tol: float,
):
    usable = [w for w in windows if (len(w["manual"]) > 0 and len(w["mp"]) > 0)]
    if len(usable) == 0:
        raise RuntimeError("No usable windows for coarse affine search.")

    a_list = np.arange(1.0 - a_pad, 1.0 + a_pad + 1e-12, a_step)
    b_list = np.arange(b_min, b_max + 1e-12, b_step)

    best = None
    total_comb = int(len(a_list) * len(b_list))
    p = tqdm(total=total_comb, desc="[ALIGN] Coarse affine grid", unit="comb", leave=True, mininterval=0.2) if tqdm else None

    for a in a_list:
        for b in b_list:
            tot = 0.0
            per = {}
            for w in usable:
                mapped = a * w["mp"] + b
                pn = medpc_noise_penalty(mapped)
                out = dp_align_featured(
                    manual=w["manual"],
                    mapped=mapped,
                    noise_pen=pn,
                    tol=tol,
                    skip_manual_pen=SKIP_MANUAL_PEN,
                    skip_medpc_pen=SKIP_MEDPC_PEN,
                    lambda_noise=LAMBDA_NOISE,
                )
                # normalize a bit by manual count
                denom = max(1, len(w["manual"]))
                score_w = out["cost"] / denom
                tot += score_w
                per[w["name"]] = {"score": float(score_w), "matches": out["matches"], "miss_manual": out["miss_manual"]}

            if best is None or tot < best["score"]:
                best = {"a": float(a), "b": float(b), "score": float(tot), "per": per}

            if p is not None:
                p.update(1)
    if p is not None:
        p.close()
    return best

# =============================================================================
# BUILD CANDIDATE "MATRIX" (anchor x candidates)
# - practical: we save a long table of candidate rows
# =============================================================================
def build_candidate_table(
    manual_times: np.ndarray,
    mp_times: np.ndarray,
    a: float,
    b: float,
    corridor: float,
) -> Tuple[pd.DataFrame, np.ndarray, np.ndarray]:
    """
    Returns:
      cand_df: rows = (anchor_i, medpc_j) that are within corridor of mapped time.
      mapped_times: a*mp + b (sorted mp assumed)
      noise_pen: per medpc event
    """
    m = np.asarray(manual_times, float)
    mp = np.asarray(mp_times, float)
    mapped = a * mp + b
    pn = medpc_noise_penalty(mapped)

    rows = []
    # Use sorted mp, so we can two-pointer window each anchor
    j0 = 0
    n = len(mp)
    for i, mi in enumerate(m):
        left = mi - corridor
        right = mi + corridor
        # advance j0
        while j0 < n and mapped[j0] < left:
            j0 += 1
        j = j0
        while j < n and mapped[j] <= right:
            rows.append({
                "manual_i": int(i),
                "manual_t": float(mi),
                "medpc_j": int(j),
                "medpc_t": float(mp[j]),
                "mapped_t": float(mapped[j]),
                "abs_err": float(abs(mi - mapped[j])),
                "noise_pen": float(pn[j]),
            })
            j += 1

    cand_df = pd.DataFrame(rows)
    # Rank candidates per anchor by abs_err (closest first)
    if len(cand_df):
        cand_df["cand_rank"] = cand_df.groupby("manual_i")["abs_err"].rank(method="first")
        cand_df = cand_df.sort_values(["manual_i", "cand_rank", "abs_err"]).reset_index(drop=True)
    return cand_df, mapped, pn

# =============================================================================
# REFIT AFFINE FROM MATCHED PAIRS (moderate regularization)
# =============================================================================
def refit_affine_ridge(
    mp_times: np.ndarray,
    manual_times: np.ndarray,
    pairs: List[Tuple[int, int, float]],
    b_prior: float,
):
    """
    Fit manual_i_time ≈ a * mp_j_time + b
    Using matched pairs from DP.
    Mild ridge:
      - (a - 1)^2 weighted
      - (b - b_prior)^2 weighted
    """
    if len(pairs) < 3:
        return None

    mp = np.asarray(mp_times, float)
    m = np.asarray(manual_times, float)

    xs = []
    ys = []
    for (i_m, j_c, _) in pairs:
        xs.append(float(mp[j_c]))
        ys.append(float(m[i_m]))
    x = np.asarray(xs, float)
    y = np.asarray(ys, float)

    # Solve ridge-regularized normal equations for [a,b]
    # minimize ||y - a x - b||^2 + RIDGE_A*(a-1)^2 + RIDGE_B*(b-bprior)^2
    # Convert to augmented least squares:
    # add row sqrt(RIDGE_A) * [1,0] target sqrt(RIDGE_A)*1
    # add row sqrt(RIDGE_B) * [0,1] target sqrt(RIDGE_B)*bprior
    A = np.c_[x, np.ones_like(x)]
    t = y.copy()

    ra = math.sqrt(float(RIDGE_A_TO_1))
    rb = math.sqrt(float(RIDGE_B_TO_PRIOR))
    A_aug = np.vstack([A, [ra, 0.0], [0.0, rb]])
    t_aug = np.concatenate([t, [ra * 1.0, rb * float(b_prior)]])

    # Least squares
    sol, *_ = np.linalg.lstsq(A_aug, t_aug, rcond=None)
    a_hat, b_hat = float(sol[0]), float(sol[1])
    return a_hat, b_hat, len(pairs)

