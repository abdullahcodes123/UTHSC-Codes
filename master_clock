def pbar(step: int, total: int, msg: str) -> None:
    width = 28
    step = max(0, min(step, total))
    filled = int(round(width * step / max(1, total)))
    bar = "█" * filled + "·" * (width - filled)
    print(f"[{bar}] {step:>2}/{total:<2}  {msg}")

def safe_run(cmd: List[str]) -> Tuple[int, str, str]:
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return p.returncode, p.stdout, p.stderr


# ============================================================
# Time / stats helpers
# ============================================================
def parse_hhmmss_to_seconds(hhmmss: str) -> int:
    m = re.fullmatch(r"\s*(\d{1,2}):(\d{2}):(\d{2})\s*", hhmmss)
    if not m:
        raise ValueError(f"Bad clock string: {hhmmss!r} (expected HH:MM:SS)")
    h, mi, s = map(int, m.groups())
    return h * 3600 + mi * 60 + s

def clock_offset_seconds(medpc_start: str, fiber_video_start: str) -> float:
    medpc = parse_hhmmss_to_seconds(medpc_start)
    fv = parse_hhmmss_to_seconds(fiber_video_start)
    return float(medpc - fv)

def ensure_monotonic_increasing(t: np.ndarray, name: str) -> None:
    if np.any(np.diff(t) < 0):
        raise ValueError(f"{name} must be monotonic nondecreasing.")

def robust_median_mad(x: np.ndarray) -> Tuple[float, float]:
    med = float(np.nanmedian(x))
    mad = float(np.nanmedian(np.abs(x - med)))
    if mad <= 1e-12:
        mad = 1e-12
    return med, mad

def ema_trend(x: np.ndarray, alpha: float) -> np.ndarray:
    y = np.empty_like(x, dtype=float)
    prev = float(x[0])
    y[0] = prev
    for i in range(1, len(x)):
        prev = alpha * float(x[i]) + (1 - alpha) * prev
        y[i] = prev
    return y

def linear_fit_affine(x: np.ndarray, y: np.ndarray) -> Tuple[float, float]:
    x = np.asarray(x, float)
    y = np.asarray(y, float)
    A = np.vstack([x, np.ones_like(x)]).T
    a, b = np.linalg.lstsq(A, y, rcond=None)[0]
    return float(a), float(b)

def detect_time_unit_and_to_seconds(t: np.ndarray) -> np.ndarray:
    t = np.asarray(t, float)
    mx = float(np.nanmax(t))
    if mx > 1e7:   # likely microseconds
        return t / 1e6
    if mx > 1e4:   # likely milliseconds
        return t / 1e3
    return t


