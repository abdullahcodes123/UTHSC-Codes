# Fiber pipeline (MASTER-aligned)
# ============================================================
def prepare_fiber_master(fiber_csv: Path, trim_start_sec: float) -> pd.DataFrame:
    df = pd.read_csv(fiber_csv)
    cols = {c.lower(): c for c in df.columns}

    # time column
    time_candidates = [k for k in cols if k in ("time", "timestamp", "t", "seconds", "sec", "ms", "us")]
    if not time_candidates:
        for k in cols:
            if "time" in k or "stamp" in k:
                time_candidates.append(k)
                break
    if not time_candidates:
        raise ValueError("Fiber CSV: could not find a time column (need 'time'/'timestamp'-like).")
    tcol = cols[time_candidates[0]]

    # signal/control columns
    sig_candidates = [k for k in cols if k in ("signal", "gcamp", "green", "sig")]
    ctrl_candidates = [k for k in cols if k in ("control", "isosbestic", "uv", "violet", "ctrl")]

    if sig_candidates:
        sig_col = cols[sig_candidates[0]]
    else:
        numeric_cols = [c for c in df.columns if c != tcol and pd.api.types.is_numeric_dtype(df[c])]
        if not numeric_cols:
            raise ValueError("Fiber CSV: need at least one numeric signal column.")
        sig_col = numeric_cols[0]

    ctrl_col = cols[ctrl_candidates[0]] if ctrl_candidates else None

    t_sec = detect_time_unit_and_to_seconds(df[tcol].to_numpy())
    trim = float(trim_start_sec)
    t_master = t_sec - trim
    mask = t_master >= 0
    t_master = t_master[mask]
    sig = df.loc[mask, sig_col].to_numpy(dtype=float)
    ctrl = df.loc[mask, ctrl_col].to_numpy(dtype=float) if ctrl_col is not None else None

    if len(t_master) < 10:
        raise ValueError("Fiber CSV too short after trim.")

    dt = float(np.nanmedian(np.diff(t_master)))
    tau = 60.0
    alpha = min(1.0, max(0.001, dt / tau))

    sig_tr = ema_trend(sig, alpha=alpha)
    sig_detr = sig - sig_tr

    if ctrl is not None:
        ctrl_tr = ema_trend(ctrl, alpha=alpha)
        ctrl_detr = ctrl - ctrl_tr

        sig_norm = (sig_detr - np.nanmedian(sig_detr)) / (np.nanstd(sig_detr) + 1e-12)
        ctrl_norm = (ctrl_detr - np.nanmedian(ctrl_detr)) / (np.nanstd(ctrl_detr) + 1e-12)

        ra, rb = linear_fit_affine(ctrl_norm, sig_norm)
        sig_corr = sig_norm - (ra * ctrl_norm + rb)

        base = float(np.nanmedian(sig_corr))
        df_over_f = (sig_corr - base) / (abs(base) + 1e-12)
    else:
        sig_corr = (sig_detr - np.nanmedian(sig_detr)) / (np.nanstd(sig_detr) + 1e-12)
        base = float(np.nanmedian(sig_corr))
        df_over_f = (sig_corr - base) / (abs(base) + 1e-12)

    out = pd.DataFrame({
        "t_master_sec": t_master,
        "sig_corr": sig_corr,
        "df_over_f": df_over_f,
    })

    try:
        out.to_parquet(out_dir / "fiber_master.parquet", index=False)
    except Exception:
        out.to_csv(out_dir / "fiber_master.csv", index=False)

    return out


