def print_nearest_candidates(
    label: str,
    anchors: np.ndarray,
    t_medpc: np.ndarray,
    a: float,
    b: float,
    topk: int = 3
) -> None:
    """
    For each manual anchor time (MASTER), list top-k nearest MedPC events (after mapping to MASTER).
    """
    t_medpc_master = a * t_medpc + b
    print(f"\n[NEAREST] {label}")
    for at in anchors:
        err = np.abs(t_medpc_master - float(at))
        idxs = np.argsort(err)[:topk]
        parts = []
        for j in idxs:
            parts.append(f"{t_medpc_master[j]:9.3f}s err={err[j]:6.3f}")
        print(f"  manual {float(at):7.3f}s -> " + " | ".join(parts))

def print_nearest_windows(
    anchors_all: np.ndarray,
    t_medpc: np.ndarray,
    a: float,
    b: float
) -> None:
    """
    A simple windowing similar to your example:
      - first 10 anchors
      - middle block (next 5)
      - last block (rest)
    """
    n = len(anchors_all)
    a0 = anchors_all[:min(10, n)]
    amid = anchors_all[min(10, n):min(15, n)]
    aend = anchors_all[min(15, n):]

    if len(a0):
        print_nearest_candidates("w0_10", a0, t_medpc, a, b, topk=3)
    if len(amid):
        print_nearest_candidates("wmid", amid, t_medpc, a, b, topk=3)
    if len(aend):
        print_nearest_candidates("w35_45", aend, t_medpc, a, b, topk=3)


# ============================================================
# Leave-one-anchor-out selection
# ============================================================
@dataclass
class AnchorScenario:
    drop_index: Optional[int]   # None means drop nothing
    kept_anchors: np.ndarray
    pairs: List[Tuple[int, int]]
    a: float
    b: float
    score: float
    median_abs_err: float
    rmse: float
    n_matches: int

def score_solution(
    t_medpc: np.ndarray,
    anchors: np.ndarray,
    pairs: List[Tuple[int, int]],
    a: float,
    b: float,
    penalty_fewer: float
) -> Tuple[float, float, float]:
    """
    Score uses robust median abs error + RMSE + penalty for fewer matches.
    Lower is better.
    """
    if len(pairs) == 0:
        return 1e18, 1e18, 1e18

    abs_errs = []
    for (ai, mj) in pairs:
        pred = a * float(t_medpc[mj]) + b
        abs_errs.append(abs(pred - float(anchors[ai])))
    abs_errs = np.array(abs_errs, dtype=float)

    med = float(np.median(abs_errs))
    rmse = float(np.sqrt(np.mean(abs_errs**2)))

    frac = len(pairs) / max(1, len(anchors))
    penalty = penalty_fewer * (1.0 - frac)

    score = med + 0.25 * rmse + penalty
    return score, med, rmse

def choose_best_anchor_scenario(
    t_medpc: np.ndarray,
    anchors_all: np.ndarray,
    initial_a: float,
    initial_b: float,
    max_abs_err: float,
    max_interval_rel_err: float,
    allow_drop_none: bool,
    penalty_fewer: float
) -> AnchorScenario:
    scenarios: List[AnchorScenario] = []

    drop_options: List[Optional[int]] = [None] if allow_drop_none else []
    drop_options += list(range(len(anchors_all)))

    for d in drop_options:
        if d is None:
            anchors = anchors_all.copy()
        else:
            anchors = np.delete(anchors_all, d)

        pairs = dp_match_monotonic(
            t_medpc=t_medpc,
            t_anchor_master=anchors,
            initial_a=initial_a,
            initial_b=initial_b,
            max_abs_err=max_abs_err,
            max_interval_rel_err=max_interval_rel_err
        )

        if len(pairs) < 2:
            # unusable
            scenarios.append(AnchorScenario(
                drop_index=d, kept_anchors=anchors, pairs=pairs,
                a=np.nan, b=np.nan, score=1e18,
                median_abs_err=1e18, rmse=1e18, n_matches=len(pairs)
            ))
            continue

        a_fit, b_fit = fit_medpc_to_master_affine(t_medpc, anchors, pairs)
        sc, med, rmse = score_solution(t_medpc, anchors, pairs, a_fit, b_fit, penalty_fewer)

        scenarios.append(AnchorScenario(
            drop_index=d, kept_anchors=anchors, pairs=pairs,
            a=a_fit, b=b_fit, score=sc,
            median_abs_err=med, rmse=rmse, n_matches=len(pairs)
        ))

    # pick best
    scenarios.sort(key=lambda s: s.score)
    return scenarios[0]


# ============================================================
# Peri-event analysis
# ============================================================
def extract_peri_event(
    fiber_df: pd.DataFrame,
    event_t: float,
    pre: float,
    post: float
) -> Optional[Tuple[np.ndarray, np.ndarray]]:
    t = fiber_df["t_master_sec"].to_numpy(dtype=float)
    y = fiber_df["df_over_f"].to_numpy(dtype=float)

    t0 = event_t - pre
    t1 = event_t + post
    if t0 < float(t[0]) or t1 > float(t[-1]):
        return None

    dt = float(np.nanmedian(np.diff(t)))
    if not np.isfinite(dt) or dt <= 0:
        return None

    grid = np.arange(-pre, post + 1e-9, dt, dtype=float)
    target = event_t + grid
    y_i = np.interp(target, t, y)
    return grid, y_i

def robust_zscore_trace(grid: np.ndarray, trace: np.ndarray, baseline_win_sec: float) -> np.ndarray:
    mask = (grid >= -baseline_win_sec) & (grid < 0)
    if not np.any(mask):
        med, mad = robust_median_mad(trace)
    else:
        med, mad = robust_median_mad(trace[mask])
    scale = 1.4826 * mad
    if scale <= 1e-12:
        scale = 1e-12
    return (trace - med) / scale

def auc_trapz(x: np.ndarray, y: np.ndarray, t0: float = 0.0, t1: Optional[float] = None) -> Tuple[float, float]:
    if t1 is None:
        t1 = float(x[-1])
    m = (x >= t0) & (x <= t1)
    if not np.any(m):
        return 0.0, 0.0
    xx = x[m]
    yy = y[m]
    net = float(np.trapz(yy, xx))
    pos = float(np.trapz(np.maximum(yy, 0.0), xx))
    return net, pos


# ============================================================
# Video clip extraction (time-based)
# ============================================================
def write_video_clip_vfr_safe(
    video_path: Path,
    t_center_master: float,
    pre: float,
    post: float,
    out_path: Path,
    overlay_text: Optional[str] = None
) -> None:
    if shutil.which("ffmpeg") is None:
        raise RuntimeError("ffmpeg not found in PATH.")

    trim_start = float(TRIM_START_SEC)
    t0_m = max(0.0, t_center_master - pre)
    t1_m = t_center_master + post

    ss = trim_start + t0_m
    to = trim_start + t1_m

    if overlay_text:
        txt = overlay_text.replace(":", "\\:").replace("'", "\\'")
        vf = f"drawtext=text='{txt}':x=20:y=20:fontsize=24:box=1"
        cmd = ["ffmpeg", "-y", "-ss", f"{ss:.3f}", "-to", f"{to:.3f}", "-i", str(video_path),
               "-vf", vf, "-c:a", "copy", str(out_path)]
    else:
        cmd = ["ffmpeg", "-y", "-ss", f"{ss:.3f}", "-to", f"{to:.3f}", "-i", str(video_path),
               "-c", "copy", str(out_path)]

    rc, _, err = safe_run(cmd)
    if rc != 0:
        # fallback: re-encode
        cmd2 = ["ffmpeg", "-y", "-ss", f"{ss:.3f}", "-to", f"{to:.3f}", "-i", str(video_path),
                "-c:v", "libx264", "-crf", "18", "-preset", "veryfast", "-c:a", "aac", "-b:a", "128k",
                str(out_path)]
        rc2, _, err2 = safe_run(cmd2)
        if rc2 != 0:
            raise RuntimeError(f"ffmpeg clip failed:\n{err}\n---\n{err2}")


# ============================================================
# MAIN
# ============================================================
def main() -> None:
    random.seed(RANDOM_SEED)
    np.random.seed(RANDOM_SEED)

    total_steps = 8
    step = 0

    step += 1; pbar(step, total_steps, "Video timeline (VFR-safe PTS)")
    video_tl = build_video_timeline_master(video_file, TRIM_START_SEC)
    pts_master = video_tl["pts_master_sec"]
    master_start_idx = int(video_tl["master_start_idx"][0])

    step += 1; pbar(step, total_steps, "Fiber preprocessing -> MASTER")
    fiber_df = prepare_fiber_master(fiber_file, TRIM_START_SEC)

    step += 1; pbar(step, total_steps, "Load MedPC events (+ self_administrator)")
    medpc_df, t_medpc_sec, self_admin_value = load_medpc_events(beh_file)

    # Initial wall-clock prior
    off = clock_offset_seconds(MEDPC_START_CLOCK, FIBER_VIDEO_START_CLOCK)
    initial_a = 1.0
    initial_b = -off  # if MedPC started 56s earlier => b=+56 so MedPC 56s maps near MASTER 0

    print("\n=== INITIAL PRIOR (from wall clocks) ===")
    print(f"clock_offset_sec (MedPC - Fiber/Video) = {off:.3f} sec")
    print(f"initial mapping: MASTER ≈ {initial_a:.6f} * MedPC + {initial_b:.6f}")

    # Show nearest table under prior (quick sanity)
    print_nearest_windows(MANUAL_VIDEO_ANCHORS_MASTER_SEC, t_medpc_sec, initial_a, initial_b)

    # Choose best LOO scenario (drop none or drop exactly one anchor)
    step += 1; pbar(step, total_steps, "Anchor matching: monotonic DP + affine (with leave-one-out)")
    if LOO_ENABLE:
        best = choose_best_anchor_scenario(
            t_medpc=t_medpc_sec,
            anchors_all=MANUAL_VIDEO_ANCHORS_MASTER_SEC,
            initial_a=initial_a,
            initial_b=initial_b,
            max_abs_err=MAX_ABS_TIME_ERR_SEC,
            max_interval_rel_err=MAX_INTERVAL_REL_ERR,
            allow_drop_none=LOO_ALLOW_DROP_NONE,
            penalty_fewer=LOO_PENALTY_FOR_FEWER_MATCHES
        )
        dropped = best.drop_index
        kept_anchors = best.kept_anchors
        pairs = best.pairs
        a_fit, b_fit = best.a, best.b
    else:
        dropped = None
        kept_anchors = MANUAL_VIDEO_ANCHORS_MASTER_SEC.copy()
        pairs = dp_match_monotonic(
            t_medpc=t_medpc_sec,
            t_anchor_master=kept_anchors,
            initial_a=initial_a,
            initial_b=initial_b,
            max_abs_err=MAX_ABS_TIME_ERR_SEC,
            max_interval_rel_err=MAX_INTERVAL_REL_ERR
        )
        if len(pairs) < 2:
            raise RuntimeError(f"Matching failed: only {len(pairs)} matches found.")
        a_fit, b_fit = fit_medpc_to_master_affine(t_medpc_sec, kept_anchors, pairs)

    # Print decision
    print("\n=== MATCHING DECISION ===")
    if dropped is None:
        print("Dropped anchor: NONE (kept all manual anchors)")
    else:
        print(f"Dropped anchor index: {dropped}  (manual time={MANUAL_VIDEO_ANCHORS_MASTER_SEC[dropped]:.3f}s)")
    print(f"Affine fit: MASTER ≈ {a_fit:.9f} * MedPC + {b_fit:.9f}")
    print(f"Matches used: {len(pairs)} / {len(kept_anchors)}")

    # Show nearest table under fitted mapping (your requested style)
    print_nearest_windows(kept_anchors, t_medpc_sec, a_fit, b_fit)

    # Build match report (which MedPC event matched which manual anchor)
    match_rows = []
    for (ai, mj) in pairs:
        anchor_t = float(kept_anchors[ai])
        med_t = float(t_medpc_sec[mj])
        pred = a_fit * med_t + b_fit
        match_rows.append({
            "anchor_index_within_kept": int(ai),
            "anchor_master_sec": anchor_t,
            "medpc_index_sorted": int(mj),
            "medpc_time_sec": med_t,
            "pred_master_sec": float(pred),
            "abs_err_sec": float(abs(pred - anchor_t)),
            "self_administrator": self_admin_value,
            "medpc_orig_row_index": int(medpc_df.loc[mj, "orig_row_index"]),
        })
    match_report = pd.DataFrame(match_rows)
    match_report.to_csv(out_dir / "alignment_report.csv", index=False)

    # Apply affine to ALL MedPC events -> MASTER
    t_medpc_master = a_fit * t_medpc_sec + b_fit
    medpc_df_out = medpc_df.copy()
    medpc_df_out["medpc_time_sec"] = t_medpc_sec
    medpc_df_out["master_time_sec"] = t_medpc_master
    medpc_df_out.to_csv(out_dir / "medpc_events_master.csv", index=False)

    # Peri-event analysis for all events
    step += 1; pbar(step, total_steps, "Peri-event extraction (robust Z), refractory filtering")
    grids = None
    traces = []
    valid = []

    order = np.argsort(t_medpc_master)
    t_sorted = t_medpc_master[order]
    idx_sorted = order

    last_kept = -1e18
    for k, ev_t in zip(idx_sorted, t_sorted):
        if float(ev_t) - last_kept < REFRACTORY_SEC:
            continue
        pe = extract_peri_event(fiber_df, float(ev_t), PRE_SEC, POST_SEC)
        if pe is None:
            continue
        grid, tr = pe
        z = robust_zscore_trace(grid, tr, BASELINE_WIN_SEC)
        if grids is None:
            grids = grid
        traces.append(z)
        valid.append((int(k), float(ev_t)))
        last_kept = float(ev_t)

    if grids is None or len(traces) == 0:
        raise RuntimeError("No valid peri-event windows found.")

    Z = np.vstack(traces)
    post_mask = grids >= 0
    peak_z = np.max(Z[:, post_mask], axis=1)
    sort_by_peak = np.argsort(-peak_z)

    # Select top clips
    step += 1; pbar(step, total_steps, "Select top events + write clips (time-based, VFR-safe)")
    top_n = min(TARGET_CLIPS, len(valid))
    selected = sort_by_peak[:top_n]

    clip_rows = []
    for rank, si in enumerate(selected, start=1):
        medpc_idx, ev_t = valid[int(si)]
        pz = float(peak_z[int(si)])

        clip_name = f"clip_rank{rank:03d}_medpcIdx{medpc_idx}_t{ev_t:.3f}_pz{pz:.2f}.mp4"
        out_path = clips_dir / clip_name
        overlay = f"rank={rank}  medpcIdx={medpc_idx}  tMASTER={ev_t:.2f}s  peakZ={pz:.2f}"

        try:
            write_video_clip_vfr_safe(
                video_path=video_file,
                t_center_master=ev_t,
                pre=CLIP_PRE_SEC,
                post=CLIP_POST_SEC,
                out_path=out_path,
                overlay_text=overlay
            )
            ok = True
            note = "OK"
        except Exception as e:
            ok = False
            note = f"FAILED: {e}"

        clip_rows.append({
            "rank": rank,
            "medpc_index_sorted": medpc_idx,
            "master_time_sec": ev_t,
            "peak_z": pz,
            "clip_path": str(out_path) if ok else "",
            "note": note,
        })

    pd.DataFrame(clip_rows).to_csv(out_dir / "selected_clips_manifest.csv", index=False)

    # Average trace, SEM, AUC
    step += 1; pbar(step, total_steps, "Compute mean/SEM/AUC + save summary")
    mean_trace = np.nanmean(Z, axis=0)
    sem_trace = np.nanstd(Z, axis=0, ddof=1) / math.sqrt(Z.shape[0])
    net_auc, pos_auc = auc_trapz(grids, mean_trace, t0=0.0, t1=POST_SEC)

    np.savez(
        out_dir / "peri_event_summary.npz",
        t_rel=grids,
        Z=Z,
        peak_z=peak_z,
        mean_trace=mean_trace,
        sem_trace=sem_trace,
        net_auc=net_auc,
        pos_auc=pos_auc,
        a_fit=a_fit,
        b_fit=b_fit,
        clock_offset_sec=off,
        dropped_anchor_index=(-1 if dropped is None else int(dropped)),
        dropped_anchor_time=(None if dropped is None else float(MANUAL_VIDEO_ANCHORS_MASTER_SEC[dropped])),
        n_matches=len(pairs),
        matches=np.array(pairs, dtype=int),
    )

    # Bootstrap (a,b) stability
    step += 1; pbar(step, total_steps, "Bootstrap (a,b) stability")
    boots = []
    if len(pairs) >= 4:
        rng = np.random.default_rng(RANDOM_SEED)
        matched_anchor_idx = np.array([ai for ai, _ in pairs], dtype=int)
        matched_med_idx = np.array([mj for _, mj in pairs], dtype=int)

        for _ in range(BOOTSTRAP_N):
            m = len(pairs)
            take = max(2, int(round(BOOTSTRAP_FRAC * m)))
            pick = rng.choice(np.arange(m), size=take, replace=True)
            x = t_medpc_sec[matched_med_idx[pick]]
            y = kept_anchors[matched_anchor_idx[pick]]
            aa, bb = linear_fit_affine(x, y)
            boots.append((aa, bb))

        boots = np.array(boots, dtype=float)
        pd.DataFrame({"a": boots[:, 0], "b": boots[:, 1]}).to_csv(out_dir / "bootstrap_affine_ab.csv", index=False)

    # Meta
    meta = {
        "paths": {
            "beh_file": str(beh_file),
            "fiber_file": str(fiber_file),
            "video_file": str(video_file),
            "out_dir": str(out_dir),
        },
        "clocks": {
            "MEDPC_START_CLOCK": MEDPC_START_CLOCK,
            "FIBER_VIDEO_START_CLOCK": FIBER_VIDEO_START_CLOCK,
            "clock_offset_sec_medpc_minus_fv": off,
            "initial_mapping_master_eq": {"a": initial_a, "b": initial_b},
            "fit_mapping_master_eq": {"a": a_fit, "b": b_fit},
        },
        "anchors": {
            "n_manual_anchors_total": int(len(MANUAL_VIDEO_ANCHORS_MASTER_SEC)),
            "dropped_anchor_index": (None if dropped is None else int(dropped)),
            "dropped_anchor_time": (None if dropped is None else float(MANUAL_VIDEO_ANCHORS_MASTER_SEC[dropped])),
            "n_kept_anchors": int(len(kept_anchors)),
        },
        "matching": {
            "n_matches": int(len(pairs)),
            "MAX_ABS_TIME_ERR_SEC": MAX_ABS_TIME_ERR_SEC,
            "MAX_INTERVAL_REL_ERR": MAX_INTERVAL_REL_ERR,
            "LOO_ENABLE": LOO_ENABLE,
            "LOO_ALLOW_DROP_NONE": LOO_ALLOW_DROP_NONE,
            "LOO_PENALTY_FOR_FEWER_MATCHES": LOO_PENALTY_FOR_FEWER_MATCHES,
        },
        "peri_event": {
            "PRE_SEC": PRE_SEC,
            "POST_SEC": POST_SEC,
            "BASELINE_WIN_SEC": BASELINE_WIN_SEC,
            "REFRACTORY_SEC": REFRACTORY_SEC,
            "n_valid_events": int(len(valid)),
            "net_auc": float(net_auc),
            "pos_auc": float(pos_auc),
        },
        "self_administrator": self_admin_value,
    }
    (out_dir / "run_meta.json").write_text(json.dumps(meta, indent=2))

    # Final small screen summary (you asked to print some results)
    step += 1; pbar(step, total_steps, "Done")
    print("\n=== QUICK SUMMARY ===")
    print(f"self_administrator: {self_admin_value}")
    print(f"Affine: MASTER ≈ {a_fit:.9f} * MedPC + {b_fit:.9f}")
    if dropped is None:
        print("Dropped anchor: NONE")
    else:
        print(f"Dropped anchor: idx={dropped}, t={MANUAL_VIDEO_ANCHORS_MASTER_SEC[dropped]:.3f}s")
    print(f"Matches: {len(pairs)}")
    print(f"Valid peri-events: {len(valid)}")
    print(f"Mean-trace net AUC (0..{POST_SEC}s): {net_auc:.4f}")
    print(f"Mean-trace pos AUC (0..{POST_SEC}s): {pos_auc:.4f}")

    print("\nFILES:")
    print(f"- {out_dir / 'alignment_report.csv'}")
    print(f"- {out_dir / 'medpc_events_master.csv'}")
    print(f"- {out_dir / 'selected_clips_manifest.csv'}")
    print(f"- {out_dir / 'run_meta.json'}")
    if (out_dir / 'bootstrap_affine_ab.csv').exists():
        print(f"- {out_dir / 'bootstrap_affine_ab.csv'}")


if __name__ == "__main__":
    main()
