# Video VFR-safe frame timeline
# ============================================================
def get_video_pts_ffprobe(video_path: Path) -> Optional[np.ndarray]:
    if shutil.which("ffprobe") is None:
        return None
    cmd = [
        "ffprobe", "-v", "error",
        "-select_streams", "v:0",
        "-show_entries", "frame=pkt_pts_time,best_effort_timestamp_time",
        "-of", "json",
        str(video_path)
    ]
    rc, out, _ = safe_run(cmd)
    if rc != 0 or not out.strip():
        return None
    try:
        data = json.loads(out)
        frames = data.get("frames", [])
        pts = []
        for fr in frames:
            v = fr.get("best_effort_timestamp_time", None)
            if v is None:
                v = fr.get("pkt_pts_time", None)
            pts.append(np.nan if v is None else float(v))
        pts = np.asarray(pts, dtype=float)
        pts = pts[~np.isnan(pts)]
        if len(pts) < 10:
            return None
        pts = pts - pts[0]
        if np.any(np.diff(pts) < -1e-6):
            return None
        return pts
    except Exception:
        return None

def get_video_pts_opencv(video_path: Path) -> np.ndarray:
    if cv2 is None:
        raise RuntimeError("OpenCV not available and ffprobe failed. Install cv2 or ensure ffprobe exists.")
    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        raise RuntimeError(f"Could not open video: {video_path}")
    pts_sec = []
    while True:
        ok, _ = cap.read()
        if not ok:
            break
        ms = cap.get(cv2.CAP_PROP_POS_MSEC)
        pts_sec.append(float(ms) / 1000.0)
    cap.release()
    pts = np.asarray(pts_sec, dtype=float)
    if len(pts) < 10:
        raise RuntimeError("OpenCV timeline too short or failed.")
    pts = pts - pts[0]
    pts = np.maximum.accumulate(pts)
    return pts

def build_video_timeline_master(video_path: Path, trim_start_sec: float) -> Dict[str, np.ndarray]:
    pts = get_video_pts_ffprobe(video_path)
    method = "ffprobe_pts"
    if pts is None:
        pts = get_video_pts_opencv(video_path)
        method = "opencv_pos_msec"

    ensure_monotonic_increasing(pts, "video pts")

    trim = float(trim_start_sec)
    if trim < 0:
        raise ValueError("TRIM_START_SEC must be >= 0")

    start_idx = int(np.searchsorted(pts, trim, side="left"))
    if start_idx >= len(pts) - 1:
        raise ValueError("Trim is beyond video length.")

    pts_master = pts[start_idx:] - pts[start_idx]

    (out_dir / "video_timeline_meta.json").write_text(json.dumps({
        "video": str(video_path),
        "method": method,
        "n_frames": int(len(pts)),
        "trim_start_sec": trim,
        "master_start_frame_index": start_idx,
        "duration_orig_sec": float(pts[-1]),
        "duration_master_sec": float(pts_master[-1]),
    }, indent=2))

    return {
        "pts_orig_sec": pts,
        "pts_master_sec": pts_master,
        "master_start_idx": np.array([start_idx], dtype=int),
        "method": np.array([0], dtype=int),
    }

def master_time_to_master_frame_idx(pts_master_sec: np.ndarray, t_master: float) -> int:
    i = int(np.searchsorted(pts_master_sec, t_master, side="left"))
    if i <= 0:
        return 0
    if i >= len(pts_master_sec):
        return len(pts_master_sec) - 1
    if abs(float(pts_master_sec[i]) - t_master) < abs(float(pts_master_sec[i-1]) - t_master):
        return i
    return i - 1


