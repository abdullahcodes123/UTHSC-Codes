def load_medpc_events(beh_csv: Path) -> Tuple[pd.DataFrame, np.ndarray, str]:
    df = pd.read_csv(beh_csv)

    # self_administrator
    sa_col = None
    for c in df.columns:
        if c.strip().lower() == "self_administrator":
            sa_col = c
            break
    if sa_col is None:
        for c in df.columns:
            if "self" in c.lower() and "admin" in c.lower():
                sa_col = c
                break

    self_admin_value = ""
    if sa_col is not None and len(df) > 0:
        s = df[sa_col].dropna()
        if len(s) > 0:
            self_admin_value = str(s.iloc[0])

    # time/event column
    candidates = []
    for c in df.columns:
        cl = c.lower()
        if cl in ("time", "timestamp", "event_time", "eventtime", "t", "sec", "seconds", "ms", "millis"):
            if pd.api.types.is_numeric_dtype(df[c]):
                candidates.append(c)
    if not candidates:
        for c in df.columns:
            if ("time" in c.lower() or "stamp" in c.lower()) and pd.api.types.is_numeric_dtype(df[c]):
                candidates.append(c)
                break
    if not candidates:
        num_cols = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])]
        if not num_cols:
            raise ValueError("MedPC CSV: could not find numeric time/event column.")
        candidates = [num_cols[0]]

    tcol = candidates[0]
    t_raw = df[tcol].to_numpy(dtype=float)
    t_sec = detect_time_unit_and_to_seconds(t_raw)

    order = np.argsort(t_sec)
    t_sec_sorted = t_sec[order]
    df_sorted = df.iloc[order].reset_index(drop=False).rename(columns={"index": "orig_row_index"})
    ensure_monotonic_increasing(t_sec_sorted, "MedPC event times")
    return df_sorted, t_sec_sorted, self_admin_value


# ============================================================
# Monotonic DP matching
# ============================================================
def dp_match_monotonic(
    t_medpc: np.ndarray,
    t_anchor_master: np.ndarray,
    initial_a: float,
    initial_b: float,
    max_abs_err: float,
    max_interval_rel_err: float
) -> List[Tuple[int, int]]:
    """
    Monotonic DP: choose increasing medpc indices to match anchors in order.
    Candidate set per anchor is chosen around an initial guess.
    """
    nA = len(t_anchor_master)
    nM = len(t_medpc)
    if nA == 0 or nM == 0:
        return []

    cand: List[np.ndarray] = []
    for i in range(nA):
        target_med = (t_anchor_master[i] - initial_b) / (initial_a + 1e-12)
        lo_t = target_med - max_abs_err
        hi_t = target_med + max_abs_err
        lo = int(np.searchsorted(t_medpc, lo_t, side="left"))
        hi = int(np.searchsorted(t_medpc, hi_t, side="right"))
        idxs = np.arange(max(0, lo), min(nM, hi), dtype=int)
        if len(idxs) == 0:
            j = int(np.clip(np.searchsorted(t_medpc, target_med), 0, nM - 1))
            idxs = np.arange(max(0, j - 50), min(nM, j + 51), dtype=int)
        cand.append(idxs)

    INF = 1e18
    dp = [np.full(len(cand[i]), INF, dtype=float) for i in range(nA)]
    prev = [np.full(len(cand[i]), -1, dtype=int) for i in range(nA)]

    err0: List[np.ndarray] = []
    for i in range(nA):
        idxs = cand[i]
        pred = initial_a * t_medpc[idxs] + initial_b
        e = np.abs(pred - t_anchor_master[i])
        err0.append(e)

    dp[0] = err0[0].copy()

    for i in range(1, nA):
        Ai = float(t_anchor_master[i])
        Aprev = float(t_anchor_master[i - 1])
        dA = Ai - Aprev

        prev_candidates = cand[i - 1]
        for kk, m_idx in enumerate(cand[i]):
            cutoff = int(np.searchsorted(prev_candidates, m_idx, side="left"))
            if cutoff <= 0:
                continue
            start = max(0, cutoff - 200)

            best = INF
            bestp = -1
            for pp in range(start, cutoff):
                m_prev = int(prev_candidates[pp])
                dM = float(t_medpc[m_idx] - t_medpc[m_prev])
                if dM <= 0:
                    continue

                pred_dA = float(initial_a * dM)
                rel = abs(pred_dA - dA) / (abs(dA) + 1e-9)
                interval_pen = 0.0
                if rel > max_interval_rel_err:
                    interval_pen = (rel - max_interval_rel_err) * 10.0

                score = float(dp[i - 1][pp] + err0[i][kk] + interval_pen)
                if score < best:
                    best = score
                    bestp = pp

            dp[i][kk] = best
            prev[i][kk] = bestp

    end_k = int(np.argmin(dp[-1]))
    if not np.isfinite(dp[-1][end_k]):
        # fallback greedy
        out = []
        last = -1
        for i in range(nA):
            idxs = cand[i]
            pred = initial_a * t_medpc[idxs] + initial_b
            e = np.abs(pred - t_anchor_master[i])
            order = np.argsort(e)
            chosen = None
            for j in order:
                if int(idxs[j]) > last and float(e[j]) <= max_abs_err:
                    chosen = int(idxs[j])
                    break
            if chosen is None:
                continue
            out.append((i, chosen))
            last = chosen
        return out

    pairs = []
    k = end_k
    for i in range(nA - 1, -1, -1):
        pairs.append((i, int(cand[i][k])))
        k = int(prev[i][k]) if i > 0 else -1
        if i > 0 and k < 0:
            break
    pairs.reverse()

    good = []
    for (i, j) in pairs:
        pred = initial_a * float(t_medpc[j]) + initial_b
        if abs(pred - float(t_anchor_master[i])) <= max_abs_err:
            good.append((i, j))
    return good

def fit_medpc_to_master_affine(
    t_medpc: np.ndarray,
    t_anchor_master: np.ndarray,
    pairs: List[Tuple[int, int]]
) -> Tuple[float, float]:
    if len(pairs) < 2:
        raise ValueError("Not enough matches to fit affine mapping.")
    x = np.array([t_medpc[j] for _, j in pairs], dtype=float)
    y = np.array([t_anchor_master[i] for i, _ in pairs], dtype=float)
    return linear_fit_affine(x, y)


