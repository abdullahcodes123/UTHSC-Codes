# ============================================================
# 3) HELPER FUNCTIONS
# ============================================================

safe_numeric <- function(x) {
    x <- as.character(x)
    x <- trimws(x)
    x <- gsub(",", ".", x)
    suppressWarnings(as.numeric(x))
}

safe_day_number <- function(x) {
    x <- as.character(x)
    x <- trimws(x)
    x <- gsub(",", ".", x)

    out <- suppressWarnings(as.numeric(x))

    missing_out <- is.na(out)

    if (any(missing_out)) {
        out[missing_out] <- suppressWarnings(
            as.numeric(gsub("[^0-9.]", "", x[missing_out]))
        )
    }

    return(out)
}

clean_anova_table <- function(x) {
    if (is.null(x)) {
        return(NULL)
    }

    x <- as.data.frame(x)
    attr(x, "args") <- NULL
    attr(x, "heading") <- NULL
    attr(x, "class") <- NULL
    class(x) <- "data.frame"

    return(x)
}

get_complete_subjects <- function(data, subject_col, expected_n) {
    data %>%
        count({{ subject_col }}) %>%
        filter(n == expected_n) %>%
        pull({{ subject_col }})
}

print_if_available <- function(result_object, result_name) {
    cat("\n", result_name, ":\n", sep = "")

    if (is.null(result_object)) {
        cat("Not available.\n")
    } else {
        print(result_object)
    }
}

empty_star_df <- function() {
    data.frame(
        x = numeric(0),
        y = numeric(0),
        label = character(0)
    )
}

