# MV BEST AFFINE (DP + normalized per-window score)
# =============================================================================
def best_affine_medpc_to_video_multi(windows, tol: float):
    """
    Find best affine parameters (a_mv, b_mv) mapping MedPC time -> Video time.

    windows: list of dicts:
      {
        "name": str,
        "manual": np.ndarray (video-time manual anchors),
        "mp": np.ndarray (medpc times in seconds)
      }

    For each (a,b):
      - map MedPC times -> video cand times
      - compute DP monotonic match with manual anchors per window
      - score each window:
          score_w = (mae/5) + (misses / n_manual)
        then sum across windows (equal weight).

    Returns dict with best a,b and per-window stats.
    """
    usable = [w for w in windows if (len(w["manual"]) > 0 and len(w["mp"]) > 0)]
    if len(usable) == 0:
        raise RuntimeError("No usable MV windows (manual or MedPC windows empty).")

    a0 = 1.0
    a_list = np.arange(a0 - A_MV_PAD, a0 + A_MV_PAD + 1e-12, A_MV_STEP)
    b_list = np.arange(B_MV_MIN, B_MV_MAX + 1e-12, B_MV_STEP)

    best = None
    total_comb = int(len(a_list) * len(b_list))
    p = None
    if tqdm is not None:
        p = tqdm(total=total_comb, desc="[ALIGN MV] Grid search (a,b)", unit="comb", leave=True, mininterval=0.2)

    for a in a_list:
        for b in b_list:
            total = 0.0
            per = []
            for w in usable:
                mapped = a * w["mp"] + b
                mae, miss, _ = dp_monotonic_match(
                    manual=w["manual"],
                    cand=mapped,
                    tol=tol,
                    miss_pen=MV_MISS_PEN,
                )

                nman = max(1, len(w["manual"]))
                if mae is None:
                    mae_use = 10.0
                    miss_use = nman
                else:
                    mae_use = float(mae)
                    miss_use = int(miss)

                score_w = (mae_use / 5.0) + 1.0 * (miss_use / nman)
                total += score_w
                per.append((w["name"], mae_use, miss_use))

            if best is None or total < best["score"]:
                best = {"a": float(a), "b": float(b), "score": float(total), "per": per}

            if tqdm is not None:
                p.update(1)

    if tqdm is not None:
        p.close()

    if best is None:
        raise RuntimeError("Failed MV estimation.")
    return best


# =============================================================================
# GPU-VECTORIZED PERI-EVENT ROBUST Z + INCREASE PEAK
# =============================================================================
def peri_event_robustz_and_peak_gpu(
    t_fiber: np.ndarray,
    dff: np.ndarray,
    event_times: np.ndarray,
    epoch: np.ndarray,
    base_mask: np.ndarray,
    search_mask: np.ndarray,
    prefer_gpu: bool = True,
):
    """
    For each event time:
      - sample dff at event_time + epoch via interpolation
      - compute robust Z using baseline median and MAD
      - detect INCREASE peak as max robust Z in search_mask

    Returns:
      rz_trials: (n_events, n_epoch)
      peak_z: (n_events,)
      peak_off: (n_events,)  # offset in seconds relative to event
    """
    xp = xp_backend(prefer_gpu=prefer_gpu)
    t_x = xp.asarray(t_fiber, dtype=xp.float64)
    d_x = xp.asarray(dff, dtype=xp.float64)
    ev_x = xp.asarray(event_times, dtype=xp.float64)
    ep_x = xp.asarray(epoch, dtype=xp.float64)

    n_ev = int(ev_x.size)
    n_ep = int(ep_x.size)
    if n_ev == 0:
        return np.zeros((0, n_ep)), np.array([]), np.array([])

    q = (ev_x[:, None] + ep_x[None, :]).reshape(-1)
    yq = xp.interp(q, t_x, d_x).reshape(n_ev, n_ep)

    base = yq[:, base_mask]
    med = xp.median(base, axis=1)
    mad = xp.median(xp.abs(base - med[:, None]), axis=1)

    mad_safe = xp.where(mad <= 0, xp.nan, mad)
    rz = (yq - med[:, None]) / mad_safe[:, None]

    zz = rz[:, search_mask]
    zz2 = xp.nan_to_num(zz, nan=-xp.inf)
    kmax = xp.argmax(zz2, axis=1)
    peak_z = xp.take_along_axis(zz, kmax[:, None], axis=1).reshape(-1)

    search_t = xp.asarray(epoch[search_mask], dtype=xp.float64)
    peak_off = search_t[kmax]

    if xp is cp:
        return cp.asnumpy(rz), cp.asnumpy(peak_z), cp.asnumpy(peak_off)
    return np.asarray(rz), np.asarray(peak_z), np.asarray(peak_off)


def auc_trapz(y: np.ndarray, x: np.ndarray, t0: float, t1: float) -> float:
    """
    AUC via trapezoid integration on [t0, t1].
    """
    m = (x >= t0) & (x <= t1) & np.isfinite(y) & np.isfinite(x)
    if int(np.sum(m)) < 2:
        return float("nan")
    if hasattr(np, "trapezoid"):
        return float(np.trapezoid(y[m], x[m]))
    return float(((y[m][1:] + y[m][:-1]) * 0.5 * np.diff(x[m])).sum())


def choose_top_indices(scores: np.ndarray, mp_times: np.ndarray, refractory: float, max_keep: int = 400):
    """
    Choose indices by descending score, enforcing a refractory window in mp_times.
    """
    key = -np.nan_to_num(scores, nan=-1e9)
    order = np.argsort(key)
    chosen = []
    used = []
    for idx in order:
        t0 = float(mp_times[idx])
        if any(abs(t0 - u) < refractory for u in used):
            continue
        chosen.append(int(idx))
        used.append(t0)
        if len(chosen) >= max_keep:
            break
    return np.array(chosen, dtype=int)


# =============================================================================
# BOOTSTRAP: MV (DP + normalized scoring)
# =============================================================================
def bootstrap_mv(windows, best_a: float, best_b: float, tol: float, n_boot: int, seed: int):
    """
    MV bootstrap:
      - For each window, resample manual anchors with replacement (same length)
      - Re-run local grid search around best (a,b)
      - Save distribution of (a,b) and per-window MAE/miss
    """
    rng = np.random.default_rng(seed)
    usable = [w for w in windows if (len(w["manual"]) > 0 and len(w["mp"]) > 0)]
    if len(usable) == 0:
        return pd.DataFrame()

    a_list = np.arange(best_a - MV_BOOT_A_PAD, best_a + MV_BOOT_A_PAD + 1e-12, MV_BOOT_A_STEP)
    b_list = np.arange(best_b - MV_BOOT_B_PAD, best_b + MV_BOOT_B_PAD + 1e-12, MV_BOOT_B_STEP)

    rows = []
    boot_iter = _pbar(range(int(n_boot)), desc="[BOOTSTRAP MV] Resamples", unit="boot", leave=True)

    for _ in boot_iter:
        boot_wins = []
        for w in usable:
            m = w["manual"]
            idx = rng.integers(0, len(m), size=len(m))
            boot_manual = m[idx]
            boot_wins.append({"name": w["name"], "manual": boot_manual, "mp": w["mp"]})

        best = None
        total_comb = int(len(a_list) * len(b_list))
        p = None
        if tqdm is not None:
            p = tqdm(total=total_comb, desc="  [BOOTSTRAP MV] inner grid", unit="comb", leave=False, mininterval=0.4)

        for a in a_list:
            for b in b_list:
                total = 0.0
                total_miss = 0
                per = {}
                for w in boot_wins:
                    mapped = a * w["mp"] + b
                    mae, miss, _ = dp_monotonic_match(w["manual"], mapped, tol=tol, miss_pen=MV_MISS_PEN)

                    nman = max(1, len(w["manual"]))
                    if mae is None:
                        mae_use, miss_use = 10.0, nman
                    else:
                        mae_use, miss_use = float(mae), int(miss)

                    score_w = (mae_use / 5.0) + 1.0 * (miss_use / nman)
                    total += score_w
                    total_miss += int(miss_use)
                    per[w["name"]] = (float(mae_use), int(miss_use))

                if best is None or total < best["score"]:
                    best = {"a": float(a), "b": float(b), "score": float(total), "miss": int(total_miss), "per": per}

                if tqdm is not None:
                    p.update(1)

        if tqdm is not None:
            p.close()

        row = {"a": best["a"], "b": best["b"], "score": best["score"], "total_miss": best["miss"]}
        for k, (mae, miss) in best["per"].items():
            row[f"mae_{k}"] = mae
            row[f"miss_{k}"] = miss
        rows.append(row)

    return pd.DataFrame(rows)


# =============================================================================
# MF SCORING + BOOTSTRAP
# =============================================================================
def mf_score_for_b(
    a_mf: float,
    b_mf: float,
    mp_times: np.ndarray,
    t: np.ndarray,
    dff: np.ndarray,
    epoch: np.ndarray,
    base_mask: np.ndarray,
    search_mask: np.ndarray,
    a_mv: float,
    b_mv: float,
    dur_v: float,
    prefer_gpu: bool = True,
):
    """
    Score MF offset b_mf (MedPC -> Fiber) given fixed scale a_mf.

    Steps:
      1) Map MedPC events to fiber: ev = a_mf*mp + b_mf
      2) Keep events fully inside fiber peri-event window
      3) Compute per-event INCREASE peak robust Z and peak offset (fiber time)
      4) Predict corresponding video peak time:
            t_video_event = a_mv*mp + b_mv
            t_video_peak  = t_video_event + (a_mv/a_mf)*peak_offset
      5) Valid ratio = fraction of events where video clip window fits inside video duration
      6) Score = median_peak_z + alpha*valid_ratio - stabil*|b_mf|

    Returns:
      score, n_good_events, valid_ratio, median_peak
    """
    ev = a_mf * mp_times + b_mf
    ok = (ev - PRE >= float(t.min())) & (ev + POST <= float(t.max()))
    if int(np.sum(ok)) < MF_MIN_EVENTS:
        return -1e9, 0, 0.0, np.nan

    mp_ok_local = mp_times[ok]
    ev_ok = ev[ok]

    _, peak_z_local, peak_off_local = peri_event_robustz_and_peak_gpu(
        t_fiber=t,
        dff=dff,
        event_times=ev_ok,
        epoch=epoch,
        base_mask=base_mask,
        search_mask=search_mask,
        prefer_gpu=prefer_gpu,
    )

    good = np.isfinite(peak_z_local) & np.isfinite(peak_off_local)
    if int(np.sum(good)) < MF_MIN_EVENTS:
        return -1e9, int(np.sum(good)), 0.0, np.nan

    med_peak = float(np.nanmedian(peak_z_local[good]))

    t_video_event_local = a_mv * mp_ok_local + b_mv
    t_video_peak_local = t_video_event_local + (a_mv / a_mf) * peak_off_local

    valid = (t_video_peak_local - CLIP_PRE >= 0) & (t_video_peak_local + CLIP_POST <= dur_v) & good
    valid_ratio = float(np.mean(valid)) if valid.size else 0.0

    score = float(med_peak + MF_ALPHA_VALID * valid_ratio - MF_B_STABIL * abs(b_mf))
    return score, int(np.sum(good)), valid_ratio, med_peak


def bootstrap_mf(
    mp_focus: np.ndarray,
    t: np.ndarray,
    dff: np.ndarray,
    epoch: np.ndarray,
    base_mask: np.ndarray,
    search_mask: np.ndarray,
    a_mv: float,
    b_mv: float,
    dur_v: float,
    a_mf: float,
    b_mf_best: float,
    n_boot: int,
    seed: int,
):
    """
    MF bootstrap:
      - resample mp_focus events with replacement
      - search b around best b_mf
      - record best b and score each bootstrap
    """
    rng = np.random.default_rng(seed)
    if mp_focus.size < MF_MIN_EVENTS:
        return pd.DataFrame()

    b_list = np.arange(b_mf_best - MF_BOOT_B_PAD, b_mf_best + MF_BOOT_B_PAD + 1e-12, MF_BOOT_B_STEP)

    rows = []
    boot_iter = _pbar(range(int(n_boot)), desc="[BOOTSTRAP MF] Resamples", unit="boot", leave=True)
    for _ in boot_iter:
        idx = rng.integers(0, mp_focus.size, size=mp_focus.size)
        mp_bs = mp_focus[idx]

        best = None
        for b in b_list:
            sc, nused, vratio, medpk = mf_score_for_b(
                a_mf=a_mf,
                b_mf=float(b),
                mp_times=mp_bs,
                t=t,
                dff=dff,
                epoch=epoch,
                base_mask=base_mask,
                search_mask=search_mask,
                a_mv=a_mv,
                b_mv=b_mv,
                dur_v=dur_v,
                prefer_gpu=True,
            )
            if best is None or sc > best["score"]:
                best = {"b": float(b), "score": float(sc), "nused": int(nused), "valid_ratio": float(vratio), "med_peak": float(medpk)}

        rows.append(best)

    return pd.DataFrame(rows)


def qstats(x: np.ndarray):
    """
    Robust summary: median, q16, q84, std (finite only)
    """
    x = np.asarray(x, dtype=float)
    x = x[np.isfinite(x)]
    if x.size == 0:
        return (np.nan, np.nan, np.nan, np.nan)
    return (float(np.median(x)), float(np.quantile(x, 0.16)), float(np.quantile(x, 0.84)), float(np.std(x)))


