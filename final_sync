def parse_mmss_to_seconds(s: str) -> float:
    """
    "mm.ss" -> seconds as float (mm*60 + ss)
    """
    s = s.strip()
    if "." in s:
        mm, ss = s.split(".", 1)
        return int(mm) * 60 + int(ss)
    return float(s)


