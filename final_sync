def _run_ffprobe_frame_pts(video_path: Path) -> Optional[np.ndarray]:
    """
    Preferred: extract per-frame best-effort timestamps using ffprobe.
    Returns:
      pts_seconds: np.ndarray length = number of frames
    """
    cmd = [
        "ffprobe", "-v", "error",
        "-select_streams", "v:0",
        "-show_entries", "frame=best_effort_timestamp_time",
        "-of", "json",
        str(video_path),
    ]
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)
        j = json.loads(out)
        frames = j.get("frames", [])
        pts = []
        for fr in frames:
            v = fr.get("best_effort_timestamp_time", None)
            if v is None:
                continue
            try:
                pts.append(float(v))
            except Exception:
                continue
        if len(pts) < 10:
            return None
        pts = np.asarray(pts, dtype=float)
        pts = np.maximum.accumulate(pts)     # enforce monotonic nondecreasing
        pts = pts - float(np.min(pts))       # shift to 0
        return pts
    except Exception:
        return None


def _scan_cv2_pos_msec(video_path: Path, max_frames: Optional[int] = None) -> Tuple[np.ndarray, int, int, float]:
    """
    Fallback: scan video with OpenCV and read CAP_PROP_POS_MSEC per frame.

    Returns:
      t_sec_per_frame, W, H, fps_meta
    """
    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        raise RuntimeError("Could not open video file (codec).")

    W = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    H = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    fps_meta = float(cap.get(cv2.CAP_PROP_FPS)) if np.isfinite(cap.get(cv2.CAP_PROP_FPS)) else float("nan")

    frame_count = cap.get(cv2.CAP_PROP_FRAME_COUNT)
    total_est = None
    if np.isfinite(frame_count) and frame_count > 0:
        total_est = int(frame_count)
        if max_frames is not None:
            total_est = min(total_est, int(max_frames))

    t_ms = []
    n = 0
    it = _pbar(total=total_est, desc="[VIDEO] OpenCV timestamp scan", unit="fr", leave=True)

    while True:
        ret, _ = cap.read()
        if not ret:
            break
        ms = cap.get(cv2.CAP_PROP_POS_MSEC)
        if not np.isfinite(ms):
            ms = np.nan
        t_ms.append(ms)
        n += 1
        if tqdm is not None:
            it.update(1)
        if max_frames is not None and n >= int(max_frames):
            break

    if tqdm is not None:
        it.close()
    cap.release()

    t_ms = np.asarray(t_ms, dtype=float)
    good = np.isfinite(t_ms)
    if good.sum() < 10:
        raise RuntimeError("OpenCV timestamp scan failed (too few finite CAP_PROP_POS_MSEC values).")

    # Fill non-finite timestamps by interpolation
    idx = np.arange(len(t_ms))
    t_ms2 = t_ms.copy()
    if not np.all(good):
        t_ms2[~good] = np.interp(idx[~good], idx[good], t_ms2[good])

    t_ms2 = np.maximum.accumulate(t_ms2)  # enforce monotonic
    t_sec = (t_ms2 - float(np.min(t_ms2))) / 1000.0
    return t_sec, W, H, fps_meta


def build_video_timeline(video_path: Path) -> dict:
    """
    Build robust mapping between time (s) and frame index using a PTS timeline.

    Returns dict with:
      - t_frame_s: np.ndarray per frame timestamps in seconds
      - W, H: frame size
      - fps_nominal: robust median-based fps (ONLY for encoding output clips)
      - dur_s: last PTS time
      - vfr_report: diagnostics
    """
    if tqdm is not None:
        print("[VIDEO] Building VFR-safe timeline (ffprobe preferred)...")

    pts = _run_ffprobe_frame_pts(video_path)
    if pts is not None:
        cap = cv2.VideoCapture(str(video_path))
        if not cap.isOpened():
            raise RuntimeError("Could not open video file (codec).")
        W = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        H = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        fps_meta = float(cap.get(cv2.CAP_PROP_FPS)) if np.isfinite(cap.get(cv2.CAP_PROP_FPS)) else float("nan")
        cap.release()
        t_frame = pts
        src = "ffprobe"
    else:
        if tqdm is not None:
            print("[VIDEO] ffprobe PTS failed/insufficient -> fallback OpenCV scan (can be slow)...")
        t_frame, W, H, fps_meta = _scan_cv2_pos_msec(video_path)
        src = "opencv_pos_msec"

    # Nominal fps for WRITING output: median of positive dt
    d = np.diff(t_frame)
    d = d[np.isfinite(d) & (d > 0)]
    if len(d) < 5:
        fps_nom = float(fps_meta) if np.isfinite(fps_meta) and fps_meta > 1 else 30.0
    else:
        fps_nom = float(1.0 / np.median(d))

    dur_s = float(t_frame[-1]) if len(t_frame) else float("nan")

    # VFR diagnostics
    d_all = np.diff(t_frame)
    d_pos = d_all[np.isfinite(d_all) & (d_all > 0)]
    if len(d_pos) >= 5:
        q = np.quantile(d_pos, [0.01, 0.5, 0.99])
        vfr_ratio = float(q[2] / q[0]) if q[0] > 0 else float("inf")
        vfr_report = {
            "source": src,
            "n_frames": int(len(t_frame)),
            "dur_s_by_pts": float(dur_s),
            "fps_nominal_median": float(fps_nom),
            "dt_q01_s": float(q[0]),
            "dt_q50_s": float(q[1]),
            "dt_q99_s": float(q[2]),
            "vfr_ratio_q99_over_q01": float(vfr_ratio),
            "plateau_frames": int(np.sum(d_all <= 1e-6)),
        }
    else:
        vfr_report = {
            "source": src,
            "n_frames": int(len(t_frame)),
            "dur_s_by_pts": float(dur_s),
            "fps_nominal_median": float(fps_nom),
            "note": "insufficient dt samples",
        }

    return {
        "t_frame_s": t_frame,
        "W": W,
        "H": H,
        "fps_nominal": fps_nom,
        "dur_s": dur_s,
        "vfr_report": vfr_report,
    }


def time_to_frame_idx(t_frame_s: np.ndarray, t_s: float) -> int:
    """
    Convert requested time (seconds) to nearest frame index using binary search.
    This is the core VFR-safe time->frame mapping.
    """
    if not np.isfinite(t_s):
        return 0
    t_s = float(t_s)
    if t_s <= float(t_frame_s[0]):
        return 0
    if t_s >= float(t_frame_s[-1]):
        return int(len(t_frame_s) - 1)

    j = int(np.searchsorted(t_frame_s, t_s, side="left"))
    if j <= 0:
        return 0
    if j >= len(t_frame_s):
        return int(len(t_frame_s) - 1)

    if abs(float(t_frame_s[j]) - t_s) < abs(float(t_frame_s[j - 1]) - t_s):
        return j
    return j - 1


# =============================================================================
# DP MONOTONIC MATCH (GLOBAL OPTIMAL)
# =============================================================================
def dp_monotonic_match(manual: np.ndarray, cand: np.ndarray, tol: float, miss_pen: float = 2.0):
    """
    Global-optimal monotonic matching between:
      manual times (anchors) and cand times (candidate event times).

    Rules:
      - cand is dense; skipping cand is FREE.
      - skipping a manual anchor costs miss_pen.
      - match allowed only if |manual - cand| <= tol.
      - objective: minimize total cost = sum(|err|) + miss_pen*(#misses)
        tie-break: prefer more matches

    Returns:
      mae (float|None), misses (int), pairs list of (i_manual, j_cand, abs_err)
    """
    m = np.sort(np.asarray(manual, float))
    c = np.sort(np.asarray(cand, float))
    M, N = m.size, c.size

    if M == 0:
        return (0.0, 0, [])
    if N == 0:
        return (None, int(M), [])

    INF = 1e18
    dp_cost = np.full((M + 1, N + 1), INF, dtype=float)
    dp_err = np.full((M + 1, N + 1), 0.0, dtype=float)
    dp_mat = np.full((M + 1, N + 1), 0, dtype=int)
    dp_miss = np.full((M + 1, N + 1), 0, dtype=int)
    bt = np.full((M + 1, N + 1), -1, dtype=int)  # 0 skip cand, 1 miss manual, 2 match

    dp_cost[0, :] = 0.0
    bt[0, :] = 0

    for i in range(1, M + 1):
        dp_cost[i, 0] = dp_cost[i - 1, 0] + miss_pen
        dp_err[i, 0] = dp_err[i - 1, 0]
        dp_mat[i, 0] = dp_mat[i - 1, 0]
        dp_miss[i, 0] = dp_miss[i - 1, 0] + 1
        bt[i, 0] = 1

        for j in range(1, N + 1):
            best = (INF, 0.0, 0, 0, -1)

            # A) skip cand (free)
            costA = dp_cost[i, j - 1]
            if costA < best[0]:
                best = (costA, dp_err[i, j - 1], dp_mat[i, j - 1], dp_miss[i, j - 1], 0)

            # B) miss manual (penalty)
            costB = dp_cost[i - 1, j] + miss_pen
            if costB < best[0]:
                best = (costB, dp_err[i - 1, j], dp_mat[i - 1, j], dp_miss[i - 1, j] + 1, 1)

            # C) match within tolerance
            e = abs(float(m[i - 1]) - float(c[j - 1]))
            if e <= float(tol):
                costC = dp_cost[i - 1, j - 1] + e
                if (costC < best[0] - 1e-12) or (
                    abs(costC - best[0]) <= 1e-12 and (dp_mat[i - 1, j - 1] + 1) > best[2]
                ):
                    best = (
                        costC,
                        dp_err[i - 1, j - 1] + e,
                        dp_mat[i - 1, j - 1] + 1,
                        dp_miss[i - 1, j - 1],
                        2,
                    )

            dp_cost[i, j], dp_err[i, j], dp_mat[i, j], dp_miss[i, j], bt[i, j] = best

    matches = int(dp_mat[M, N])
    misses = int(dp_miss[M, N])

    pairs = []
    i, j = M, N
    while i > 0 or j > 0:
        step = bt[i, j]
        if step == 0:
            j -= 1
        elif step == 1:
            i -= 1
        elif step == 2:
            pairs.append((i - 1, j - 1, abs(float(m[i - 1]) - float(c[j - 1]))))
            i -= 1
            j -= 1
        else:
            break
    pairs.reverse()

    if matches == 0:
        return (None, misses, pairs)

    mae = float(dp_err[M, N] / matches)
    return (mae, misses, pairs)


